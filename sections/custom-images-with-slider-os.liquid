<style>
  .custom-images-with-slider-section-os .slick-next, .custom-images-with-slider-section-os .slick-prev {
    top: 50%;
    background-color: #fff;
    border-radius: 50%;
    width: 30px;
    height: 30px;    
}
.custom-images-with-slider-section-os .slick-next:before {
    content: '';
    background-image: url("https://cdn.shopify.com/s/files/1/0588/5834/0425/files/arrow-right.svg?v=1729166707");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    width: 12px;
    height: 12px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 1;
}
.custom-images-with-slider-section-os .slick-prev:before {
    content: '';
    background-image: url("https://cdn.shopify.com/s/files/1/0588/5834/0425/files/arrow-left.svg?v=1729166707");
    background-size: contain;
    background-repeat: no-repeat;
    width: 12px;
    height: 12px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 1;
}
.custom-images-with-slider-section-os .slick-dots {
    bottom: -35px;
}
.custom-images-with-slider-section-os .slick-next:focus, .custom-images-with-slider-section-os .slick-next:hover, 
.custom-images-with-slider-section-os .slick-prev:focus, .custom-images-with-slider-section-os .slick-prev:hover {
    /* color: transparent;
    outline: 0; */
    background: #fff;
}
.custom-images-with-slider-col-os img {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: flex;
}
.custom-images-with-slider-content-os h2 {
    text-align: center;
    padding-bottom: 2rem;
}
.custom-images-with-slider-col-os {
    padding: 0 8px;
    cursor: default !important;
}

@media screen and (max-width: 576px) {
  .custom-images-with-slider-content-os h2 {
    /* padding-bottom: 1.5rem; */
  }
  .custom-images-with-slider-col-os {
    padding: 0 4px;
  }
  .custom-images-with-slider-section-os {
    padding-bottom: 2rem;
  }
}
</style>


<section class="custom-images-with-slider-section-os">
    <div class="container-os" data-section-id="{{ section.id }}">
        <div class="custom-images-with-slider-content-os">
            <h2 data-item="section-heading">{{ section.settings.heading | escape }}</h2>
            <div class="custom-images-with-slider-row-os">
                {%- for block in section.blocks -%}
                    <div class="custom-images-with-slider-col-os" {{ block.shopify_attributes }}>
                        <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image | img_url: 'master' }}" loading="lazy">
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>


{% schema %}
  {
    "name": "Custom images with slider",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Custom images with slider"
      },
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Column",
        "settings": [
          {
            "id": "show-image",
            "label": "Show image",
            "type": "checkbox",
            "default": true
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom images with slider"
      }
    ],
  }
{% endschema %}




<script>
  $(".custom-images-with-slider-row-os").slick({
      slidesToShow: 4,
      slidesToScroll: 4,
      dots: false,
      arrows: true,
      infinite: true,
      speed: 300,
      responsive: [
        {
          breakpoint: 1028,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 3,
          }
        },
        {
          breakpoint: 767,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 2,
            dots: true,
            arrows: false,
          }
        }
      ]
  });
</script>