{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign heading = section.settings.heading | escape
  assign heading_type = section.settings.heading-type
  assign light_text = section.settings.light-text
  assign link_text = section.settings.link-text
  assign link_url = section.settings.link-url
  assign overline = section.settings.overline | escape
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign description = section.settings.description
  assign top_border = section.settings.top-border

  assign cover_link = false
  if link_url != blank and description == blank
    assign cover_link = true
  endif

  render 'section-assets', name: 'featured-text', type: 'style'
-%}

{%- if cover_link -%}
  <a href="{{ link_url }}" aria-label="{{ heading }}">
{%- endif -%}

<div
  class="featured-text--root {{ section.settings.selector }}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-container-width="{{ container_width }}"
  data-light-text="{{ light_text }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-top-border="{{ top_border }}"
>
  <div
    class="featured-text--wrapper"
    {% unless settings.transitions--text %}
      data-transition-container="{{ section.id }}"
      data-transition-type="mask"
      data-transition-cascade="vertical"
      data-transition-cascade-interval="500"
    {% endunless %}
  >
    {%- unless heading == blank -%}
      <div
        class="featured-text--heading"
        {% unless settings.transitions--text %}
          data-transition-cropper
          data-transition-item="{{ section.id }}"
        {% endunless %}
      >
        <h2 data-item="{{ heading_type }}">
          {%- render "utils", utility: "emphasized-text", text: heading -%}
        </h2>
      </div>
    {%- endunless -%}

    {%- unless overline == blank -%}
      <div
        class="featured-text--overline"
        {% unless settings.transitions--text %}
          data-transition-cropper
          data-transition-item="{{ section.id }}"
        {% endunless %}
      >
        <h3 data-item="overline">
          {{- overline | escape -}}
        </h3>
      </div>
    {%- endunless -%}

    {%- unless description == blank -%}
      <div
        class="featured-text--body"
        {% unless settings.transitions--text %}
          data-transition-type="slide-in"
          data-transition-item="{{ section.id }}"
        {% endunless %}
        data-item="rte-content"
      >
        {{- description -}}
      </div>
    {%- endunless -%}

    {%- unless link_text == blank -%}
      {%- if cover_link -%}
        <div
          class="featured-text--link"
          data-item="{{ settings.buttons--style }}"
          data-text="{{- link_text -}}"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
            data-transition-type="fade-in"
          {% endunless %}
          {% unless settings.transitions--buttons %}
            data-transition-button
          {% endunless %}
        >
          <span>{{- link_text -}}</span>
        </div>
      {%- else -%}
        <a
          class="featured-text--link"
          href="{{ link_url }}"
          data-item="{{ settings.buttons--style }}"
          data-text="{{- link_text -}}"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
            data-transition-type="fade-in"
          {% endunless %}
          {% unless settings.transitions--buttons %}
            data-transition-button
          {% endunless %}
        >
          <span>{{- link_text -}}</span>
        </a>
      {%- endif -%}
    {%- endunless -%}
  </div>
</div>

{%- if cover_link -%}
  </a>
{%- endif -%}

{% schema %}
  {
    "name": "Rich text",
    "settings": [
      {
        "type": "text",
        "id":"selector",
        "label":"Section Selector"
      },
      {
        "type": "header",
        "content": "Style and layout"
      },
      {
        "id": "top-border",
        "label": "Top border",
        "type": "checkbox",
        "default": false
      },
      {
        "id": "spacing-above",
        "label": "Spacing above",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "spacing-below",
        "label": "Spacing below",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "background-color",
        "label": "Background color",
        "type": "select",
        "options": [
          {
            "label": "Transparent",
            "value": "none"
          },
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          },
          {
            "label": "Accent 1",
            "value": "accent-1"
          },
          {
            "label": "Accent 2",
            "value": "accent-2"
          }
        ],
        "default": "none"
      },
      {
        "id": "light-text",
        "label": "Use light text color",
        "type": "checkbox",
        "default": false
      },
      {
        "id": "heading-type",
        "label": "Heading type",
        "type": "select",
        "options": [
          { "label": "Banner", "value": "banner-heading" },
          { "label": "Featured", "value": "featured-heading" },
          { "label": "Large", "value": "section-heading" },
          { "label": "Medium", "value": "block-heading" }
        ],
        "default": "section-heading"
      },
      {
        "id": "container-width",
        "label": "Maximum width of container",
        "type": "select",
        "options": [
          {
            "label": "Extra small",
            "value": "1"
          },
          {
            "label": "Small",
            "value": "2"
          },
          {
            "label": "Medium",
            "value": "3"
          },
          {
            "label": "Large",
            "value": "4"
          },
          {
            "label": "Extra large",
            "value": "5"
          },
          {
            "label": "Full width",
            "value": "6"
          }
        ],
        "default": "4"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "id": "overline",
        "label": "Overline",
        "type": "text",
        "default": "Overline text"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Introduce your brand",
        "info": "Emphasize featured or banner headings by wrapping text with square brackets, ie. This is [emphasized]."
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Introduce your brand, products and vision statement and welcome customers to your store.</p>"
      },
      {
        "id": "link-url",
        "label": "Link",
        "type": "url",
        "default": "/",
        "info": "Entire section will become a link when no link text or description."
      },
      {
        "id": "link-text",
        "label": "Link text",
        "type": "text",
        "default": "Link text"
      }
    ],
    "presets": [
      {
        "name": "Rich text"
      }
    ],
    "disabled_on": {
      "groups": ["aside"]
    }
  }
{% endschema %}
