{% comment %}
  Memorize Legacy Fabrics — floral background, split content and founder quote.
{% endcomment %}

<section
  id="memorize-legacy-{{ section.id }}"
  class="memorize-legacy"
  style="
    --ml-background: {{ section.settings.background_color }};
    --ml-card-background: {{ section.settings.card_background }};
    --ml-text: {{ section.settings.text_color }};
    --ml-border: {{ section.settings.divider_color }};
    --ml-width: {{ section.settings.content_width }}px;
    --ml-padding-top: {{ section.settings.padding_top }}px;
    --ml-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ml-margin-top: {{ section.settings.margin_top }}px;
    --ml-margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>
  {% if section.settings.pattern_image != blank %}
    <div
      class="memorize-legacy__pattern"
      style="background-image: url('{{ section.settings.pattern_image | image_url: width: 1800 }}'); background-size: {{ section.settings.pattern_size }}px auto;"
      aria-hidden="true"
    ></div>
  {% endif %}

  <div class="memorize-legacy__container">
    <div class="memorize-legacy__card">
      <div class="memorize-legacy__left">
        {% if section.settings.heading != blank %}
          <h2 class="memorize-legacy__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="memorize-legacy__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="memorize-legacy__right">
        {% if section.settings.quote != blank %}
          <div class="memorize-legacy__quote rte">
            {{ section.settings.quote }}
          </div>
        {% endif %}

        {% if section.settings.attribution != blank %}
          <p class="memorize-legacy__attribution">{{ section.settings.attribution | escape }}</p>
        {% endif %}

        {% if section.settings.email != blank %}
          <a
            class="memorize-legacy__email"
            href="mailto:{{ section.settings.email | strip | escape }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
            {{ section.settings.button_text | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #memorize-legacy-{{ section.id }} {
    position: relative;
    width: 100%;
    margin-top: var(--ml-margin-top);
    margin-bottom: var(--ml-margin-bottom);
    padding: var(--ml-padding-top) 24px var(--ml-padding-bottom);
    background: var(--ml-background);
    color: var(--ml-text);
    isolation: isolate;
  }

  #memorize-legacy-{{ section.id }} *,
  #memorize-legacy-{{ section.id }} *::before,
  #memorize-legacy-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-position: center;
    background-repeat: repeat;
    opacity: {{ section.settings.pattern_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__container {
    max-width: min(var(--ml-width), var(--max-width--large, 100%));
    width: 100%;
    margin: 0 auto;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    padding: 30px 42px;
    border-radius: 12px;
    background: var(--ml-card-background);
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__left {
    min-width: 0;
    padding: 0 38px 0 0;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__heading {
    margin: 0 0 12px;
    color: var(--ml-text);
    font-size: clamp(25px, 2.4vw, 33px);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: 1.1;
    max-width: 400px;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__description {
    color: var(--ml-text);
    font-size: 14px;
    line-height: 1.75;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__description p,
  #memorize-legacy-{{ section.id }} .memorize-legacy__quote p {
    margin: 0 0 12px;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__description p:last-child,
  #memorize-legacy-{{ section.id }} .memorize-legacy__quote p:last-child {
    margin-bottom: 0;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__right {
    min-width: 0;
    padding: 10px 0 0 38px;
    border-left: 1px solid var(--ml-border);
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__quote {
    color: var(--ml-text);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.65;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__attribution {
    margin: 10px 0 14px;
    color: #607e8f;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 38px;
    padding: 9px 16px;
    border: 1px solid #91a5b0;
    border-radius: 6px;
    background: transparent;
    color: var(--ml-text);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .15em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color .2s ease;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__email svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__email:hover {
    background: rgba(7, 53, 74, .06);
    color: var(--ml-text);
  }

  #memorize-legacy-{{ section.id }} .memorize-legacy__email:focus-visible {
    outline: 2px solid var(--ml-text);
    outline-offset: 3px;
  }

  @media (max-width: 990px) {
    #memorize-legacy-{{ section.id }} .memorize-legacy__card {
      padding: 28px;
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__left {
      padding-right: 24px;
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__right {
      padding-left: 24px;
    }
  }

  @media (max-width: 749px) {
    #memorize-legacy-{{ section.id }} {
      margin-top: {{ section.settings.mobile_margin_top }}px;
      margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
      padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__card {
      grid-template-columns: 1fr;
      padding: 26px 22px;
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__left {
      padding: 0 0 22px;
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__right {
      padding: 22px 0 0;
      border-left: 0;
      border-top: 1px solid var(--ml-border);
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__heading {
      font-size: clamp(25px, 7vw, 32px);
    }

    #memorize-legacy-{{ section.id }} .memorize-legacy__description {
      font-size: 13px;
    }
  }

  @media (max-width: 359px) {
    #memorize-legacy-{{ section.id }} .memorize-legacy__card {
      padding: 22px 17px;
    }
  }
</style>

{% schema %}
{
  "name": "Memorize Legacy Fabrics",
  "tag": "section",
  "class": "shopify-section-memorize-legacy",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Legacy Doesn't Have One Look"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Left description",
      "default": "<p>Neither do our fabrics. Choose from more than 45 options ranging from modern classic to grand millennial, French country to coastal to Americana. Our collection is designed to reflect your style and each one is quilted for softness and structure, then tailored into your trunk.</p>"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Founder quote",
      "default": "<p>\"That's a lot to choose from. Tell me who the trunk is for, and I'll help you narrow it down. I love helping select the right embroidery thread color for a tone-on-tone look OR a pop of color.\"</p>"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Quote attribution",
      "default": "Gayle, Founder & Lifelong Memory Keeper"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Email button text",
      "default": "Email Gayle"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "info": "Enter Gayle's email address to display the button."
    },
    {
      "type": "header",
      "content": "Images and colors"
    },
    {
      "type": "image_picker",
      "id": "pattern_image",
      "label": "Floral background image"
    },
    {
      "type": "range",
      "id": "pattern_size",
      "label": "Background pattern size",
      "min": 150,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 370
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#edf3f1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "White box background",
      "default": "#fffbf8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#07354a"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Vertical divider color",
      "default": "#efdce4"
    },
    {
      "type": "header",
      "content": "Layout and spacing"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Desktop top margin",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Desktop bottom margin",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_margin_top",
      "label": "Mobile top margin",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_margin_bottom",
      "label": "Mobile bottom margin",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Memorize Legacy Fabrics"
    }
  ]
}
{% endschema %}
