<style>
  select.custom-font-names-os {
    -webkit-appearance: none;
    appearance: none;
    font-family: inherit; /* Applies the font to the select, though options may not reflect it */
}
  .radios--root[data-display-only=false] .radios--header {
    padding-bottom: 0;
  }
  .disable {
    background-color: green;
}
.main-product-variant-images-col-os[data-sold-out="true"] {
    pointer-events: none;
    position: relative;
}

.main-product-variant-images-col-os[data-sold-out="true"]::after {
    content: "/";
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(-66deg);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    color: #00334D;
    border-radius: 50%;
    font-size: 50px;
    border: 2px solid #00334D;
}

/* Keep embroidery text inside the preview without resizing image/popup. */
.custom-images-os .textarea-text-display-os,
.custom-images-os .monogram-text-display-os {
    box-sizing: border-box;
    max-width: calc(100% - 24px) !important;
    white-space: pre-wrap !important;
    overflow-wrap: anywhere;
    word-break: break-word;
    text-align: center;
    {% comment %} overflow: hidden; {% endcomment %}
}

.custom-images-os .monogram-large-text-os {
    font-family: inherit;
    max-width: 100%;
}

.mobile-product-description-os {
    display: none;
}

@media only screen and (max-width: 767px) {
    .mobile-product-description-os {
        display: block;
        margin-top: 10px;
    }

    .product-page--block[data-block-type="description"] {
        display: none;
    }
}

</style>

{% if section.settings.rounded %}
<style>
.product-media--thumb { 
    flex-shrink: 0;
}label.radios--value-button,
  button.product-buy-buttons--primary,
  button.btn.pplr-btn.button{
     /* border-radius: 50px !important; */
}.product-media--thumb { 
    /*border-radius: 10px !important;*/
    overflow: hidden;
}product-zoom-root.product-zoom--root,
  .product-media--root img,.product--image-wrapper img{
   /* border-radius: 20px;*/
}.product-media--root img{
 /* border-radius:10px*/
}.radios--value-button, .radios--value-button:hover { 
    height: 30px;
    min-height: 0;
    border-width: 1px;
    min-width: 90px;
}[data-item=secondary-button], [data-item=secondary-button]:focus-visible, [data-item=secondary-button]:hover, [data-item=secondary-button]:link, [data-item=secondary-button]:visited{
 color:inherit 
}.radios--input[data-item=radio]:checked:not([disabled])+label[data-item=swatch]:after, .radios--input[data-item=radio]:hover:not([disabled])+label[data-item=swatch]:after, [data-is-swatches=true] .filter--input:checked:not([disabled])+label[data-item=swatch]:after, [data-is-swatches=true] .filter--input:hover:not([disabled])+label[data-item=swatch]:after {
    box-shadow: 0px 4px 4px 0px #00000040;
}.radios--input[data-item=radio]:checked+.radios--value-button, .radios--input[data-item=radio]:hover+.radios--value-button, [data-is-swatches=true] .filter--input:checked+.radios--value-button, [data-is-swatches=true] .filter--input:hover+.radios--value-button {
    /* box-shadow: 0px 4px 4px 0px #00000040;
    background: white; */
}
label.radios--option-label.customText h3 {
    margin-bottom: 0;
    line-height: 1.3;
    letter-spacing: 0;
    font-weight: 500 !important;
    font-family: Gotham Book !important;
    font-size: var(--font--accent--size);
}label.radios--option-label.customText p {
    line-height: 1.3;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    margin: 5px 0 6px;
}.paymentTerms {
    margin-bottom: 20px;
    font-size: 0.8em;
    line-height: 1.3;
    margin-top: 10px;
}.radios--input[data-item=radio]:not([disabled])+label[data-item=swatch]:after, [data-is-swatches=true] .filter--input:not([disabled])+label[data-item=swatch]:after { 
    border: 1px solid #727272;
    top: -0.5px;
    left: -1px;
    width: 48px;
    height: 48px;
}product-buy-buttons-root.product-buy-buttons--root button.product-buy-buttons--primary.pplr_add_to_cart.pplr_hide {
    display: block !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
}product-buy-buttons-root.product-buy-buttons--root:has(button.product-buy-buttons--primary.pplr_add_to_cart.pplr_hide){
        padding-top: 4px !important;
}.radios--input[data-item=radio][data-empty=true]+label[data-item=swatch]:before, .radios--input[data-item=radio][data-unavailable=true]+label[data-item=swatch]:before, [data-is-swatches=true] .filter--input[data-empty=true]+label[data-item=swatch]:before, [data-is-swatches=true] .filter--input[data-unavailable=true]+label[data-item=swatch]:before {
    background-color: var(--color--body); 
}span.radios--option-current{
  color:var(--color--body)
}.radios--main:has(.radios--input[data-item=radio][data-unavailable=true]) {
    display: none;
}
  @media only screen and (max-width: 767px) {
    .radios--root[data-display-only=false] .radios--header { 
    }.justAWrapper {
    }.seeMoreLessWrapper {
        text-align: center;
    }.carousel--dot-container {
        display: none !important;
    }

  }
</style>
{% endif %}

{%- liquid
  assign breadcrumbs_enabled = section.settings.breadcrumbs-enabled
  assign column_spacing = section.settings.column-spacing
  assign container_width = section.settings.container-width
  assign featured_media = product.featured_media
  assign heading_sizes_enabled = section.settings.heading-sizes-enabled
  assign heading_size = section.settings.heading-size
  assign media_gap = section.settings.media-gap
  assign media_layout = section.settings.media-layout
  assign mobile_media_layout = section.settings.mobile-media-layout
  assign product_id = product.id | append: '-' | append: section.id
  assign quantity_added = false
  assign render_size_chart_modal = false
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign text_alignment = section.settings.text-alignment
  assign text_column_width = section.settings.text-column-width
  assign thumbnail_width = section.settings.thumbnail-width
  assign variant_scroll_enabled = section.settings.variant-scroll-enabled
  assign video_looping_enabled = section.settings.loop-enabled
  assign zoom_enabled = section.settings.image-zoom-enabled

  assign heading_enabled = section.settings.heading-enabled
  if media_layout == 'thumbnails'
    assign heading_enabled = false
  endif

  assign onboarding = true
  assign modal_enabled = false
  if product.media.size > 0
    assign onboarding = false
    assign modal_enabled = section.settings.modal-enabled
  endif

  capture css_vars
    echo '--text-column-width:' | append: text_column_width | append: '%;'
    echo '--media-gap:' | append: media_gap | append: 'px;'
    echo '--thumbnail-width:' | append: thumbnail_width | append: 'px;'
  endcapture

  render 'section-assets', name: 'product-page', type: 'style'
-%}
{% assign currency_symbol = product.price | money | slice: 0, 1 %}

<div
  class="main-product-os product-page--root {% if section.settings.rounded %}roundedProductPage{% endif %} 
  {% if product.metafields.custom.show_selected_variant_images == true %}
  showSelectedVariantImages{% endif %}"
  data-product-id="{{ product_id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product_page"
  data-container-width="{{ container_width }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
  data-text-alignment="{{ text_alignment }}"
  style="{{ css_vars }}"
>
  <!-- FIX 4: Removed stray "44" class from wrapper div -->
  <div class="product-page--wrapper">
    {%- if heading_enabled -%}
      <div class="product-page--header" data-mq="medium-large">
        <h1
          class="product-page--title"
          data-item="featured-heading"
          {%- if heading_sizes_enabled -%}
            style="--font--featured--size:{{ heading_size | plus: 24 }}px;"
          {%- endif -%}
        >
          {{- product.title -}}
        </h1>
      </div>
    {%- endif -%}



  {% if section.settings.rounded %}
    {% capture idMobile %}product_form_mobile_{{ product.id }}{% endcapture %}
  {%- form 'product', product, class: 'product-page--form--mobile', id:idMobile -%} 
  <div class="mobileContainer" style="display:none">
      <div
      {% unless settings.transitions--text %}
      data-transition-cropper
      data-transition-item="viewport"
      data-transition-type="mask"
      {% endunless %}
      >
      {%- if heading_enabled -%}
      <h2 class="product-page--heading" data-item="section-heading">
      {{- product.title -}}
      </h2>
      {%- else -%}
      <h1 class="product-page--heading" data-item="section-heading">
      {{- product.title -}}
      </h1>
      {%- endif -%}
      </div>
      <div class="klaviyo-star-rating-widget klaviyo-star-rating-widget-os" data-id="{{product.id}}" data-product-title="{{product.title}}" data-product-type="{{product.type}}"></div>
      {%- render 'product-price', product: product, id: product_id -%}
      <div class="mobile-content-os">
        <div class="mobile-size-options-os">
          <div class="heading-content-os">
            <h4>1. Choose Your Size</h4>
            <p>Not Sure? 
              <span class="underline-os" onclick="openSizeGuide()">Check Out Our Size Guide</span>
            </p>
          </div>
          
          <div class="mobile-size-buttons-row-os">
            {% assign displayed_sizes = "" %}
            {% for variant in product.variants %}
              {% if variant.available %}
                {% assign size_option = variant.options[0] %}
                
                {% unless displayed_sizes contains size_option %}
                      <button class="{{ size_option | downcase }}" type="button">{{ size_option }}</button>
                  {% assign displayed_sizes = displayed_sizes | append: size_option | append: "," %}
                {% endunless %}
              {% endif %}
            {% endfor %}
            
          </div>



        </div>
      </div>
    
  </div>
  {% endform %}
  {% endif %}
    
    <div class="product-page--desktop-container" data-mq="medium-large">
      {% render 'custom-pdp-slider', product: product %}

        
     <div class="pdp_description">
      {{ product.description }}
     </div>
    </div>

    <div class="product-page--mobile-container" data-mq="small">
      {%- if mobile_media_layout == 'thumbnails' -%}
        {%-
          render 'product-media--variants',
          product: product,
          product_id: product_id,
          media_size: "mobile",
          layout: 'thumbnails',
          thumbs_enabled: true,
          video_looping_enabled: video_looping_enabled,
          firstImage: section.settings.firstImage
        -%}

      {%- elsif mobile_media_layout == 'slideshow' -%}
            <!-- Custom images starts -->
            <div class="custom-images-os">
              <img class="main-trunk-image-os" src="https://memorizeyourlife.com/cdn/shop/files/White-Trunk.png?v=1733382579" alt="Trunk Image" />
              <img class="main-fabric-image-os" src="https://memorizeyourlife.com/cdn/shop/files/The_Eyes_Have_It.png?v=1731479188" alt="Fabric Image" />
              <h4 class="textarea-text-display-os"></h4>
              <h4 class="monogram-text-display-os"></h4>
            </div>
            <!-- Custom images ends -->
        {%- render 'section-assets', name: 'product-media--carousel', type: 'script' -%}

        <product-media-carousel
          class="product-page--carousel"
          data-id="{{ product_id }}"
          data-mq="small"
        >
          {%
            render 'carousel',
            view: "product-page",
            section_id: section.id,
            onboarding: onboarding,
            product: product,
            video_looping_enabled: video_looping_enabled,
            blocks: product.media,
            dot_nav_enabled: true,
            blocks_per_slide: 1,
            blocks_per_slide_mobile: 1,
            total_blocks: product.media.size,
            total_slides: product.media.size,
            spacing_around_blocks: true,
            transition_type: "slide",
            firstImage: section.settings.firstImage
          -%}
        </product-media-carousel>
      {%- endif -%}
    </div>

    {%- form 'product', product, class: 'product-page--form' -%}

      {%- if breadcrumbs_enabled -%}
        <div
          class="product-page--breadcrumbs"
          data-mq="medium-large"
          {% unless settings.transitions--text %}
            data-transition-item="{{ section.id }}"
          {% endunless %}
        >
          {%- render 'breadcrumbs' -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign fit_together = false
          if block.type == 'collapsible-row'
            assign fit_together = true
          elsif block.type == 'complementary-products' and block.settings.collapsible-row-enabled
            assign fit_together = true
          elsif block.type == 'description' and block.settings.collapsible-row-enabled
            assign fit_together = true
          endif
        -%}

        <div
          class="product-page--block"
          data-product-block
          data-block-type="{{ block.type }}"
          data-fit-together="{{ fit_together }}"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when 'overline' -%}
              <div class="product-page--overline" data-item="overline">
                {{- block.settings.text -}}
              </div>

            {%- when 'heading' -%}
              <div
                {% unless settings.transitions--text %}
                  data-transition-cropper
                  data-transition-item="viewport"
                  data-transition-type="mask"
                {% endunless %}
              >
                {%- if heading_enabled -%}
                  <h2 class="product-page--heading" data-item="section-heading">
                    {{- product.title -}}
                  </h2>
                {%- else -%}
                  <h1 class="product-page--heading" data-item="section-heading">
                    {{- product.title -}}
                  </h1>
                {%- endif -%}
              </div>

            {%- when 'vendor' -%}
              <div class="product-page--vendor" data-item="light-accent-text">
                <a href="{{ product.vendor | url_for_vendor }}">
                  {{- product.vendor -}}
                </a>
              </div>

            {%- when 'price' -%}
              {%- render 'product-price', product: product, id: product_id -%}
            
            {%- when 'paymentTerms' -%}
              <div class="paymentTerms">
              {{- form | payment_terms -}}
              </div>
            
            {%- when 'low-stock' -%}
              {%-
                render 'product-low-stock',
                id: product_id,
                current_variant: current_variant,
                threshold: block.settings.threshold
              -%}

            {%- when 'options' -%}

              <div class="desktop-content-os">
                <div class="heading-content-os">
                  <h4>1. Choose Your Size</h4>
                  <p>Not Sure? 
                    <span class="underline-os" onclick="openSizeGuide()">Check Out Our Size Guide</span>
                  </p>
                </div>
                  {%-
                    render "product-options",
                    id: product_id,
                    product: product,
                    block_settings: block.settings,
                    block:block
                  -%}
    
                  {%- liquid
                    if block.settings.size-chart-enabled
                      assign size_chart_option = block.settings.size-chart-option | strip | downcase
    
                      for option in product.options_with_values
                        assign option_name = option.name | strip | downcase
                        if option_name == size_chart_option
                          if block.settings.size-chart-content == blank
                            capture size_chart_path
                              assign size_chart_path_t = 'products.size_chart_path' | t
                              echo '<code>' | append: size_chart_path_t | append: '</code>'
                            endcapture
    
                            assign modal_content = 'products.empty_page_content_html' | t: size_chart_path: size_chart_path
                          else
                            assign modal_content = pages[block.settings.size-chart-content].content
                          endif
    
                          assign render_size_chart_modal = true
                          break
                        endif
                      endfor
                    endif
                  -%}
              </div>

            {%- when 'quantity-selector' -%}
              {%- liquid
                assign quantity_added = true
                render 'quantity-selector', id: product_id, type: 'product'
              -%}

            {%- when 'custom-personaliser' -%}
            {%- if block.settings.show_custom_personaliser -%}

              <section class="main-product-custom-variants-section-os">
                <div class="main-product-variants-os">
                    <div class="heading-content-os">
                        <h4>2. Choose your Exterior Color</h4>
                        <p>All trunks have gold hardware - <custom class="active-trunk-variant-name-os"></custom></p>
                    </div>
            
                    <div class="main-product-variant-images-row-os">
                        {%- for trunk in section.blocks -%}
                        {% if trunk.settings.trunk-label != blank %}
                        <div for="trunks-color{{ forloop.index }}" onclick="trunkImage('{{ trunk.settings.trunk-image | img_url: 'master' }}', this, '{{ trunk.settings.trunk-label }}')" class="main-product-variant-images-col-os variants-cstm-cls {{ trunk.settings.trunk-label }}" >
                          <div class="swatch-box-os">
                            <input type="radio" hidden class="properties-cstm" name="properties[Exterior Trunk Color]" data-name="properties-cstm-trunks-color" id="trunks-color{{ forloop.index }}" value="{{ trunk.settings.trunk-label }}">
                            <img class="main-product-fabric-images-os" src="{{ trunk.settings.trunk-image | img_url: 'master' }}" alt="{{ trunk.settings.trunk-label }}" />
                            <img class="main-product-fabric-swatch-images-os" src="{{ trunk.settings.trunk-swatch-image | img_url: 'master' }}" alt="{{ trunk.settings.trunk-label }}" />
                            <span>{{ trunk.settings.trunk-label }}</span>
                          </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
            
                </div>
            
            
                <div class="main-product-fabrics-os">
                    <div class="heading-content-os">
                        <h4>3. choose your Interior Fabric</h4>
                        <p>All of our fabrics are quilted for <custom class="active-fabric-variant-name-os-data">Plush & padded feel -</custom> <custom class="active-fabric-variant-name-os"></custom></p>
                    </div>
            
                    <div class="main-product-fabric-images-row-os">
                        {%- for fabrics in section.blocks -%}
                        {% if fabrics.settings.fabric-label != blank %}
                        <div for="fabrics-color{{ forloop.index }}" onclick="fabricImage('{{ fabrics.settings.fabric-image | img_url: 'master' }}', this)" class="main-product-variant-images-col-os variants-cstm-cls {{ fabrics.settings.fabric-label | downcase | handleize}}">
                          <div class="swatch-box-os">
                            <input type="radio" hidden class="properties-cstm" name="properties[Fabric]" data-name="properties-cstm-fabrics-color" id="fabrics-color{{ forloop.index }}" value="{{ fabrics.settings.fabric-label }}">
                            <img class="main-product-fabric-images-os" src="{{ fabrics.settings.fabric-image | img_url: 'master' }}" alt="{{ fabrics.settings.fabric-label }}" />
                            <img class="main-product-fabric-swatch-images-os" src="{{ fabrics.settings.fabric-swatch-image | img_url: 'master' }}" alt="{{ fabrics.settings.fabric-label }}" />
                            <span>{{ fabrics.settings.fabric-label }}</span>
                          </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>

                  <div class="more-fabric-options-btn-os">
                    <button type="button" >See more fabric options</button>
                  </div>
                </div>
            
                <div class="main-product-review-btn-os">
                    <button type="button" onclick="openPopup()">PERSONALIZE IT (STARTING AT $25)</button>
                </div>
            </section>

            {%- unless product.description == blank -%}
              <div class="pdp_description mobile-product-description-os">
                {{ product.description }}
              </div>
            {%- endunless -%}
              
            {% endif %}


            {%- when 'buy-buttons' -%}
              <div class="main-product-custom-addToCart-btn-os">
                  <button type="button">ADD TO CART</button>
              </div>

            <!-- Shopify Add to Cart button -->
              {%-
                render 'product-buy-buttons',
                id: product_id,
                product: product,
                form: form,
                smart_payment_enabled: block.settings.smart-payment-enabled
              -%}

            {%- when 'unavailable-form' -%}
              {%- render 'product-unavailable-form', product: product, id: product_id -%}

            {%- when 'pickup' -%}
              {%- render 'product-pickup', product: product, id: product_id -%}

            {%- when 'social-sharing' -%}
              {%-
                render 'social-icons',
                align: 'left',
                mobile_align: 'center',
                type: 'share',
                social_settings: block.settings
              -%}

            {%- when 'sku' -%}
              {%- render 'product-sku', product: product, id: product_id -%}

            {%- when 'collapsible-row' -%}
              {%- assign unique_id = section.id | append: '--collapsible-row--' | append: forloop.index -%}
              {%-
                render 'collapsible-row',
                description: block.settings.description,
                heading: block.settings.heading,
                default_open: block.settings.default-open,
                page_content: block.settings.page-content,
                unique_id: unique_id
              -%}

            {%- when 'description' -%}
              {%- unless product.description == blank -%}
                <div class="product-page--description" data-item="rte-content">
                  {%- liquid
                    if block.settings.collapsible-row-enabled
                      assign unique_id = section.id | append: '-' | append: block.id
                      render 'collapsible-row', heading: block.settings.heading, description: product.description, unique_id: unique_id
                    else
                      echo product.description
                    endif
                  -%}
                </div>
              {%- endunless -%}

            {%- when 'rating' -%}
              {%- render 'product-rating' -%}

            {%- when 'complementary-products' -%}
              {%-
                render 'complementary-products',
                heading: block.settings.title,
                max_products: block.settings.max-products,
                collapsible_row: block.settings.collapsible-row-enabled,
                product_id: product.id
              -%}

            {%- when 'liquid' -%}
              {{- block.settings.custom-liquid -}}

            {%- when '@app' -%}
              {%- render block -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}

      {%- unless quantity_added -%}
        <input type="hidden" name="quantity" value="1" min="1" pattern="[0-9]*" tabindex="-1">
      {%- endunless -%}

    {%- endform -%}

    {%- if render_size_chart_modal -%}
      <modal-root
        class="modal--root"
        data-id="size-chart"
        data-background-color="dark"
        data-translucent="true"
        data-transition-item="viewport"
        data-transition-type="fade-in"
        data-transition-trigger="custom"
        aria-hidden="true"
      >
        <div class="modal--view">
          <div class="product-size-chart--modal" data-item="rte-content">
            {{- modal_content -}}
          </div>
        </div>
      </modal-root>
    {%- endif -%}



{% for block in section.blocks %}
  {% if block.type == "options" %} 

    {% for i in (1..4) %}
    {% capture pop %}popup{{ i }}{% endcapture %}
    {% if block.settings[pop] != blank %}
    <modal-root
      class="modal--root"
      data-id="{{ pop }}"
      data-background-color="dark"
      data-translucent="true"
      data-transition-item="viewport"
      data-transition-type="fade-in"
      data-transition-trigger="custom"
      aria-hidden="true"
    >
      <div class="modal--view">
        <div class="product-size-chart--modal" data-item="rte-content">
          {{- block.settings[pop].content -}}
        </div>
      </div>
    </modal-root>
    {% endif %}
      
    {% endfor %}
    
  {% endif %}
{% endfor %}
     
    
  </div>

  
</div>


<!-- Popup for PERSONALIZE starts -->
{% render 'personalize-it-popup-os', product:product %}
<!-- Popup for PERSONALIZE ends -->


{% schema %}
{
  "name": "Product Personalization 3",
  "class": "section--product-page",
  "settings": [
   
    {
      "type": "checkbox",
      "id":"rounded",
      "label":"Rounded Corners",
      "default":false
    },
    {
      "type": "checkbox",
      "id":"firstImage",
      "label":"Featured Image (1st image)",
      "default":false
    },
    {
      "type": "header",
