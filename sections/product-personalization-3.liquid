  // Function to update the hidden input for the monogram value
  function updateMonogramSingleHiddenInput() {
      const monogramInputs = document.querySelectorAll('.mobile-monogram-os input[type="text"]');
      const monogramValuesArray = Array.from(monogramInputs).map(input => input.value);
      const monogramValues = Array.from(monogramInputs).map(input => input.value.trim()).join('');
      document.querySelector('.mobile-monogram-text-value-os').value = monogramValues;
  
      mobileupdateMonogramDisplay(monogramValues, monogramValuesArray);
      mobileUpdatePriceAccordingToPersonalizeLetters(monogramValues.length);
  }
  
  // Function to handle focus shifting in monogram inputs
  function handleMonogramInput(event) {
      const target = event.target;
      const maxLength = target.getAttribute('maxlength'); // Get max length of the input (which is 1)
  
      if (target.value.length >= maxLength) {
          // Move focus to the next input field if the current one is filled
          const nextInput = target.nextElementSibling;
          if (nextInput && nextInput.tagName === 'INPUT') {
              nextInput.focus();
          }
      }
  }
  
  // Function to handle backspace for focus shifting
  function handleMonogramBackspace(event) {
    
      const target = event.target;
  
      // If backspace is pressed and the input is empty, move focus to the previous input
      if (event.key === 'Backspace' && target.value === '') {
          const prevInput = target.previousElementSibling;
          if (prevInput && prevInput.tagName === 'INPUT') {
              prevInput.focus();
          }
      }
  }
  
  // Attach event listeners to the monogram input fields
  function initializeMonogramInputs() {
      const monogramInputs = document.querySelectorAll('.mobile-monogram-os input[type="text"]');
  
      monogramInputs.forEach(input => {
          input.addEventListener('input', () => {
              updateMonogramSingleHiddenInput();
              handleMonogramInput(event);
          });
          input.addEventListener('keydown', handleMonogramBackspace); // Handle backspace event
      });
  }

