          }
        
          if (mobileAddToCartButton) {
              mobileAddToCartButton.textContent = `Add To Cart (${currencySymbol}${updatedPrice.toFixed(2)})`;
          }
      } else {
          console.log("updatePriceInPopupCartToCartButton pdpProductVariantPrice else ::");
      }
  }
  
  // Set up MutationObserver to detect changes in the variant price element
  if (pdpProductVariantPrice) {
      const observer = new MutationObserver(() => {
          updatePriceInPopupCartToCartButton(); // Trigger price update when price changes
      });
  
      observer.observe(pdpProductVariantPrice, {
          childList: true,
          subtree: true
      });
  }
  
  // Call the function to initialize event listeners when the DOM is fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    updateContent();
    initializeMonogramInputs();
    updatePriceInPopupCartToCartButton();
  });
  
  // Custom Add to cart price ends



</script>
