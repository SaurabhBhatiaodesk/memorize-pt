  // Function to adjust font size and line height based on the length of text in the textarea
  function mobileAdjustFontSizeAndLineHeight(textarea) {
      const textLength = textarea.value.length;
      const textareaDisplays = document.querySelectorAll('.textarea-text-display-os'); // Get all display elements
      const letterCountDisplay = document.querySelector('.mobile-textarea-letter-count-os'); // Get the letter count display element

      // Mobile uses the same shared sizing table; both PDP and popup match.
      textareaDisplays.forEach((display) => {
          adjustFontSizeAndLineHeight0(null, display, textLength);
      });
      const sharedMaxCharacters = 40;
      if (letterCountDisplay) {
          letterCountDisplay.textContent = sharedMaxCharacters - textLength;
      }
      return;
  
      // Determine the font size and line height based on the text length
      let fontSize = '';
      let lineHeight = '';

      textareaDisplays.forEach(textareaDisplay => {
        if (textareaDisplay.classList.contains("flourish")) {
          if (textLength > 28) {
            fontSize = '12px';
            lineHeight = '32px';
          } else {
            fontSize = '14px';
            lineHeight = '35px';
          }
        } else if (textareaDisplay.classList.contains("signature") || textareaDisplay.classList.contains("fancy")) {
          if (textLength > 28) {
            fontSize = '26px';
            lineHeight = '26px';
          } else {
            fontSize = '28px';
            lineHeight = '28px';
          }
        } else if (textareaDisplay.classList.contains("amalfi")) {
          if (textLength > 28) {
            fontSize = '20px';
            lineHeight = '24px';
          } else {
            fontSize = '24px';
            lineHeight = '28px';
          }
        } else if (textareaDisplay.classList.contains("fondly-yours")) {
          if (textLength > 28) {
            fontSize = '20px';
            lineHeight = '24px';
          } else {
            fontSize = '24px';
            lineHeight = '28px';
          }
        } else if (textareaDisplay.classList.contains("casually-cool")) {
          if (textLength > 28) {
            fontSize = '20px';
            lineHeight = '24px';
          } else {
            fontSize = '24px';
            lineHeight = '24px';
          }
        } else if (textareaDisplay.classList.contains("memorize")) {
          if (textLength > 28) {
            fontSize = '20px';
            lineHeight = '24px';
          } else {
            fontSize = '24px';
            lineHeight = '28px';
          }
        } else if (textareaDisplay.classList.contains("headliner") || textareaDisplay.classList.contains("letter-jacket")) {
          if (textLength > 28) {
            fontSize = '15px';
            lineHeight = '20px';
          } else {
            fontSize = '20px';
            lineHeight = '24px';
          }
        } else if (textareaDisplay.classList.contains("vintage")) {
          if (textLength > 28) {
            fontSize = '15px';
            lineHeight = '20px';
          } else {
            fontSize = '20px';
            lineHeight = '24px';
          }
        } else {
          if (textLength > 28) {
            fontSize = '18px';
            lineHeight = '24px';
          } else {
            fontSize = '20px';
            lineHeight = '24px';
          }
        }
      });
  
      // Apply the styles to all textarea display elements
      textareaDisplays.forEach(display => {
          display.style.fontSize = fontSize;
          display.style.lineHeight = lineHeight;
      });
  
      // Update the letter count display
      const maxCharacters = 40; // Set the maximum character limit
      letterCountDisplay.textContent = maxCharacters - textLength; // Update the displayed character count
  }

  
