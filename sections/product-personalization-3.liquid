  function toLetterCase1(fontName) {
      return fontName
          .split('-') // Split the string by hyphens
          .map(word => word.charAt(0).toUpperCase() + word.slice(1)) // Capitalize each word
          .join(' '); // Join the words with a space
  }

  // Function to convert "Letter Cased" format back to toHyphenatedCase format
  function toHyphenatedCase1(fontName) {
      return fontName
          .split(' ') // Split the string by spaces
          .map(word => word.toLowerCase()) // Convert each word to lowercase
          .join('-'); // Join the words with a hyphen
  }

