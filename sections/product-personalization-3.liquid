  // Use one device scale for every preview. Do not use individual image width,
  // because PDP and popup containers have different widths.
  function getPersonalizationPreviewScale() {
      return window.matchMedia('(max-width: 767px)').matches ? 0.55 : 1;
  }

  function setScaledPreviewSize(element, fontSize, lineHeight) {
      if (!element) return;
      const deviceScale = getPersonalizationPreviewScale();
      const embroideryTextScale = 0.75;
      element.style.fontSize = `${fontSize * deviceScale * embroideryTextScale}px`;
      element.style.lineHeight = `${lineHeight * deviceScale * embroideryTextScale}px`;
  }

  function adjustFontSizeAndLineHeight0(monogramDisplay, textareaDisplay, textLength) {
      if (monogramDisplay) {
        if (monogramDisplay.classList.contains("flourish")) {
          const isMobilePreview = window.matchMedia('(max-width: 767px)').matches;
          monogramDisplay.style.fontSize = isMobilePreview ? '16px' : '22px';
          monogramDisplay.style.lineHeight = '30px';
        } else if (monogramDisplay.classList.contains("memorize")) {
          const isMobilePreview = window.matchMedia('(max-width: 767px)').matches;
          setScaledPreviewSize(monogramDisplay, 62, 74.4);
          if (isMobilePreview) {
            const currentFontSize = parseFloat(monogramDisplay.style.fontSize);
            monogramDisplay.style.fontSize = (currentFontSize + 2) + 'px';
          }
        } else if (monogramDisplay.classList.contains("fancy")) {
          const isMobilePreview = window.matchMedia('(max-width: 767px)').matches;
          setScaledPreviewSize(monogramDisplay, 62, 74.4);
          if (isMobilePreview) {
            monogramDisplay.style.fontSize = '22px';
          }
        } else {
          setScaledPreviewSize(monogramDisplay, 62, 74.4);
        }
        const largeTextSpan = monogramDisplay.querySelector('.monogram-large-text-os');
        if (largeTextSpan) {
          largeTextSpan.style.fontFamily = 'inherit';
          const baseMonogramFontSize = parseFloat(monogramDisplay.style.fontSize) || 22;
          largeTextSpan.style.fontSize = (baseMonogramFontSize * 1.5) + 'px';
          largeTextSpan.style.lineHeight = 'inherit';
        }
      }

      if (textareaDisplay && textLength) {
          let fontSize = 0;
          let lineHeight = 0;
          if (textareaDisplay.classList.contains("flourish")) {
            fontSize = textLength > 28 ? 24 : 28;
            lineHeight = textLength > 28 ? 48 : 65;
          } else if (textareaDisplay.classList.contains("signature")) {
            fontSize = textLength > 28 ? 45 : 72;
            lineHeight = textLength > 28 ? 42 : 60;
          } else if (textareaDisplay.classList.contains("fancy")) {
            fontSize = textLength > 28 ? 48 : 62;
            lineHeight = textLength > 28 ? 44 : 54;
          } else if (textareaDisplay.classList.contains("amalfi")) {
            fontSize = textLength > 28 ? 38 : 54;
            lineHeight = textLength > 28 ? 38 : 48;
          } else if (textareaDisplay.classList.contains("fondly-yours")) {
            fontSize = textLength > 28 ? 38 : 58;
            lineHeight = textLength > 28 ? 38 : 54;
          } else if (textareaDisplay.classList.contains("casually-cool")) {
            fontSize = textLength > 28 ? 42 : 62;
            lineHeight = textLength > 28 ? 42 : 48;
          } else if (textareaDisplay.classList.contains("memorize")) {
            fontSize = textLength > 28 ? 42 : 51.3333333;
            lineHeight = textLength > 28 ? 45 : 62;
          } else if (textareaDisplay.classList.contains("headliner")) {
            fontSize = textLength > 28 ? 28 : 45;
            lineHeight = textLength > 28 ? 34 : 48;
          } else if (textareaDisplay.classList.contains("letter-jacket")) {
            fontSize = textLength > 28 ? 32 : 48;
            lineHeight = textLength > 28 ? 38 : 56;
          } else if (textareaDisplay.classList.contains("vintage")) {
            fontSize = textLength > 28 ? 28 : 45;
            lineHeight = textLength > 28 ? 32 : 48;
          } else {
            fontSize = textLength > 28 ? 32 : 48;
            lineHeight = textLength > 28 ? 38 : 52;
          }
          setScaledPreviewSize(textareaDisplay, fontSize, lineHeight);
      }
  }

