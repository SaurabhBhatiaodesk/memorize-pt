  // Canvas code starts
  const createImageCanvas = (type) => {
      var canvas = document.querySelector('.personalize-product-canvas-os canvas');
      var ctx = canvas.getContext('2d');
  
      // Get the device pixel ratio, defaulting to 1 if it's not available
      const pixelRatio = window.devicePixelRatio || 1;
  
      // Adjust canvas size for high-DPI devices (retina screens)
      var canvasWidth = canvas.width;
      var canvasHeight = canvas.height;
  
      // Scale the canvas resolution according to the device pixel ratio
      canvas.width = canvasWidth * pixelRatio;
      canvas.height = canvasHeight * pixelRatio;
  
      // Scale the drawing context to handle the higher resolution
      ctx.scale(pixelRatio, pixelRatio);
  
      // Ensure canvas element maintains the original size in the DOM
      canvas.style.width = `${canvasWidth}px`;
      canvas.style.height = `${canvasHeight}px`;
  
      // Define the target image size (450px * 450px)
      var imageWidth = 450;
      var imageHeight = 450;

      const indexOnecontainer = customImagesContainers?.[3];

      let trunkImgSrc = '';
      let fabricImgSrc = '';
      let textareaText = '';
      let monogramText = '';

      let trunkEl, fabricEl, textareaEl, monogramEl;
      let textareaTextStyle, monogramTextStyle, monogramLargeTextStyle;

      
      if (!indexOnecontainer) {
        console.warn('No indexOnecontainer found (show-os or index 3).');
      } else {
        trunkEl    = indexOnecontainer.querySelector('.main-trunk-image-os');
        fabricEl   = indexOnecontainer.querySelector('.main-fabric-image-os');
        textareaEl = indexOnecontainer.querySelector('.textarea-text-display-os');
        monogramEl = indexOnecontainer.querySelector('.monogram-text-display-os');

        // use currentSrc/src for <img>; fall back to empty strings
        trunkImgSrc   = trunkEl?.currentSrc || trunkEl?.src || '';
        fabricImgSrc  = fabricEl?.currentSrc || fabricEl?.src || '';
        textareaText  = (textareaEl?.textContent || '').trim();
        monogramText  = (monogramEl?.textContent || '').trim();

        // computed styles (guard each element)
        if (textareaEl) {
          textareaTextStyle = getComputedStyle(textareaEl);
        }
        if (monogramEl) {
          monogramTextStyle = getComputedStyle(monogramEl);
          const monogramLargeEl = monogramEl.querySelector('.monogram-large-text-os');
          if (monogramLargeEl) {
            monogramLargeTextStyle = getComputedStyle(monogramLargeEl);
          }
        }
      }


      // FONT EXPORT FIX ONLY:
      // Measure the visible preview image so the exported canvas text keeps
      // the same proportion as the text shown to the customer.
      const visiblePreviewContainer = Array.from(customImagesContainers || []).find((container) => {
        const rect = container.getBoundingClientRect();
        const style = window.getComputedStyle(container);

        return (
          rect.width > 0 &&
          rect.height > 0 &&
          style.display !== 'none' &&
          style.visibility !== 'hidden'
        );
      });

      const visiblePreviewTrunk =
        visiblePreviewContainer?.querySelector('.main-trunk-image-os') ||
        trunkEl;

      const previewTrunkWidth =
        visiblePreviewTrunk?.getBoundingClientRect?.().width ||
        parseFloat(
          visiblePreviewTrunk
            ? window.getComputedStyle(visiblePreviewTrunk).width
            : '0'
        ) ||
        imageWidth;

      const previewToCanvasScale = imageWidth / previewTrunkWidth;

      const scaledFontValue = (styleValue) => {
        const size = parseFloat(styleValue);
        return `${(Number.isFinite(size) ? size : 0) * previewToCanvasScale}px`;
      };

      const scaledLineHeightValue = (styleValue, fallbackFontSize) => {
        const lineHeight = parseFloat(styleValue);
        const fallback = parseFloat(fallbackFontSize);

        const value = Number.isFinite(lineHeight)
          ? lineHeight
          : Number.isFinite(fallback)
            ? fallback * 1.2
            : 0;

        return value * previewToCanvasScale;
      };

      console.log('indexOnecontainer ::', indexOnecontainer);
      console.log('values ::', { trunkImgSrc, fabricImgSrc, textareaText, monogramText });
      console.log('textareaTextStyle ::', textareaTextStyle);
      console.log('monogramTextStyle ::', monogramTextStyle);
      console.log('monogramLargeTextStyle ::', monogramLargeTextStyle);

  
      // Load trunk image with crossOrigin to avoid CORS issues
      var trunkImg = new Image();
      trunkImg.crossOrigin = 'anonymous'; // This line solves CORS issues
      var fabricImg = new Image();
      fabricImg.crossOrigin = 'anonymous'; // This line solves CORS issues
  
      var imagesLoaded = 0; // To track image loading
  
      const onImageLoad = () => {
          imagesLoaded++;
          if (imagesLoaded === 2) {
              // Once both images are loaded, draw on the canvas
              drawCanvas();
          }
      };
  
      trunkImg.onload = onImageLoad;
      fabricImg.onload = onImageLoad;
  
      // Error handlers for images
      trunkImg.onerror = () => {
          console.error("Trunk image failed to load due to CORS or other issues.");
      };
      fabricImg.onerror = () => {
          console.error("Fabric image failed to load due to CORS or other issues.");
      };
  
      // Assign source last to avoid race conditions
      trunkImg.src = trunkImgSrc;
      fabricImg.src = fabricImgSrc;
  
      const drawCanvas = () => {
          // Set the background color to white
          ctx.fillStyle = "white";
          ctx.fillRect(0, 0, canvasWidth, canvasHeight); // Fill the entire canvas with white
  
          // Draw trunk image (background) with adjusted size (450px * 450px)
          ctx.drawImage(trunkImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight); // Center image horizontally and set size
      
          // Draw fabric image on top with adjusted size (450px * 450px)
          ctx.drawImage(fabricImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight); // Same position and size to overlay
      
          if (textareaText.length > 0) {
              // If textarea-text-display-os has text, render it
              const exportedTextareaFontSize = scaledFontValue(textareaTextStyle.fontSize);
              ctx.font = `${textareaTextStyle.fontWeight} ${exportedTextareaFontSize} ${textareaTextStyle.fontFamily}`;
              // Make sure text color is kept as original, not overridden by background color
              ctx.fillStyle = textareaTextStyle.color; // Keep the original color for the text
      
              // Split the text by lines (handling both spaces and newlines)
              const requestedLines = textareaText.split('\n');
              const lineHeight = scaledLineHeightValue(
                textareaTextStyle.lineHeight,
                textareaTextStyle.fontSize
              );
              const maxWidth = 250; // Set max width to 300px

              // Character-level wrapping prevents long words/numbers without
              // spaces from overflowing the exported embroidery image.
              const wrapCanvasLine = (line) => {
                  const wrapped = [];
                  let currentLine = '';

                  Array.from(line).forEach((character) => {
                      const testLine = currentLine + character;
                      if (currentLine && ctx.measureText(testLine).width > maxWidth) {
                          wrapped.push(currentLine.trimEnd());
                          currentLine = character.trimStart();
                      } else {
                          currentLine = testLine;
                      }
                  });

                  wrapped.push(currentLine.trim());
                  return wrapped;
              };

              const lines = requestedLines.flatMap(wrapCanvasLine);
  
              let totalTextHeight = 0; // Variable to track the total text height
  
              // Calculate total height of the text block for multi-line text
              for (let i = 0; i < lines.length; i++) {
                  totalTextHeight += lineHeight;
              }
  
              // Define the red box's vertical positioning (adjust this as needed)
              const redBoxTop = 125; // The top position of the red box
              const redBoxHeight = 280; // The height of the red box
  
              // Conditional logic for single-line vs multi-line text
              let yPosition;
              if (lines.length === 1) {
                  // Single-line text: center based on the height of the text itself
                  const textHeight = parseFloat(exportedTextareaFontSize);
                  yPosition = redBoxTop + (redBoxHeight - textHeight) / 2; // Center the single line text
              } else {
                  // Multi-line text: center the entire block
                  yPosition = redBoxTop + (redBoxHeight - totalTextHeight) / 2; // Center the text block
              }
  
              // Loop through each line
              let currentYPosition = yPosition;
              for (let i = 0; i < lines.length; i++) {
                  let line = lines[i];
                  // Handle the splitting of long words into multiple lines if needed
                  let words = line.split(' ');
                  let lineText = '';
  
                  for (let j = 0; j < words.length; j++) {
                      const testLine = lineText + words[j] + ' ';
                      const testWidth = ctx.measureText(testLine).width;
  
                      if (testWidth > maxWidth && j > 0) {
                          ctx.fillText(lineText, (canvasWidth - ctx.measureText(lineText).width) / 2, currentYPosition); // Center the line
                          lineText = words[j] + ' '; // Start a new line with the current word
                          currentYPosition += lineHeight; // Move the Y position down for the next line
                      } else {
                          lineText = testLine; // Update the line with the current word
                      }
                  }
  
                  ctx.fillText(lineText, (canvasWidth - ctx.measureText(lineText).width) / 2, currentYPosition); // Render the remaining line
                  currentYPosition += lineHeight; // Move the Y position down for the next line
              }
          } else if (monogramText.length === 3) {
              // If monogram-text-display-os has text, render it instead
              ctx.fillStyle = monogramTextStyle.color;
      
              // Calculate the total width of the monogram and center it
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var firstLetterWidth = ctx.measureText(monogramText.charAt(0)).width;
      
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              var secondLetterWidth = ctx.measureText(monogramText.charAt(1)).width;
      
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var thirdLetterWidth = ctx.measureText(monogramText.charAt(2)).width;
      
              var totalWidth = firstLetterWidth + secondLetterWidth + thirdLetterWidth;
              var startXPosition = (canvasWidth - totalWidth) / 2;
      
              // Drawing each letter with the dynamic style
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(0), startXPosition, 280); // First letter on top of image
      
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(1), startXPosition + firstLetterWidth, 287); // Second letter (larger)
      
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(2), startXPosition + firstLetterWidth + secondLetterWidth, 280); // Third letter
          }

          // Check for WebP support and fallback to JPEG if not supported
          var base64ImageURL;
          var Base64URLCode;
          var Base64ToShopifyURL;

          base64ImageURL = canvas.toDataURL('image/png');
          
          // Extract the base64 code after 'data:image/webp;base64,' or 'data:image/jpeg;base64,'
          Base64URLCode = base64ImageURL.split(',')[1]; // Split the string and get the second part
          
          // PostImage admin api starts
          const postImageHeaders = new Headers();
          postImageHeaders.append("X-Shopify-Access-Token", "{{ shop.api_secret_key }}");
          postImageHeaders.append("Content-Type", "application/json");
          postImageHeaders.append("x-cors-api-key", "{{ shop.api_secret_key }}");
          
          const PRIMARY_IMAGE_PRODUCT_ID = 15532834357321;
          const SECONDARY_IMAGE_PRODUCT_ID = 15644752085065;
          
          async function uploadImageToProduct(productId) {
            const rawPostImage = JSON.stringify({
              "base64Url": Base64URLCode,
              "productId": productId,
              "shop": "memorize-llc.myshopify.com"
            });
            const requestOptions = { method: "POST", body: rawPostImage, redirect: "follow" };
            
            const response = await fetch("https://memorize-images-upload-951530957c9e.herokuapp.com/api/imagesUpload", requestOptions);
            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
            
            const result = await response.json();
            const imageUrl = result?.data?.[0]?.preview?.image?.src;
            
            if (!imageUrl) throw new Error("Image URL not received from upload API.");
            
            return imageUrl;
          }
          
          async function postImage() {
            try {
              try {
                Base64ToShopifyURL = await uploadImageToProduct(PRIMARY_IMAGE_PRODUCT_ID);
                return Base64ToShopifyURL;
              } catch (primaryError) {
                console.warn("Primary image product upload failed. Trying secondary image product.", primaryError);
              }
              
              Base64ToShopifyURL = await uploadImageToProduct(SECONDARY_IMAGE_PRODUCT_ID);
              return Base64ToShopifyURL;
            } catch (error) {
              controlLoaderOverlay("no");
              console.error("Error:", error.message);
              return null;
            }
          }
