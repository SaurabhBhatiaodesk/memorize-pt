  // Function to update monogram letter count
  function updateMonogramLetterCount() {
      const maxCharacters = monogramInputs.length; // Set the maximum character limit (3 for three inputs)
      
      // Count the number of filled letters
      const filledCount = Array.from(monogramInputs).reduce((count, input) => {
          return count + (input.value.length > 0 ? 1 : 0);
      }, 0);
  
      // Calculate remaining characters
      const remainingCount = maxCharacters - filledCount;
  
      // Update the displayed letter count
      const letterCountDisplay = document.querySelector('.monogram-letter-count-os');
      if (letterCountDisplay) {
          letterCountDisplay.textContent = remainingCount; // Update with the remaining count
      }
  
      // Update the hidden input with the combined text
      getMonogramText();    
      updatePriceAccordingToPersonalizeLetters(filledCount);
    
  }
  
  // Function to get combined text from the three monogram input fields
  function getMonogramText() {
      let monogramText = [];
      monogramInputs.forEach(input => {
          monogramText.push(input.value);
      });
  
      // Join the array into a single string
      const myString = monogramText.join('');
  
      if (desktopMonogramHiddenInput) {
          desktopMonogramHiddenInput.value = myString;
      }
      return monogramText;
  }

  // Function to handle focus shifting in monogram inputs (second tab)
  function handleMonogramInput(event) {
    const target = event.target;
    const maxLength = target.getAttribute('maxlength');

    if (target.value.length >= maxLength) {
      // Move focus to the next input field if the current one is filled
      const nextInput = target.nextElementSibling;
      if (nextInput && nextInput.tagName === 'INPUT') {
          nextInput.focus();
      }
    }
  }

  // Function to handle backspace for focus shifting (second tab)
  function handleMonogramBackspace(event) {
    const target = event.target;

    // If backspace is pressed and the input is empty, move focus to the previous input
    if (event.key === 'Backspace' && target.value === '') {
      const prevInput = target.previousElementSibling;
      if (prevInput && prevInput.tagName === 'INPUT') {
          prevInput.focus();
      }
    }
  }

