  // FONT LIST
  // =====================================================================

  const desktopFontsList = document.querySelectorAll('.font-btn-row-os .font-option-os');

  const handleDesktopFontSelection = (event) => {
      if (!validateTextareaAndMonogramInputFields()) return;
      const selectedFont = event.currentTarget.dataset.font;
      currentSelectedFontFamily = selectedFont;
      handleOfficialFontCode(selectedFont);
      desktopFontsList.forEach(item => item.classList.remove('active'));
      event.currentTarget.classList.add('active');
      updateTextDisplay(printingTextArea.value, getMonogramText());
      applyFontFamily(selectedFont);
      adjustFontSizeAndLineHeight(printingTextArea);
  };
  
  desktopFontsList.forEach(option => {
      option.addEventListener('click', handleDesktopFontSelection);
  });

  // =====================================================================
  // VALIDATE FIELDS BEFORE SUBMISSION
  // =====================================================================

  function validateFields() {
    const selectedTab = document.querySelector('.main-product-tabs-os .active');
    let isValid = true;
    let errorMessage = '';

    if (selectedTab.classList.contains('tab-1-os')) {
        const textareaValue = printingTextArea.value.trim();
        if (!textareaValue) { isValid = false; errorMessage += 'Please fill in the Words/Numbers field.\n'; }
        const selectedFont = document.querySelector('.custom-font-names-os').value;
        if (!selectedFont) { isValid = false; errorMessage += 'Please select a font.\n'; }
        const colorSelected = document.querySelector('.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked');
        if (!colorSelected) { isValid = false; errorMessage += 'Please select a thread color.\n'; }
    } else if (selectedTab.classList.contains('tab-2-os')) {
        const monogramValues = Array.from(monogramInputs).map(input => input.value.trim());
        if (monogramValues.some(value => value.length === 0)) { isValid = false; errorMessage += 'Please fill in all three Monogram fields.\n'; }
        if (monogramValues.join('').length !== 3) { isValid = false; errorMessage += 'Monogram must consist of exactly 3 characters.\n'; }
        const selectedMonogramFont = document.querySelector('.custom-font-names-os').value;
        if (!selectedMonogramFont) { isValid = false; errorMessage += 'Please select a font for the monogram.\n'; }
        const colorSelected = document.querySelector('.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked');
        if (!colorSelected) { isValid = false; errorMessage += 'Please select a thread color.\n'; }
    } else if (selectedTab.classList.contains('tab-3-os')) {
        isValid = false;
        errorMessage += 'Please select any one Embroidery Type.\n';
    }

    return { isValid, errorMessage };
  }

