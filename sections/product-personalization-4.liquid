  // One shared device scale keeps PDP and popup sizes identical.
  function getPersonalizationPreviewScale() {
      return window.matchMedia('(max-width: 767px)').matches ? 0.55 : 1;
  }

  function setScaledPreviewSize(element, fontSize, lineHeight) {
      if (!element) return;
      const deviceScale = getPersonalizationPreviewScale();
      const embroideryTextScale = 0.75;
      element.style.fontSize = `${fontSize * deviceScale * embroideryTextScale}px`;
      element.style.lineHeight = `${lineHeight * deviceScale * embroideryTextScale}px`;
  }

  function adjustFontSizeAndLineHeight0(monogramDisplay, textareaDisplay, textLength) {
      if (monogramDisplay) {
        setScaledPreviewSize(monogramDisplay, 62, 74.4);
        const largeTextSpan = monogramDisplay.querySelector('.monogram-large-text-os');
        if (largeTextSpan) {
          setScaledPreviewSize(largeTextSpan, 62, 74.4);
        }
      }

      if (textareaDisplay && textLength) {
          let fontSize = 0;
          let lineHeight = 0;
          if (textareaDisplay.classList.contains("flourish")) {
            fontSize = textLength > 28 ? 24 : 28;
            lineHeight = textLength > 28 ? 48 : 65;
          } else if (textareaDisplay.classList.contains("signature")) {
            fontSize = textLength > 28 ? 45 : 72;
            lineHeight = textLength > 28 ? 42 : 60;
          } else if (textareaDisplay.classList.contains("fancy")) {
            fontSize = textLength > 28 ? 48 : 62;
            lineHeight = textLength > 28 ? 44 : 54;
          } else if (textareaDisplay.classList.contains("amalfi")) {
            fontSize = textLength > 28 ? 38 : 54;
            lineHeight = textLength > 28 ? 38 : 48;
          } else if (textareaDisplay.classList.contains("fondly-yours")) {
            fontSize = textLength > 28 ? 38 : 58;
            lineHeight = textLength > 28 ? 38 : 54;
          } else if (textareaDisplay.classList.contains("casually-cool")) {
            fontSize = textLength > 28 ? 42 : 62;
            lineHeight = textLength > 28 ? 42 : 48;
          } else if (textareaDisplay.classList.contains("memorize")) {
            fontSize = textLength > 28 ? 42 : 51.3333333;
            lineHeight = textLength > 28 ? 45 : 62;
          } else if (textareaDisplay.classList.contains("headliner")) {
            fontSize = textLength > 28 ? 28 : 45;
            lineHeight = textLength > 28 ? 34 : 48;
          } else if (textareaDisplay.classList.contains("letter-jacket")) {
            fontSize = textLength > 28 ? 32 : 48;
            lineHeight = textLength > 28 ? 38 : 56;
          } else if (textareaDisplay.classList.contains("vintage")) {
            fontSize = textLength > 28 ? 28 : 45;
            lineHeight = textLength > 28 ? 32 : 48;
          } else {
            fontSize = textLength > 28 ? 32 : 48;
            lineHeight = textLength > 28 ? 38 : 52;
          }
          setScaledPreviewSize(textareaDisplay, fontSize, lineHeight);
      }
  }

  function rescaleAllPersonalizationPreviews() {
      document.querySelectorAll('.textarea-text-display-os').forEach((display) => {
          const textLength = display.textContent.length;
          if (textLength) adjustFontSizeAndLineHeight0(null, display, textLength);
      });

      document.querySelectorAll('.monogram-text-display-os').forEach((display) => {
          if (display.textContent.trim()) adjustFontSizeAndLineHeight0(display);
      });
  }

  let personalizationResizeFrame;
  window.addEventListener('resize', () => {
      cancelAnimationFrame(personalizationResizeFrame);
      personalizationResizeFrame = requestAnimationFrame(rescaleAllPersonalizationPreviews);
  });

  function clearTextDisplay() {
      customImagesContainers.forEach(container => {
          if (printingTextArea.value) {
            container.querySelector('.textarea-text-display-os').textContent = '';
            container.querySelector('.monogram-text-display-os').innerHTML = '';
            printingTextArea.value = '';
          }
          monogramInputs.forEach((input) => {
            if (input.value) {
              container.querySelector('.textarea-text-display-os').textContent = '';
              container.querySelector('.monogram-text-display-os').innerHTML = '';
              input.value = '';
            }
          });
      });
  }

  function updateMonogramLetterCount() {
      const maxCharacters = monogramInputs.length;
      const filledCount = Array.from(monogramInputs).reduce((count, input) => {
          return count + (input.value.length > 0 ? 1 : 0);
      }, 0);
      const remainingCount = maxCharacters - filledCount;
      const letterCountDisplay = document.querySelector('.monogram-letter-count-os');
      if (letterCountDisplay) letterCountDisplay.textContent = remainingCount;
      getMonogramText();
      updatePriceAccordingToPersonalizeLetters(filledCount);
  }
  
  function getMonogramText() {
      let monogramText = [];
      monogramInputs.forEach(input => { monogramText.push(input.value); });
      const myString = monogramText.join('');
      if (desktopMonogramHiddenInput) desktopMonogramHiddenInput.value = myString;
      return monogramText;
  }

  function handleMonogramInput(event) {
    const target = event.target;
    const maxLength = target.getAttribute('maxlength');
    if (target.value.length >= maxLength) {
      const nextInput = target.nextElementSibling;
      if (nextInput && nextInput.tagName === 'INPUT') nextInput.focus();
    }
  }

  function handleMonogramBackspace(event) {
    const target = event.target;
    if (event.key === 'Backspace' && target.value === '') {
      const prevInput = target.previousElementSibling;
      if (prevInput && prevInput.tagName === 'INPUT') prevInput.focus();
    }
  }

  function handleFontChangeTab() {
    let letterCased = toHyphenatedCase(selectedFontInput.value);
    currentSelectedFontFamily = letterCased;
    updateTextDisplay(printingTextArea.value, getMonogramText());
    applyFontFamily(currentSelectedFontFamily);
  }

  selectedFontInput.addEventListener('change', handleFontChangeTab);

  function applyFontFamily(fontName) {    
    let letterCased = toLetterCase(fontName);
    selectedFontInput.value = letterCased;
  }

  function adjustFontSizeAndLineHeight(textarea) {
      const textLength = textarea.value.length;
      const textareaDisplays = document.querySelectorAll('.textarea-text-display-os');
      const letterCountDisplay = document.querySelector('.textarea-letter-count-os');
      const maxCharacters = 40;

      textareaDisplays.forEach((textareaDisplay) => {
        adjustFontSizeAndLineHeight0(null, textareaDisplay, textLength);
      });
      if (letterCountDisplay) {
        letterCountDisplay.textContent = String(maxCharacters - textLength);
      }
      return;
  
      textareaDisplays.forEach((textareaDisplay, index) => {
        if (index === 0) {
          adjustFontSizeAndLineHeight0(null, textareaDisplay, textLength);
        } else {
          let fontSize = '';
          let lineHeight = '';
          if (textareaDisplay.classList.contains("flourish")) {
            fontSize = textLength > 28 ? '16px' : '24px';
            lineHeight = textLength > 28 ? '35px' : '40px';
          } else if (textareaDisplay.classList.contains("signature")) {
            fontSize = textLength > 28 ? '35px' : '45px';
            lineHeight = textLength > 28 ? '32px' : '38px';
          } else if (textareaDisplay.classList.contains("fancy")) {
            fontSize = textLength > 28 ? '35px' : '45px';
            lineHeight = textLength > 28 ? '30px' : '38px';
          } else if (textareaDisplay.classList.contains("amalfi")) {
            fontSize = textLength > 28 ? '28px' : '38px';
            lineHeight = textLength > 28 ? '28px' : '38px';
          } else if (textareaDisplay.classList.contains("fondly-yours")) {
            fontSize = textLength > 28 ? '29px' : '38px';
            lineHeight = textLength > 28 ? '28px' : '35px';
          } else if (textareaDisplay.classList.contains("casually-cool")) {
            fontSize = textLength > 28 ? '30px' : '42px';
            lineHeight = textLength > 28 ? '28px' : '38px';
          } else if (textareaDisplay.classList.contains("memorize")) {
            fontSize = textLength > 28 ? '28px' : '43px';
            lineHeight = textLength > 28 ? '32px' : '38px';
          } else if (textareaDisplay.classList.contains("headliner")) {
            fontSize = textLength > 28 ? '20px' : '32px';
            lineHeight = textLength > 28 ? '24px' : '35px';
          } else if (textareaDisplay.classList.contains("letter-jacket")) {
            fontSize = textLength > 28 ? '24px' : '32px';
            lineHeight = textLength > 28 ? '28px' : '35px';
          } else if (textareaDisplay.classList.contains("vintage")) {
            fontSize = textLength > 28 ? '20px' : '28px';
            lineHeight = textLength > 28 ? '24px' : '32px';
          } else if (textareaDisplay.classList.contains("royal")) {
            fontSize = textLength > 28 ? '24px' : '28px';
            lineHeight = textLength > 28 ? '28px' : '32px';
          } else {
            fontSize = textLength > 28 ? '24px' : '32px';
            lineHeight = textLength > 28 ? '28px' : '38px';
          }
          textareaDisplay.style.fontSize = fontSize;
          textareaDisplay.style.lineHeight = lineHeight;
        }
      });

      if (letterCountDisplay) {
        letterCountDisplay.textContent = String(maxCharacters - textLength);
      }
  }

  function limitTextToTwoLines(textarea) {
      const maxLines = 2;
      let text = textarea.value;
      let lines = text.split('\n').slice(0, maxLines);
      textarea.value = lines.join('\n');
  }
  
  printingTextArea.addEventListener('input', (item) => {
      limitTextToTwoLines(printingTextArea);
      updateTextDisplay(printingTextArea.value, []);
      adjustFontSizeAndLineHeight(printingTextArea);
      updatePriceAccordingToPersonalizeLetters(printingTextArea.value.length);
  });

  monogramInputs.forEach(input => {
      input.addEventListener('input', () => {
          updateTextDisplay('', getMonogramText());
          updateMonogramLetterCount();
      });
      input.addEventListener('input', handleMonogramInput);
      input.addEventListener('keydown', handleMonogramBackspace);
  });

  // =====================================================================
  // PRICE UPDATE
  // =====================================================================

  function updatePriceAccordingToPersonalizeLetters(data) {
      let priceAddition;
      if (typeof data === 'undefined' || data === null) {
          priceAddition = 0;
          updatePriceAccordingToLetters(priceAddition);
          return;
      }
      const elementLength = data;  
      const selectedTab = document.querySelector('.main-product-tabs-os .active');  
  
      if (selectedTab.classList.contains('tab-1-os')) {
          if (elementLength > 0 && elementLength <= 18) priceAddition = 25;
          else if (elementLength > 18 && elementLength <= 28) priceAddition = 35;
          else if (elementLength > 28) priceAddition = 40;
          else priceAddition = 0;
          updatePriceAccordingToLetters(priceAddition);
      }
      if (selectedTab.classList.contains('tab-2-os')) {
          priceAddition = elementLength > 0 ? 25 : 0;
          updatePriceAccordingToLetters(priceAddition);
      }
  }

  function mobileUpdatePriceAccordingToPersonalizeLetters(data) {
      let priceAddition;
      if (typeof data === 'undefined' || data === null) {
          priceAddition = 0;
          updatePriceAccordingToLetters(priceAddition);
          return;
      }
      const elementLength = data;  
      const selectedTab = document.querySelector('.mobile-embroideryType-buttons-os .selected');  
  
      if (selectedTab.classList.contains('mobile-embroidery-btn-1')) {
          if (elementLength > 0 && elementLength <= 18) priceAddition = 25;
          else if (elementLength > 18 && elementLength <= 28) priceAddition = 35;
          else if (elementLength > 28) priceAddition = 40;
          else priceAddition = 0;
          updatePriceAccordingToLetters(priceAddition);
      }
      if (selectedTab.classList.contains('mobile-embroidery-btn-2')) {
          priceAddition = elementLength > 0 ? 25 : 0;
          updatePriceAccordingToLetters(priceAddition);
      }
  }

  function updatePriceAccordingToLetters(priceAddition) {
     const pdpProductVariantPrice = document.querySelector('.main-product-os product-price-root.product-price--root .product-price--original');
      if (pdpProductVariantPrice) {
          const currencySymbol = {{currency_symbol | json}};
          const priceText = pdpProductVariantPrice.textContent.trim();
          const price = parseFloat(priceText.replace(currencySymbol, '').trim());
          const updatedPrice = price + priceAddition;
          if (addToCartButton) addToCartButton.textContent = `Add To Cart (${currencySymbol}${updatedPrice.toFixed(2)})`;
          if (mobileAddToCartButton) mobileAddToCartButton.textContent = `Add To Cart (${currencySymbol}${updatedPrice.toFixed(2)})`;
      }
  }

  const thumbnailImages = document.querySelectorAll('.product-media--thumbs-wrapper > div');
  thumbnailImages.forEach(thumbnail => {
      thumbnail.addEventListener('click', function() {
          customImagesContainers.forEach((container) => {
            if (container.classList.contains(showClass)) {
                container.classList.remove(showClass);
                container.classList.add(hideClass);
            }
          });
          thumbnailContainer.forEach((item) => {
              if (item.classList.contains(hideClass)) {
                  item.classList.remove(hideClass);
                  item.classList.add(showClass);
              }
          });
      });
  });

  document.addEventListener("DOMContentLoaded", function() {
      thumbnailContainer.forEach((item) => { item.classList.add(showClass); });
      mobileThumbnailContainer.forEach((item) => { item.classList.add(showClass); });
      customImagesContainers.forEach(container => { container.classList.add(hideClass); });
      handleFontChangeTab();
      const allTextareaDisplayElement = document.querySelectorAll('.personalize-product-popup-row-os .textarea-text-display-os');
      allTextareaDisplayElement.forEach((item) => { item.innerHTML = "Text Goes Here."; });
  });

  // =====================================================================
  // ADD TO CART HANDLERS
  // =====================================================================

  const desktopAddLoaderAndDisableFields = async () => {
      controlLoaderOverlay("yes");
      const fontOptions = document.querySelectorAll('.font-btn-row-os .font-option-os');
      fontOptions.forEach(option => {
        option.style.pointerEvents = 'none';
        option.classList.add('disabled-os');
      });
      const wordNumberTextarea = document.querySelector('.input-field-os textarea');
      if (wordNumberTextarea) wordNumberTextarea.classList.add("disabled-os");
      const monogramInputs = document.querySelectorAll('.monogram-input-field-os input[type="text"]');
      monogramInputs.forEach(input => { input.disabled = true; });
      const fontColorElements = document.querySelectorAll('.desktop-custom-thread-color-list-os .slick-list .slick-slide');
      fontColorElements.forEach(option => { option.classList.add('disabled-os'); });
      const embroideryTypeElements = document.querySelectorAll('.main-product-tabs-os .embroidery-tab-os');
      embroideryTypeElements.forEach(option => { option.classList.add('disabled-os'); });
  };
  
  const mobileAddLoaderAndDisableFields = async () => {
      controlLoaderOverlay("yes");
      const goPreviousButtonElement = document.querySelector('.pagination-controls-button-os .backward-step-os');
      if (goPreviousButtonElement) goPreviousButtonElement.disabled = true;
  };

  addToCartButton.addEventListener('click', async () => {
      const validationResult = validateFields();
      if (!validationResult.isValid) {
          alert(validationResult.errorMessage);
          return;
      }
      addToCartButton.disabled = true;
      addToCartButton.textContent = "Adding To Cart";
      await desktopAddLoaderAndDisableFields();
      createImageCanvas('desktop');
  });

  mobileAddToCartButton.addEventListener('click', async (e) => {
      mobileAddToCartButton.disabled = true;
      mobileAddToCartButton.textContent = "Adding To Cart";
      await mobileAddLoaderAndDisableFields();
      createImageCanvas('mobile'); 
  });

  function clearInputValuesByName(names) {
    names.forEach(name => {
        let inputs = document.querySelectorAll(`input[name="${name}"]`);
        inputs.forEach(input => {
            switch (input.type) {
                case 'text': input.value = ''; break;
                case 'hidden': input.value = ''; break;
                case 'radio': input.checked = false; break;
            }
        });
    });
  }

  MainAddToCartButton.addEventListener('click', () => {
    if (MainAddToCartButton) {
      clearInputValuesByName(['properties[Thread Color]', 'properties[Embroidery Type]', 'properties[WordsNumbers]', 'properties[Monogram]', 'properties[Font]']);
  
      const textareaDisplay = document.querySelectorAll('.textarea-text-display-os');
      const monogramDisplay = document.querySelectorAll('.monogram-text-display-os');
      textareaDisplay.forEach(texts => { texts.textContent = ""; });
      monogramDisplay.forEach(texts => { texts.textContent = ""; });
  
      const fabricRadios = document.querySelectorAll('input[name="properties[Fabric]"]');
      let isFabricChecked = false;
      fabricRadios.forEach(radio => { if (radio.checked) isFabricChecked = true; });
  
      const trunkRadios = document.querySelectorAll('input[name="properties[Exterior Trunk Color]"]');
      let isTrunkChecked = false;
      trunkRadios.forEach(radio => { if (radio.checked) isTrunkChecked = true; });
  
      if (isFabricChecked && isTrunkChecked) {
        toggleButtonState(MainAddToCartButton, true, 'LOADING...');
        createImageCanvas('default');
      } else {
        toggleButtonState(MainAddToCartButton, true, 'LOADING...');
        const selectElement = document.querySelector('.product-buy-buttons--select');
        const selectedVariantId = selectElement.value;
        defaultAddToCart(selectedVariantId);
      }
    }
  });
  
  function defaultAddToCart(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
    })
    .then(res => {
      if (!res.ok) throw new Error('Network response was not ok');
      return res.json();
    })
    .then(data => {
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      window.location.href = '/cart';
    })
    .catch(error => {
      console.error('Add to cart error:', error);
      alert(error);
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
    });
  }

  // =====================================================================
  // FORM SUBMISSION
  // =====================================================================

  function customformSubmission(personalizeItVariantId) {
    let formData = {
        'items': [{ 'id': null, 'quantity': 1, 'properties': {} }]
    };
    
    const predefinedItem = { 'id': personalizeItVariantId, 'quantity': 1, 'properties': {} };
    let cartNote = '';

    const propertyOrder = [
        'Exterior Trunk Color', 'Fabric', 'Embroidery Type', 'WordsNumbers',
        'Monogram', 'Font', 'Thread Color', 'image', 'personalize_it_variant_id',
        '_Font Name', '_Thread Hex Code'
    ];

    const tempProperties = {};
    let productId = '';

    $('form#mobile-desktop-product').serializeArray().forEach(item => {
      if (item.name === 'id') {
          if (item.value.trim() !== "") productId = item.value;
      } else if (item.name.startsWith('properties[')) {
          const propertyName = item.name.substring(11, item.name.length - 1);
          if (item.value.trim() !== "") tempProperties[propertyName] = item.value;
      }
      if (item.name === 'note' && item.value.trim() !== '') cartNote = item.value.trim();
    });

    // Keep the generated preview URL and the latest selected thread colour
    // together on the same cart line item.
    const getLastNonEmptyValue = (selector) => {
      const values = Array.from(document.querySelectorAll(selector))
        .map((element) => String(element.value || '').trim())
        .filter(Boolean);

      return values.length ? values[values.length - 1] : '';
    };

    const generatedPreviewUrl = getLastNonEmptyValue(
      '.properties-cstm-image, .custom-image-link-os, input[name="properties[image]"]'
    );

    if (generatedPreviewUrl) {
      tempProperties.image = generatedPreviewUrl;
    } else {
      delete tempProperties.image;
    }

    const checkedDesktopThreadInputs = Array.from(
      document.querySelectorAll(
        '.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked'
      )
    );

    const activeDesktopThreadInputs = checkedDesktopThreadInputs.filter(
      (input) => input.closest('.swatch-container-os.active')
    );

    const desktopThreadInput =
      activeDesktopThreadInputs[activeDesktopThreadInputs.length - 1] ||
      checkedDesktopThreadInputs[checkedDesktopThreadInputs.length - 1] ||
      null;

    const desktopThreadColor = String(desktopThreadInput?.value || '').trim();
    const mobileThreadColor = getLastNonEmptyValue(
      '.mobile-personalize-fields-col-os .selectedColor, .selectedColor'
    );

    const isMobilePersonaliser =
      window.matchMedia &&
      window.matchMedia('(max-width: 767px)').matches;

    const finalThreadColor = isMobilePersonaliser
      ? (mobileThreadColor || desktopThreadColor)
      : (desktopThreadColor || mobileThreadColor);

    if (finalThreadColor) {
      tempProperties['Thread Color'] = finalThreadColor;

      const matchingThreadInput = Array.from(
        document.querySelectorAll('input[name="properties[Thread Color]"]')
      ).find((input) => String(input.value || '').trim() === finalThreadColor);

      const selectedThreadHex =
        matchingThreadInput?.getAttribute('data-color') ||
        getLastNonEmptyValue('.custom-thread-hex-code-os');

      if (selectedThreadHex) {
        tempProperties['_Thread Hex Code'] = selectedThreadHex;
      }
    }

    const orderedProperties = {};
    propertyOrder.forEach(propertyName => {
        if (tempProperties.hasOwnProperty(propertyName)) orderedProperties[propertyName] = tempProperties[propertyName];
    });
    Object.keys(tempProperties).forEach(propertyName => {
        if (!propertyOrder.includes(propertyName)) orderedProperties[propertyName] = tempProperties[propertyName];
    });

    formData.items[0].id = productId;
    formData.items[0].properties = orderedProperties;

    if (!productId) {
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      alert('Please select product options before adding to cart.');
      return;
    }

    if (personalizeItVariantId) {
      formData.items.push(predefinedItem);
    }

    if (cartNote) formData.note = cartNote;
      
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(async response => {
      if (!response.ok) {
        throw new Error(await response.text() || 'Add to cart failed.');
      }
      return response.json();
    })
    .then(data => { window.location.href = '/checkout'; })
    .catch((error) => {
      console.error('Error:', error);
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      alert('We could not add this item to cart. Please try again.');
    });
  }
</script>
