  // =====================================================================
  // CANVAS CODE
  // =====================================================================

  const createImageCanvas = (type) => {
      var canvas = document.querySelector('.personalize-product-canvas-os canvas');
      var ctx = canvas.getContext('2d');
  
      const pixelRatio = window.devicePixelRatio || 1;
      var canvasWidth = canvas.width;
      var canvasHeight = canvas.height;
      canvas.width = canvasWidth * pixelRatio;
      canvas.height = canvasHeight * pixelRatio;
      ctx.scale(pixelRatio, pixelRatio);
      canvas.style.width = `${canvasWidth}px`;
      canvas.style.height = `${canvasHeight}px`;
  
      var imageWidth = 450;
      var imageHeight = 450;

      const indexOnecontainer = customImagesContainers?.[3];

      let trunkImgSrc = '';
      let fabricImgSrc = '';
      let textareaText = '';
      let monogramText = '';
      let trunkEl, fabricEl, textareaEl, monogramEl;
      let textareaTextStyle, monogramTextStyle, monogramLargeTextStyle;

      if (!indexOnecontainer) {
        console.warn('No indexOnecontainer found (show-os or index 3).');
      } else {
        trunkEl    = indexOnecontainer.querySelector('.main-trunk-image-os');
        fabricEl   = indexOnecontainer.querySelector('.main-fabric-image-os');
        textareaEl = indexOnecontainer.querySelector('.textarea-text-display-os');
        monogramEl = indexOnecontainer.querySelector('.monogram-text-display-os');
        trunkImgSrc   = trunkEl?.currentSrc || trunkEl?.src || '';
        fabricImgSrc  = fabricEl?.currentSrc || fabricEl?.src || '';
        textareaText  = (textareaEl?.textContent || '').trim();
        monogramText  = (monogramEl?.textContent || '').trim();
        if (textareaEl) textareaTextStyle = getComputedStyle(textareaEl);
        if (monogramEl) {
          monogramTextStyle = getComputedStyle(monogramEl);
          const monogramLargeEl = monogramEl.querySelector('.monogram-large-text-os');
          if (monogramLargeEl) monogramLargeTextStyle = getComputedStyle(monogramLargeEl);
        }
      }
  

      // FONT EXPORT FIX ONLY:
      // Measure the visible preview image so the exported canvas text keeps
      // the same proportion as the text shown to the customer.
      const visiblePreviewContainer = Array.from(customImagesContainers || []).find((container) => {
        const rect = container.getBoundingClientRect();
        const style = window.getComputedStyle(container);

        return (
          rect.width > 0 &&
          rect.height > 0 &&
          style.display !== 'none' &&
          style.visibility !== 'hidden'
        );
      });

      const visiblePreviewTrunk =
        visiblePreviewContainer?.querySelector('.main-trunk-image-os') ||
        trunkEl;

      const previewTrunkWidth =
        visiblePreviewTrunk?.getBoundingClientRect?.().width ||
        parseFloat(
          visiblePreviewTrunk
            ? window.getComputedStyle(visiblePreviewTrunk).width
            : '0'
        ) ||
        imageWidth;

      const previewToCanvasScale = imageWidth / previewTrunkWidth;

      const scaledFontValue = (styleValue) => {
        const size = parseFloat(styleValue);
        return `${(Number.isFinite(size) ? size : 0) * previewToCanvasScale}px`;
      };

      const scaledLineHeightValue = (styleValue, fallbackFontSize) => {
        const lineHeight = parseFloat(styleValue);
        const fallback = parseFloat(fallbackFontSize);

        const value = Number.isFinite(lineHeight)
          ? lineHeight
          : Number.isFinite(fallback)
            ? fallback * 1.2
            : 0;

        return value * previewToCanvasScale;
      };

      var trunkImg = new Image();
      trunkImg.crossOrigin = 'anonymous';
      var fabricImg = new Image();
      fabricImg.crossOrigin = 'anonymous';
      var imagesLoaded = 0;
  
      const onImageLoad = () => {
          imagesLoaded++;
          if (imagesLoaded === 2) drawCanvas();
      };
  
      trunkImg.onload = onImageLoad;
      fabricImg.onload = onImageLoad;
      trunkImg.onerror = () => console.error("Trunk image failed to load due to CORS or other issues.");
      fabricImg.onerror = () => console.error("Fabric image failed to load due to CORS or other issues.");
      trunkImg.src = trunkImgSrc;
      fabricImg.src = fabricImgSrc;
  
      const drawCanvas = () => {
          ctx.fillStyle = "white";
          ctx.fillRect(0, 0, canvasWidth, canvasHeight);
          ctx.drawImage(trunkImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight);
          ctx.drawImage(fabricImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight);
      
          if (textareaText.length > 0) {
              const exportedTextareaFontSize = scaledFontValue(textareaTextStyle.fontSize);
              ctx.font = `${textareaTextStyle.fontWeight} ${exportedTextareaFontSize} ${textareaTextStyle.fontFamily}`;
              ctx.fillStyle = textareaTextStyle.color;
              const requestedLines = textareaText.split('\n');
              const lineHeight = scaledLineHeightValue(
                textareaTextStyle.lineHeight,
                textareaTextStyle.fontSize
              );
              const maxWidth = 280;

              // Character-level wrapping prevents long words/numbers without
              // spaces from overflowing the exported embroidery image.
              const wrapCanvasLine = (line) => {
                  const wrapped = [];
                  let currentLine = '';

                  Array.from(line).forEach((character) => {
                      const testLine = currentLine + character;
                      if (currentLine && ctx.measureText(testLine).width > maxWidth) {
                          wrapped.push(currentLine.trimEnd());
                          currentLine = character.trimStart();
                      } else {
                          currentLine = testLine;
                      }
                  });

                  wrapped.push(currentLine.trim());
                  return wrapped;
              };

              const lines = requestedLines.flatMap(wrapCanvasLine);
              let totalTextHeight = 0;
              for (let i = 0; i < lines.length; i++) totalTextHeight += lineHeight;
              const redBoxTop = 125;
              const redBoxHeight = 280;
              let yPosition;
              if (lines.length === 1) {
                  const textHeight = parseFloat(exportedTextareaFontSize);
                  yPosition = redBoxTop + (redBoxHeight - textHeight) / 2;
              } else {
                  yPosition = redBoxTop + (redBoxHeight - totalTextHeight) / 2;
              }
              let currentYPosition = yPosition;
              for (let i = 0; i < lines.length; i++) {
                  let line = lines[i];
                  let words = line.split(' ');
                  let lineText = '';
                  for (let j = 0; j < words.length; j++) {
                      const testLine = lineText + words[j] + ' ';
                      const testWidth = ctx.measureText(testLine).width;
                      if (testWidth > maxWidth && j > 0) {
                          ctx.fillText(lineText, (canvasWidth - ctx.measureText(lineText).width) / 2, currentYPosition);
                          lineText = words[j] + ' ';
                          currentYPosition += lineHeight;
                      } else {
                          lineText = testLine;
                      }
                  }
                  ctx.fillText(lineText, (canvasWidth - ctx.measureText(lineText).width) / 2, currentYPosition);
                  currentYPosition += lineHeight;
              }
          } else if (monogramText.length === 3) {
              ctx.fillStyle = monogramTextStyle.color;
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var firstLetterWidth = ctx.measureText(monogramText.charAt(0)).width;
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              var secondLetterWidth = ctx.measureText(monogramText.charAt(1)).width;
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var thirdLetterWidth = ctx.measureText(monogramText.charAt(2)).width;
              var totalWidth = firstLetterWidth + secondLetterWidth + thirdLetterWidth;
              var startXPosition = (canvasWidth - totalWidth) / 2;
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(0), startXPosition, 280);
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(1), startXPosition + firstLetterWidth, 287);
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(2), startXPosition + firstLetterWidth + secondLetterWidth, 280);
          }

          var base64ImageURL = canvas.toDataURL('image/png');
          var Base64URLCode = base64ImageURL.split(',')[1];
          var Base64ToShopifyURL;
          
          async function uploadImageToProduct(productId) {
            const rawPostImage = JSON.stringify({
              "base64Url": Base64URLCode,
              "productId": productId,
              "shop": "memorize-llc.myshopify.com"
            });
            
            const requestOptions = { method: "POST", body: rawPostImage, redirect: "follow" };
            const response = await fetch("https://memorize-images-upload-951530957c9e.herokuapp.com/api/imagesUpload", requestOptions);
            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
            const result = await response.json();
            const uploadedImageUrl = result?.data?.[0]?.preview?.image?.src;
            if (!uploadedImageUrl) throw new Error("Image URL not received from upload API");
            return uploadedImageUrl;
          }
          
          async function postImage() {
            try {
              Base64ToShopifyURL = await uploadImageToProduct(15532834357321);
              return Base64ToShopifyURL;
            } catch (primaryError) {
              console.error("Primary image product upload failed:", primaryError.message);
              
              try {
                Base64ToShopifyURL = await uploadImageToProduct(15644752085065);
                return Base64ToShopifyURL;
              } catch (error) {
                controlLoaderOverlay("no");
                console.error("Error:", error.message);
                return null;
              }
            }
          }
          
          async function handleImagePostAndSubmit() {
            const imageUrl = await postImage();
            if (imageUrl) {
              document.querySelector('.personalize-product-canvas-os img').src = imageUrl;
              document.querySelectorAll(
                '.properties-cstm-image, .custom-image-link-os, input[name="properties[image]"]'
              ).forEach((input) => {
                input.value = imageUrl;
              });
          
              let personalizeItVariantId;
              const personalizeItVariantIdInput = document.querySelector(".personalize-it-variant-id-os");
          
              if ((customImageUrlInput.value && type == 'desktop') || (customImageUrlInput.value && type == 'mobile')) {
                const selectedEmbroideryTypeElement = document.querySelector('[name="properties[Embroidery Type]"]:checked');
                const selectedEmbroideryType = selectedEmbroideryTypeElement ? selectedEmbroideryTypeElement.value : null;
                
                if (selectedEmbroideryType === "Words/Numbers") {
                  let textAreaSelector = type === 'desktop' ? '.printing-textarea-os' : '.mobile-wordNumber-os textarea';
                  const textAreaElement = document.querySelector(textAreaSelector);
                  if (!textAreaElement) { console.error("Textarea element not found."); return; }
                  const inputValue = textAreaElement.value.trim();
                  if (inputValue) {
                    const length = inputValue.length;
                    if (length <= 18) {
                      personalizeItVariantId = 42002574966857;
                    } else if (length > 18 && length <= 28) {
                      personalizeItVariantId = 42002574999625;
                    } else if (length > 28 && length <= 40) {
                      personalizeItVariantId = 42002575032393;
                    }
                    personalizeItVariantIdInput.value = personalizeItVariantId;
                    customformSubmission(personalizeItVariantId);
                  }
                } else {
                  personalizeItVariantId = 42002574966857;
                  personalizeItVariantIdInput.value = personalizeItVariantId;
                  customformSubmission(personalizeItVariantId);
                }
              } else if (customImageUrlInput.value && type == 'default') {
                personalizeItVariantId = "";
                personalizeItVariantIdInput.value = "";
                const shopifyForm = document.querySelector('.main-product-os .product-page--form');
                if (shopifyForm) {
                  shopifyForm.submit();
                  setTimeout(()=>{
                    toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
                    localStorage.setItem('pageRefreshed', 'true');
                    window.location.href = "/cart";
                  }, 1000);
                }
              }
            } else {
              console.error("Image upload failed. Process cannot proceed.");
              toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
              alert("Something went wrong while preparing your preview image. Please try again in a moment.");
            }
          }
          
          handleImagePostAndSubmit();
      };
  };

