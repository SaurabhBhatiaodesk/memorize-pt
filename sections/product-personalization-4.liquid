  function validateTextareaAndMonogramInputFields() {
      const desktopWordNumberTextarea = document.querySelector(".printing-textarea-os");
      const selectedTab = document.querySelector('.main-product-tabs-os .active');
  
      if (selectedTab.classList.contains('tab-3-os')) {
          alert('Please select any one Embroidery Type.\n');
          return false;
      }
      if (selectedTab.classList.contains('tab-1-os')) {
          if (desktopWordNumberTextarea.value.trim() === "") {
              alert("Enter something in the Word/Number textarea.");
              return false;
          }
      }
      if (selectedTab.classList.contains('tab-2-os')) {
          if (desktopMonogramHiddenInput.value.trim() === "") {
              alert("Enter something in the Monogram inputs.");
              return false;
          }
      }
      return true;
  }
      
