{% render 'script-shopifyPaymentTerms-add-css' %}





<!-- =========================================================
     CUSTOM MOBILE PDP ORDER - START

     Mobile only (max-width: 767px)
     Final order:
     1. PERSONALIZE IT
     2. ADD TO CART
     3. PAYMENT TERMS / SHOP PAY
     4. PRODUCT DESCRIPTION

     Important:
     - Moves EXISTING blocks only
     - Does NOT clone/rebuild Add to Cart
     - Does NOT recreate payment terms
     - Desktop restores original Shopify block positions

     Future removal/move:
     Delete or edit ONLY this block from START to END.
========================================================= -->
<script>
(function () {
  var sectionId = {{ section.id | json }};
  var mediaQuery = window.matchMedia('(max-width: 767px)');

  var buyPlaceholder = null;
  var paymentPlaceholder = null;
  var descriptionPlaceholder = null;

  function getRoot() {
    return document.querySelector(
      '.main-product-os[data-section-id="' + sectionId + '"]'
    );
  }

  function ensurePlaceholder(node, currentPlaceholder, name) {
    if (!node) return currentPlaceholder;

    if (!currentPlaceholder || !currentPlaceholder.isConnected) {
      currentPlaceholder = document.createComment(name);
      node.parentNode.insertBefore(currentPlaceholder, node);
    }

    return currentPlaceholder;
  }

  function restoreNode(node, placeholder) {
    if (
      node &&
      placeholder &&
      placeholder.parentNode &&
      placeholder.nextSibling !== node
    ) {
      placeholder.parentNode.insertBefore(node, placeholder.nextSibling);
    }
  }

  function updateMobilePdpOrder() {
    var root = getRoot();
    if (!root) return;

    var personalizeButtonWrap = root.querySelector(
      '.main-product-review-btn-os'
    );

    var buyBlock = root.querySelector(
      '.product-page--block[data-block-type="buy-buttons"]'
    );

    var paymentBlock = root.querySelector(
      '.product-page--block[data-block-type="paymentTerms"]'
    );

    var mobileDescription = root.querySelector(
      '.mobile-product-description-os'
    );

    if (!personalizeButtonWrap || !buyBlock) return;

    buyPlaceholder = ensurePlaceholder(
      buyBlock,
      buyPlaceholder,
      'mobile-buy-buttons-original-position'
    );

    paymentPlaceholder = ensurePlaceholder(
      paymentBlock,
      paymentPlaceholder,
      'mobile-payment-terms-original-position'
    );

    descriptionPlaceholder = ensurePlaceholder(
      mobileDescription,
      descriptionPlaceholder,
      'mobile-description-original-position'
    );

    if (mediaQuery.matches) {

      /* ADD TO CART below PERSONALIZE IT */
      if (personalizeButtonWrap.nextElementSibling !== buyBlock) {
        personalizeButtonWrap.insertAdjacentElement(
          'afterend',
          buyBlock
        );
      }

      /* PAYMENT TERMS below ADD TO CART */
      if (
        paymentBlock &&
        buyBlock.nextElementSibling !== paymentBlock
      ) {
        buyBlock.insertAdjacentElement(
          'afterend',
          paymentBlock
        );
      }

      /* DESCRIPTION below PAYMENT TERMS */
      if (mobileDescription) {

        if (paymentBlock) {
          if (
            paymentBlock.nextElementSibling !== mobileDescription
          ) {
            paymentBlock.insertAdjacentElement(
              'afterend',
              mobileDescription
            );
          }
        } else if (
          buyBlock.nextElementSibling !== mobileDescription
        ) {
          buyBlock.insertAdjacentElement(
            'afterend',
            mobileDescription
          );
        }

      }

    } else {

      /* Restore original desktop positions */
      restoreNode(
        buyBlock,
        buyPlaceholder
      );

      restoreNode(
        paymentBlock,
        paymentPlaceholder
      );

      restoreNode(
        mobileDescription,
        descriptionPlaceholder
      );

    }
  }

  updateMobilePdpOrder();

  if (mediaQuery.addEventListener) {
    mediaQuery.addEventListener(
      'change',
      updateMobilePdpOrder
    );
  } else if (mediaQuery.addListener) {
    mediaQuery.addListener(
      updateMobilePdpOrder
    );
  }

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      if (
        event &&
        event.target &&
        event.target.querySelector &&
        event.target.querySelector(
          '.main-product-os[data-section-id="' +
          sectionId +
          '"]'
        )
      ) {
        buyPlaceholder = null;
        paymentPlaceholder = null;
        descriptionPlaceholder = null;

        updateMobilePdpOrder();
      }

    }
  );

})();
</script>
<!-- =========================================================
     CUSTOM MOBILE PDP ORDER - END
========================================================= -->
