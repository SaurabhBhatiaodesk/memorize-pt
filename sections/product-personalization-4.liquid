  function toggleButtonState(button, isDisabled, buttonText) {
      button.disabled = isDisabled;
      button.textContent = buttonText;
  }

  function toLetterCase(fontName) {
      return fontName
          .split('-')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
  }

  function toHyphenatedCase(fontName) {
      return fontName
          .split(' ')
          .map(word => word.toLowerCase())
          .join('-');
  }

