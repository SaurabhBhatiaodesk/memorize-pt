  function validateTextareaAndMonogramInputFields() {
      const desktopWordNumberTextarea = document.querySelector(".printing-textarea-os");
      const selectedTab = document.querySelector('.main-product-tabs-os .active');

      if (selectedTab.classList.contains('tab-3-os')) {
          alert('Please select any one Embroidery Type.\n');
          return false;
      }
      if (selectedTab.classList.contains('tab-1-os')) {
          if (desktopWordNumberTextarea.value.trim() === "") {
              alert("Enter something in the Word/Number textarea.");
              return false;
          }
      }
      if (selectedTab.classList.contains('tab-2-os')) {
          if (desktopMonogramHiddenInput.value.trim() === "") {
              alert("Enter something in the Monogram inputs.");
              return false;
          }
      }
      return true;
  }

  const desktopFontsList = document.querySelectorAll('.font-btn-row-os .font-option-os');

  const handleDesktopFontSelection = (event) => {
      if (!validateTextareaAndMonogramInputFields()) return;
      const selectedFont = event.currentTarget.dataset.font;
      currentSelectedFontFamily = selectedFont;
      handleOfficialFontCode(selectedFont);
      desktopFontsList.forEach(item => item.classList.remove('active'));
      event.currentTarget.classList.add('active');
      updateTextDisplay(printingTextArea.value, getMonogramText());
      applyFontFamily(selectedFont);
      adjustFontSizeAndLineHeight(printingTextArea);
  };

  desktopFontsList.forEach(option => {
      option.addEventListener('click', handleDesktopFontSelection);
  });

  function validateFields() {
    const selectedTab = document.querySelector('.main-product-tabs-os .active');
    let isValid = true;
    let errorMessage = '';

    if (selectedTab.classList.contains('tab-1-os')) {
        const textareaValue = printingTextArea.value.trim();
        if (!textareaValue) { isValid = false; errorMessage += 'Please fill in the Words/Numbers field.\n'; }
        const selectedFont = document.querySelector('.custom-font-names-os').value;
        if (!selectedFont) { isValid = false; errorMessage += 'Please select a font.\n'; }
        const colorSelected = document.querySelector('.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked');
        if (!colorSelected) { isValid = false; errorMessage += 'Please select a thread color.\n'; }
    } else if (selectedTab.classList.contains('tab-2-os')) {
        const monogramValues = Array.from(monogramInputs).map(input => input.value.trim());
        if (monogramValues.some(value => value.length === 0)) { isValid = false; errorMessage += 'Please fill in all three Monogram fields.\n'; }
        if (monogramValues.join('').length !== 3) { isValid = false; errorMessage += 'Monogram must consist of exactly 3 characters.\n'; }
        const selectedMonogramFont = document.querySelector('.custom-font-names-os').value;
        if (!selectedMonogramFont) { isValid = false; errorMessage += 'Please select a font for the monogram.\n'; }
        const colorSelected = document.querySelector('.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked');
        if (!colorSelected) { isValid = false; errorMessage += 'Please select a thread color.\n'; }
    } else if (selectedTab.classList.contains('tab-3-os')) {
        isValid = false;
        errorMessage += 'Please select any one Embroidery Type.\n';
    }
    return { isValid, errorMessage };
  }

  const controlLoaderOverlay = (data) => {
    const overlay = document.querySelector('.loading-overlay-content-os');
    if (data === "yes") {
        overlay.classList.add('active');
    } else {
        overlay.classList.remove('active');
    }
  };

  // ============================================================
  // CANVAS
  // ============================================================

  const createImageCanvas = (type) => {
      const canvas = document.querySelector('.personalize-product-canvas-os canvas');
      if (!canvas) {
        console.error('Personalization canvas not found.');
        controlLoaderOverlay('no');
        return;
      }

      const ctx = canvas.getContext('2d');
      if (!ctx) {
        console.error('Canvas 2D context is not available.');
        controlLoaderOverlay('no');
        return;
      }

      const pixelRatio = window.devicePixelRatio || 1;

      // Keep the original logical canvas size. Reading canvas.width after an earlier
      // render can multiply the dimensions again on every subsequent click.
      const canvasWidth = Number(canvas.dataset.logicalWidth) || canvas.clientWidth || canvas.width || 600;
      const canvasHeight = Number(canvas.dataset.logicalHeight) || canvas.clientHeight || canvas.height || 600;
      canvas.dataset.logicalWidth = canvasWidth;
      canvas.dataset.logicalHeight = canvasHeight;
      canvas.width = Math.round(canvasWidth * pixelRatio);
      canvas.height = Math.round(canvasHeight * pixelRatio);
      canvas.style.width = `${canvasWidth}px`;
      canvas.style.height = `${canvasHeight}px`;
      ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);

      var imageWidth = 450;
      var imageHeight = 450;

      // Do not depend on a fixed NodeList index. Product 15532834357321 can
      // render a different number/order of preview containers.
      const canvasContainers = Array.from(customImagesContainers || []);
      const hasRequiredImages = (container) => {
        if (!container) return false;
        const trunk = container.querySelector('.main-trunk-image-os');
        const fabric = container.querySelector('.main-fabric-image-os');
        const trunkSrc = trunk?.currentSrc || trunk?.src || '';
        const fabricSrc = fabric?.currentSrc || fabric?.src || '';
        return Boolean(trunk && fabric && trunkSrc && fabricSrc);
      };

      // Fixed: "offsetParent !== null" only proves an element isn't
      // display:none — a Swiper slide that Swiper has pushed thousands of
      // pixels off-screen (e.g. an inactive slide) still passes that check.
      // Confirmed live: container index 0 (a swiper-slide) sat at x=14065,
      // while the actual on-screen personalizer popup was a different
      // container entirely (`.personalize-product-popup-col-1-os`, x=212).
      // Picking the off-screen one made the exported text size/scale not
      // match what the customer visually saw in the popup — reported as
      // "it looks bigger in the personalizer vs. the product image".
      const isTrulyOnScreen = (container) => {
        const rect = container.getBoundingClientRect();
        const style = window.getComputedStyle(container);
        return (
          style.display !== 'none' &&
          style.visibility !== 'hidden' &&
          rect.width > 0 &&
          rect.height > 0 &&
          rect.left < window.innerWidth &&
          rect.right > 0 &&
          rect.top < window.innerHeight &&
          rect.bottom > 0
        );
      };

      const indexOnecontainer =
        canvasContainers.find(container => hasRequiredImages(container) && isTrulyOnScreen(container)) ||
        canvasContainers.find(container => hasRequiredImages(container) && container.offsetParent !== null) ||
        canvasContainers.find(container => hasRequiredImages(container) && container.classList.contains(showClass)) ||
        canvasContainers.find(hasRequiredImages) ||
        null;
      let trunkImgSrc = '';
      let fabricImgSrc = '';
      let textareaText = '';
      let monogramText = '';
      let trunkEl, fabricEl, textareaEl, monogramEl;
      let textareaTextStyle, monogramTextStyle, monogramLargeTextStyle;

      if (!indexOnecontainer) {
        console.error('No usable personalization preview container was found.');
        controlLoaderOverlay('no');
        return;
      } else {
        trunkEl    = indexOnecontainer.querySelector('.main-trunk-image-os');
        fabricEl   = indexOnecontainer.querySelector('.main-fabric-image-os');
        textareaEl = indexOnecontainer.querySelector('.textarea-text-display-os');
        monogramEl = indexOnecontainer.querySelector('.monogram-text-display-os');
        trunkImgSrc   = trunkEl?.currentSrc || trunkEl?.src || '';
        fabricImgSrc  = fabricEl?.currentSrc || fabricEl?.src || '';
        textareaText  = (textareaEl?.textContent || '').trim();
        monogramText  = (monogramEl?.textContent || '').trim();
        if (textareaEl) textareaTextStyle = getComputedStyle(textareaEl);
        if (monogramEl) {
          monogramTextStyle = getComputedStyle(monogramEl);
          const monogramLargeEl = monogramEl.querySelector('.monogram-large-text-os');
          if (monogramLargeEl) monogramLargeTextStyle = getComputedStyle(monogramLargeEl);
        }
      }

      console.log('indexOnecontainer ::', indexOnecontainer);
      console.log('values ::', { trunkImgSrc, fabricImgSrc, textareaText, monogramText });
      console.log('textareaTextStyle ::', textareaTextStyle);
      console.log('monogramTextStyle ::', monogramTextStyle);
      console.log('monogramLargeTextStyle ::', monogramLargeTextStyle);

      // Same on-screen check as indexOnecontainer above, reused here so the
      // scale factor is always computed from the SAME container the text
      // values were read from.
      const visiblePreviewContainer =
        (indexOnecontainer && isTrulyOnScreen(indexOnecontainer) && indexOnecontainer) ||
        Array.from(customImagesContainers || []).find(isTrulyOnScreen);

      const visiblePreviewTrunk =
        visiblePreviewContainer?.querySelector('.main-trunk-image-os') ||
        trunkEl;

      const previewTrunkRectWidth =
        visiblePreviewTrunk?.getBoundingClientRect?.().width || 0;

      const previewTrunkCssWidth = visiblePreviewTrunk
        ? parseFloat(window.getComputedStyle(visiblePreviewTrunk).width) || 0
        : 0;

      const previewTrunkWidth =
        previewTrunkRectWidth ||
        previewTrunkCssWidth ||
        imageWidth;

      const previewToCanvasScale =
        imageWidth / previewTrunkWidth;

      const scaledFontValue = (styleValue) => {
        const size = parseFloat(styleValue);
        return `${(Number.isFinite(size) ? size : 0) * previewToCanvasScale}px`;
      };

      const scaledLineHeightValue = (styleValue, fallbackFontSize) => {
        const lineHeight = parseFloat(styleValue);
        const fallback = parseFloat(fallbackFontSize);
        const value = Number.isFinite(lineHeight)
          ? lineHeight
          : (Number.isFinite(fallback) ? fallback * 1.2 : 0);
        return value * previewToCanvasScale;
      };

      if (!trunkImgSrc || !fabricImgSrc) {
        console.error('Trunk or fabric image source is empty.', { trunkImgSrc, fabricImgSrc });
        controlLoaderOverlay('no');
        return;
      }

      var trunkImg = new Image();
      trunkImg.crossOrigin = 'anonymous';
      var fabricImg = new Image();
      fabricImg.crossOrigin = 'anonymous';
      var imagesLoaded = 0;

      const onImageLoad = () => {
          imagesLoaded++;
          if (imagesLoaded === 2) drawCanvas();
      };

      trunkImg.onload = onImageLoad;
      fabricImg.onload = onImageLoad;
      trunkImg.onerror = (error) => {
        console.error('Trunk image failed to load due to CORS or another issue.', trunkImgSrc, error);
        controlLoaderOverlay('no');
      };
      fabricImg.onerror = (error) => {
        console.error('Fabric image failed to load due to CORS or another issue.', fabricImgSrc, error);
        controlLoaderOverlay('no');
      };
      trunkImg.src = trunkImgSrc;
      fabricImg.src = fabricImgSrc;

      const drawCanvas = async () => {
          ctx.fillStyle = "white";
          ctx.fillRect(0, 0, canvasWidth, canvasHeight);
          ctx.drawImage(trunkImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight);
          ctx.drawImage(fabricImg, (canvasWidth - imageWidth) / 2, 100, imageWidth, imageHeight);

          // Fixed: canvas text rendering does NOT wait for a custom
          // @font-face to finish downloading/parsing — if the selected
          // script/cursive font (e.g. "signature", "flourish") wasn't fully
          // loaded yet at export time, the browser silently fell back to a
          // default font (or drew with incomplete glyph metrics), producing
          // garbled, overlapping text. document.fonts.load() explicitly
          // requests the exact font strings we're about to use, and
          // document.fonts.ready waits for any pending font loads to finish
          // before a single character is drawn.
          try {
            const fontsToLoad = [];
            if (textareaText.length > 0 && textareaTextStyle) {
              fontsToLoad.push(`${textareaTextStyle.fontWeight} ${scaledFontValue(textareaTextStyle.fontSize)} ${textareaTextStyle.fontFamily}`);
            }
            if (monogramText.length === 3 && monogramTextStyle) {
              fontsToLoad.push(`${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`);
              if (monogramLargeTextStyle) {
                fontsToLoad.push(`${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`);
              }
            }
            await Promise.all(fontsToLoad.map((fontString) => document.fonts.load(fontString)));
            await document.fonts.ready;
          } catch (fontLoadError) {
            console.warn('Font preload for canvas export failed; continuing with best-effort rendering.', fontLoadError);
          }

          if (textareaText.length > 0) {
              ctx.font = `${textareaTextStyle.fontWeight} ${scaledFontValue(textareaTextStyle.fontSize)} ${textareaTextStyle.fontFamily}`;
              ctx.fillStyle = textareaTextStyle.color;
              const lines = textareaText.split('\n');
              const lineHeight = scaledLineHeightValue(textareaTextStyle.lineHeight, textareaTextStyle.fontSize);
              const maxWidth = 250;
              const redBoxTop = 125;
              const redBoxHeight = 280;

              // Fixed: fillText's y argument is the BASELINE, not the top of
              // the text block. The old code computed a "content-top" style
              // offset and used it directly as the baseline, so every line
              // rendered noticeably higher than the visually-centered spot
              // (confirmed by comparing against the live preview's actual
              // on-screen text position, which sits ~35% down the trunk
              // image, vs. the exported image which measured ~5.6% down —
              // this was the confirmed cause of the "too high" complaint).
              // Real font metrics (ascent/descent) now place the baseline so
              // the visible glyph box is centered in the box, not its top.
              const scaledFontPx = parseFloat(scaledFontValue(textareaTextStyle.fontSize));

              // Fixed: word-wrap can turn ONE logical line (no \n typed)
              // into TWO OR MORE rendered lines once it hits maxWidth — but
              // the height/centering math below was computed BEFORE
              // wrapping happened, using lines.length (always 1 for
              // un-wrapped input). That under-counted the real block height
              // whenever text wrapped, cramming the wrapped lines into the
              // space meant for one line and making the exported text look
              // smaller/tighter than the live preview (which lets the
              // browser wrap and center normally). Wrap FIRST, then measure
              // and center using the real line count.
              const wrappedLines = [];
              lines.forEach((line) => {
                  const words = line.split(' ');
                  let lineText = '';
                  words.forEach((word, wordIndex) => {
                      const testLine = lineText + word + ' ';
                      const testWidth = ctx.measureText(testLine).width;
                      if (testWidth > maxWidth && wordIndex > 0) {
                          wrappedLines.push(lineText.trim());
                          lineText = word + ' ';
                      } else {
                          lineText = testLine;
                      }
                  });
                  wrappedLines.push(lineText.trim());
              });

              const sampleMetrics = ctx.measureText(wrappedLines[0] || 'M');
              const lineAscent = sampleMetrics.actualBoundingBoxAscent || scaledFontPx * 0.75;
              const lineDescent = sampleMetrics.actualBoundingBoxDescent || scaledFontPx * 0.25;
              const totalTextHeight = (wrappedLines.length - 1) * lineHeight + lineAscent + lineDescent;
              const blockTop = redBoxTop + (redBoxHeight - totalTextHeight) / 2;
              let currentYPosition = blockTop + lineAscent;
              wrappedLines.forEach((lineText) => {
                  ctx.fillText(lineText, (canvasWidth - ctx.measureText(lineText).width) / 2, currentYPosition);
                  currentYPosition += lineHeight;
              });
          } else if (monogramText.length === 3) {
              const redBoxTop = 125;
              const redBoxHeight = 280;

              ctx.fillStyle = monogramTextStyle.color;
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var firstLetterWidth = ctx.measureText(monogramText.charAt(0)).width;
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              var secondLetterWidth = ctx.measureText(monogramText.charAt(1)).width;
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              var thirdLetterWidth = ctx.measureText(monogramText.charAt(2)).width;
              var totalWidth = firstLetterWidth + secondLetterWidth + thirdLetterWidth;
              var startXPosition = (canvasWidth - totalWidth) / 2;

              // Fixed: same baseline-vs-content-top bug as the textarea path
              // above, confirmed via live-preview measurement — using real
              // ascent/descent metrics instead of raw font-size so the
              // visible glyph (not an approximate box) centers in the box.
              // Letters are aligned by their shared bottom edge so all three
              // sit on one visual "line", same as the large middle letter
              // originally sat 7px below the outer two (280 vs 287).
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              const normalMetrics = ctx.measureText(monogramText.charAt(0) || 'M');
              const normalFontPx = parseFloat(scaledFontValue(monogramTextStyle.fontSize));
              const normalAscent = normalMetrics.actualBoundingBoxAscent || normalFontPx * 0.75;
              const normalDescent = normalMetrics.actualBoundingBoxDescent || normalFontPx * 0.25;

              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              const largeMetrics = ctx.measureText(monogramText.charAt(1) || 'M');
              const largeFontPx = parseFloat(scaledFontValue(monogramLargeTextStyle.fontSize));
              const largeAscent = largeMetrics.actualBoundingBoxAscent || largeFontPx * 0.75;
              const largeDescent = largeMetrics.actualBoundingBoxDescent || largeFontPx * 0.25;

              const largeBlockHeight = largeAscent + largeDescent;
              const monogramLargeBaselineY = redBoxTop + (redBoxHeight - largeBlockHeight) / 2 + largeAscent;
              const monogramBaselineY = monogramLargeBaselineY + largeDescent - normalDescent;

              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(0), startXPosition, monogramBaselineY);
              ctx.font = `${monogramLargeTextStyle.fontWeight} ${scaledFontValue(monogramLargeTextStyle.fontSize)} ${monogramLargeTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(1), startXPosition + firstLetterWidth, monogramLargeBaselineY);
              ctx.font = `${monogramTextStyle.fontWeight} ${scaledFontValue(monogramTextStyle.fontSize)} ${monogramTextStyle.fontFamily}`;
              ctx.fillText(monogramText.charAt(2), startXPosition + firstLetterWidth + secondLetterWidth, monogramBaselineY);
          }

          let base64ImageURL;
          try {
            base64ImageURL = canvas.toDataURL('image/png');
          } catch (error) {
            console.error('Canvas export failed. Check image CORS settings.', error);
            controlLoaderOverlay('no');
            return;
          }
          var Base64URLCode = base64ImageURL.split(',')[1];
          var Base64ToShopifyURL;

          const primaryImageProductId = 15532834357321;
          const secondaryImageProductId = 15644752085065;

          async function uploadImageToProduct(productId) {
            const rawPostImage = JSON.stringify({
              "base64Url": Base64URLCode,
              "productId": productId,
              "shop": "memorize-llc.myshopify.com"
            });
            const requestOptions = { method: "POST", body: rawPostImage, redirect: "follow" };
            const response = await fetch("https://memorize-images-upload-951530957c9e.herokuapp.com/api/imagesUpload", requestOptions);
            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
            const result = await response.json();
            const imageUrl = result?.data?.[0]?.preview?.image?.src;
            if (!imageUrl) throw new Error("Image URL not returned.");
            return imageUrl;
          }

          async function postImage() {
            try {
              Base64ToShopifyURL = await uploadImageToProduct(primaryImageProductId);
              return Base64ToShopifyURL;
            } catch (primaryError) {
              console.warn("Primary image product upload failed. Trying secondary product:", primaryError.message);
            }

            try {
              Base64ToShopifyURL = await uploadImageToProduct(secondaryImageProductId);
              return Base64ToShopifyURL;
            } catch (secondaryError) {
              controlLoaderOverlay("no");
              console.error("Error:", secondaryError.message);
              return null;
            }
          }

          async function handleImagePostAndSubmit() {
            const imageUrl = await postImage();
            if (imageUrl) {
              document.querySelector('.personalize-product-canvas-os img').src = imageUrl;
              document.querySelectorAll(
                '.properties-cstm-image, .custom-image-link-os, input[name="properties[image]"]'
              ).forEach((input) => {
                input.value = imageUrl;
              });
              let personalizeItVariantId;
              const personalizeItVariantIdInput = document.querySelector(".personalize-it-variant-id-os");
              if ((customImageUrlInput.value && type == 'desktop') || (customImageUrlInput.value && type == 'mobile')) {
                const selectedEmbroideryTypeElement = document.querySelector('[name="properties[Embroidery Type]"]:checked');
                const selectedEmbroideryType = selectedEmbroideryTypeElement ? selectedEmbroideryTypeElement.value : null;
                if (selectedEmbroideryType === "Words/Numbers") {
                  let textAreaSelector = type === 'desktop' ? '.printing-textarea-os' : '.mobile-wordNumber-os textarea';
                  const textAreaElement = document.querySelector(textAreaSelector);
                  if (!textAreaElement) { console.error("Textarea element not found."); return; }
                  const inputValue = textAreaElement.value.trim();
                  if (inputValue) {
                    const length = inputValue.length;
                    if (length <= 18) { personalizeItVariantId = 42002574966857; }
                    else if (length > 18 && length <= 28) { personalizeItVariantId = 42002574999625; }
                    else if (length > 28 && length <= 40) { personalizeItVariantId = 42002575032393; }
                    personalizeItVariantIdInput.value = personalizeItVariantId;
                    customformSubmission(personalizeItVariantId);
                  }
                } else {
                  personalizeItVariantId = 42002574966857;
                  personalizeItVariantIdInput.value = personalizeItVariantId;
                  customformSubmission(personalizeItVariantId);
                }
              } else if (customImageUrlInput.value && type == 'default') {
                personalizeItVariantId = "";
                personalizeItVariantIdInput.value = "";
                const shopifyForm = document.querySelector('.main-product-os .product-page--form');
                if (shopifyForm) {
                  shopifyForm.submit();
                  setTimeout(() => {
                    toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
                    localStorage.setItem('pageRefreshed', 'true');
                    window.location.href = "/cart";
                  }, 1000);
                } else {
                  console.error("shopifyForm not found.");
                }
              }
            } else {
              // Fixed: on upload failure this previously only logged to the
              // console. The Add to Cart button stayed stuck on "Adding To
              // Cart" forever with no customer-facing message, and nothing
              // was ever added to cart — reported as "a customer last night
              // who couldn't add to cart". restorePersonalizationButtons()
              // already existed to reset the buttons/fields but was never
              // called anywhere in the file.
              console.error("Image upload failed. Process cannot proceed.");
              restorePersonalizationButtons();
              alert("Something went wrong while preparing your preview image. Please try again in a moment.");
            }
          }
          handleImagePostAndSubmit();
      };
  };

  // ============================================================
  // COLOR SWATCHES
  // ============================================================

  const threadColorSwatchesContainer = document.querySelector('.desktop-custom-thread-color-list-os');

  function createThreadColorOptions(fabric) {
      const tooltipContents = document.querySelectorAll(".thread-color-tooltip-os .tooltip-thread-color-swatch-os");

      if ($(threadColorSwatchesContainer).hasClass('slick-initialized')) {
          $(threadColorSwatchesContainer).slick('unslick');
      }

      threadColorSwatchesContainer.innerHTML = "";
      const tooltipColorNames = document.querySelectorAll('.thread-color-tooltip-os .tooltip-color-name-os');
      tooltipColorNames.forEach(name => name.innerHTML = "");
      tooltipContents.forEach(tooltipContent => { tooltipContent.innerHTML = ""; });

      if (recommendedFabricsWithThreadColorOptions[fabric]) {
          recommendedFabricsWithThreadColorOptions[fabric].forEach(color => {
              tooltipContents.forEach(tooltipContent => {
                  const swatchRow = document.createElement("div");
                  swatchRow.className = "tooltip-thread-color-swatch-row-os";
                  const tooltipSwatch = document.createElement("div");
                  tooltipSwatch.className = "tooltip-swatch";
                  tooltipSwatch.style.backgroundColor = threadColors[color] || "#fff";
                  const tooltipColorName = document.createElement("div");
                  tooltipColorName.className = "tooltip-color-name-os";
                  tooltipColorName.textContent = color;
                  swatchRow.appendChild(tooltipSwatch);
                  swatchRow.appendChild(tooltipColorName);
                  tooltipContent.appendChild(swatchRow);
              });
          });
      }

      if (fabricsWithAllThreadColorOptions[fabric]) {
          const recommended = recommendedFabricsWithThreadColorOptions[fabric] || [];
          const allColors = fabricsWithAllThreadColorOptions[fabric] || [];
          const orderedColors = [...recommended];

          orderedColors.forEach(color => {
              const container = document.createElement("div");
              container.className = "swatch-container-os";
              const input = document.createElement("input");
              input.type = "radio";
              input.id = `color-${color}-os`;
              input.name = "properties[Thread Color]";
              input.value = color;
              input.classList.add("color-radio-os");
              input.setAttribute("data-color", threadColors[color]);
              input.tabIndex = 0;
              const label = document.createElement("label");
              label.setAttribute("for", `color-${color}-os`);
              const swatch = document.createElement("div");
              swatch.className = "color-swatch-os";
              swatch.style.backgroundColor = threadColors[color] || "#fff";
              const colorName = document.createElement("div");
              colorName.className = "color-name-os";
              colorName.style.display = "none";
              colorName.textContent = color;
              label.appendChild(swatch);
              label.appendChild(colorName);
              container.appendChild(input);
              container.appendChild(label);
              threadColorSwatchesContainer.appendChild(container);
          });

          const remainingColors = allColors.filter(color => !recommended.includes(color));
          remainingColors.forEach(color => {
              const container = document.createElement("div");
              container.className = "swatch-container-os";
              const input = document.createElement("input");
              input.type = "radio";
              input.id = `color-${color}-os`;
              input.name = "properties[Thread Color]";
              input.value = color;
              input.classList.add("color-radio-os");
              input.setAttribute("data-color", threadColors[color]);
              input.tabIndex = 0;
              const label = document.createElement("label");
              label.setAttribute("for", `color-${color}-os`);
              const swatch = document.createElement("div");
              swatch.className = "color-swatch-os";
              swatch.style.backgroundColor = threadColors[color] || "#fff";
              const colorName = document.createElement("div");
              colorName.className = "color-name-os";
              colorName.style.display = "none";
              colorName.textContent = color;
              label.appendChild(swatch);
              label.appendChild(colorName);
              container.appendChild(input);
              container.appendChild(label);
              threadColorSwatchesContainer.appendChild(container);
          });
      }

      if (threadColorSwatchesContainer) {
          $(threadColorSwatchesContainer).slick({
              rows: 2,
              slidesToShow: 8,
              slidesToScroll: 8,
              dots: false,
              arrows: true,
              infinite: false,
              speed: 300,
              responsive: [
                { breakpoint: 1028, settings: { slidesToShow: 6, slidesToScroll: 6 } },
                { breakpoint: 767, settings: { slidesToShow: 8, slidesToScroll: 8 } }
              ]
          });
      }

      selectThreadColor(fabric);
  }

  function selectThreadColor(fabric) {
      const colorName = defaultThreadColors[fabric];
      handleThreadColorCode(colorName);
