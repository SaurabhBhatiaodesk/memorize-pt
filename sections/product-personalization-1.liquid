<script>
setTimeout(function() {
    const productRoot = document.querySelector('.main-product-os[data-product-id^="{{ product.id }}-"]');
    const defaultMediumOption = productRoot?.querySelector('[id$="-size-medium"]');
    if (defaultMediumOption) {
      $(defaultMediumOption).trigger('change');
    }
}, 1000);
$(document).on('change','.radios--input', function (){
    var url_string = location.href;
    var url = new URL(url_string);
    var variant = url.searchParams.get("variant");
    $('.properties-cstm-id').val(variant);
});

$(document).on("click", ".sdev_radios_btn", function () {
    var selectedSize = $(this).attr("value").trim();

    if (selectedSize !== "Medium" && selectedSize !== "Large") return;

    $('.main-product-variant-images-col-os').removeAttr('data-sold-out');

    $('.product-buy-buttons--select option').each(function () {
        var optionText = $(this).text().trim();
        var quantity   = Number($(this).data('quantity'));

        if (!optionText.includes("/")) return;

        let parts = optionText.split('/');
        let size  = $.trim(parts[0]);
        let color = $.trim(parts[1]);

        if (size === selectedSize && quantity === 0) {
            $('.main-product-variant-images-col-os input[value="'+color+'"]')
                .closest('.main-product-variant-images-col-os')
                .attr('data-sold-out', 'true');
        }
    });
});
</script>


