  // ============================================================

  function fabricImage(imageUrl, divElement) {
      customImagesContainers.forEach(container => {
          container.querySelector('.main-fabric-image-os').src = imageUrl;
          if (container.classList.contains(hideClass)) {
            container.classList.remove(hideClass);
            container.classList.add(showClass);
          }
      });

      const fabricDivs = document.querySelectorAll('.main-product-fabric-images-row-os .main-product-variant-images-col-os');
      fabricDivs.forEach(div => div.classList.remove('active'));
      divElement.classList.add('active');

      const radioInput = divElement.querySelector('input[type="radio"]');
      if (radioInput) {
          let activeFabricVariantName = document.querySelector('.active-fabric-variant-name-os');
          radioInput.checked = true;
          activeFabricVariantName.innerHTML = `(${radioInput.value})`;
          document.querySelector('.properties-cstm-fabrics-color').value = radioInput.value;
          console.log("fabricImage radioInput.value ::", radioInput.value);

          createThreadColorOptions(radioInput.value);
          mobileCreateThreadColorOptions(radioInput.value);
      }

      thumbnailContainer.forEach((item) => {
          if (item.classList.contains(showClass)) {
              item.classList.remove(showClass);
              item.classList.add(hideClass);
          }
      });
      mobileThumbnailContainer.forEach((item) => {
          if (item.classList.contains(showClass)) {
              item.classList.remove(showClass);
              item.classList.add(hideClass);
          }
      });

      const trunkRadioSelected = document.querySelectorAll('input[name="properties[Exterior Trunk Color]"][type="radio"]:checked');

      if (trunkRadioSelected.length === 0) {
          const firstTrunkDiv = document.querySelector('.main-product-variant-images-row-os > div');
          if (firstTrunkDiv) {
              const firstTrunkRadio = firstTrunkDiv.querySelector('input[type="radio"]');
              if (firstTrunkRadio) {
                  const firstTrunkImageUrl = firstTrunkDiv.querySelector('img').src;
                  const firstTrunkLabel = firstTrunkDiv.querySelector('span').textContent;
                  selectFirstTrunkImage(firstTrunkImageUrl, firstTrunkDiv, firstTrunkLabel);
              }
          }
      }

      swiper.slideTo(swiper.slides.length - 1);
      swiper2.slideTo(swiper2.slides.length - 1);
  }

  function selectFirstTrunkImage(imageUrl, divElement, label) {
    customImagesContainers.forEach(container => {
        container.querySelector('.main-trunk-image-os').src = imageUrl;
        if (container.classList.contains(hideClass)) {
            container.classList.remove(hideClass);
            container.classList.add(showClass);
        }
    });

    const trunkDivs = document.querySelectorAll('.main-product-variant-images-row-os > div');
    trunkDivs.forEach(div => div.classList.remove('active'));
    divElement.classList.add('active');

    const radioInput = divElement.querySelector('input[type="radio"]');
    if (radioInput) {
        let activeTrunkVariantName = document.querySelector('.active-trunk-variant-name-os');
        radioInput.checked = true;
        const swatchButtonClass = '.radios--swatch-button-' + radioInput.value.replace(/\s+/g, '-');
        const swatchButton = document.querySelector(swatchButtonClass);
        if (swatchButton) {
            swatchButton.click();
        } else {
            console.error('Swatch button not found for value:', radioInput.value);
        }
        activeTrunkVariantName.innerHTML = `(${radioInput.value})`;
        document.querySelector('.properties-cstm-trunks-color').value = radioInput.value;
    } else {
        console.error('Radio input not found in divElement:', divElement);
    }

    thumbnailContainer.forEach((item) => {
        if (item.classList.contains(showClass)) {
            item.classList.remove(showClass);
            item.classList.add(hideClass);
        }
    });
    mobileThumbnailContainer.forEach((item) => {
        if (item.classList.contains(showClass)) {
            item.classList.remove(showClass);
            item.classList.add(hideClass);
        }
    });
  }

