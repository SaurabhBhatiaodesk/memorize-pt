  function mobileupdateTextareaDisplay(textFromTextarea = '', monogramText = []) {
    mobileCustomImagesContainers.forEach(container => {
        const textareaDisplay = container.querySelector('.textarea-text-display-os');
        if (textFromTextarea) {
            textareaDisplay.textContent = textFromTextarea;
        } else {
            textareaDisplay.textContent = '';
        }
    });
