      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] }),
    })
    .then(res => {
      if (!res.ok) throw new Error('Network response was not ok');
      return res.json();
    })
    .then(data => {
      console.log("Add to cart successful!");
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      window.location.href = '/cart';
    })
    .catch(error => {
      console.error('Add to cart error:', error);
      alert(error);
      toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
    });
  }

  // ============================================================
  // FORM SUBMISSION
  // ============================================================

  function getSelectedProductVariantId() {
    const productForm = document.querySelector('.main-product-os .product-page--form');
    const variantSelect = productForm?.querySelector('.product-buy-buttons--select') ||
                          document.querySelector('.product-buy-buttons--select');
    const variantInput = productForm?.querySelector('[name="id"]') ||
                         document.querySelector('.main-product-os [name="id"]');

    return String(variantSelect?.value || variantInput?.value || '').trim();
  }

  function getPropertyValue(propertyName) {
    const selector = `[name="properties[${propertyName}]"]`;
    const fields = Array.from(document.querySelectorAll(selector));
    if (!fields.length) return '';

    const checkedField = fields.find(field =>
      (field.type === 'radio' || field.type === 'checkbox') && field.checked
    );
    if (checkedField) return String(checkedField.value || '').trim();

    const visibleField = fields.find(field => {
      if (field.disabled) return false;
      const value = String(field.value || '').trim();
      if (!value) return false;
      return field.offsetParent !== null;
    });
    if (visibleField) return String(visibleField.value || '').trim();

    const populatedField = fields.find(field => String(field.value || '').trim() !== '');
    return populatedField ? String(populatedField.value || '').trim() : '';
  }

  function restorePersonalizationButtons() {
    controlLoaderOverlay('no');

    if (addToCartButton) {
      addToCartButton.disabled = false;
      updatePriceAccordingToLetters(
        document.querySelector('.main-product-tabs-os .active')?.classList.contains('tab-1-os')
          ? (printingTextArea?.value || '').trim().length <= 18 ? 25
            : (printingTextArea?.value || '').trim().length <= 28 ? 35 : 40
          : 25
      );
    }

    if (mobileAddToCartButton) mobileAddToCartButton.disabled = false;
    if (MainAddToCartButton) toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
  }

  async function customformSubmission(personalizeItVariantId) {
    let formData = { 'items': [{ 'id': null, 'quantity': 1, 'properties': {} }] };
    const predefinedItem = { 'id': personalizeItVariantId, 'quantity': 1, 'properties': {} };
    let cartNote = '';
    const propertyOrder = [
        'Exterior Trunk Color', 'Fabric', 'Embroidery Type', 'WordsNumbers',
        'Monogram', 'Font', 'Thread Color', 'image', 'personalize_it_variant_id',
        '_Font Name', '_Thread Hex Code'
    ];
    const tempProperties = {};
    let productId = '';
    $('form#mobile-desktop-product').serializeArray().forEach(item => {
      if (item.name === 'id') { if (item.value.trim() !== "") productId = item.value; }
      else if (item.name.startsWith('properties[')) {
          const propertyName = item.name.substring(11, item.name.length - 1);
          if (item.value.trim() !== "") tempProperties[propertyName] = item.value;
      }
      if (item.name === 'note' && item.value.trim() !== '') cartNote = item.value.trim();
    });

    // Keep the generated preview URL and the latest selected thread colour
    // together on the same cart line item.
    const getLastNonEmptyValue = (selector) => {
      const values = Array.from(document.querySelectorAll(selector))
        .map((element) => String(element.value || '').trim())
        .filter(Boolean);

      return values.length ? values[values.length - 1] : '';
    };

    const generatedPreviewUrl = getLastNonEmptyValue(
      '.properties-cstm-image, .custom-image-link-os, input[name="properties[image]"]'
    );

    if (generatedPreviewUrl) {
      tempProperties.image = generatedPreviewUrl;
    } else {
      delete tempProperties.image;
    }

    const checkedDesktopThreadInputs = Array.from(
      document.querySelectorAll(
        '.desktop-custom-thread-color-list-os input[name="properties[Thread Color]"]:checked'
      )
    );

    const activeDesktopThreadInputs = checkedDesktopThreadInputs.filter(
      (input) => input.closest('.swatch-container-os.active')
    );

    const desktopThreadInput =
      activeDesktopThreadInputs[activeDesktopThreadInputs.length - 1] ||
      checkedDesktopThreadInputs[checkedDesktopThreadInputs.length - 1] ||
      null;

    const desktopThreadColor = String(desktopThreadInput?.value || '').trim();
    const mobileThreadColor = getLastNonEmptyValue(
      '.mobile-personalize-fields-col-os .selectedColor, .selectedColor'
    );

    const isMobilePersonaliser =
      window.matchMedia &&
      window.matchMedia('(max-width: 767px)').matches;

    const finalThreadColor = isMobilePersonaliser
      ? (mobileThreadColor || desktopThreadColor)
      : (desktopThreadColor || mobileThreadColor);

    if (finalThreadColor) {
      tempProperties['Thread Color'] = finalThreadColor;

      const matchingThreadInput = Array.from(
        document.querySelectorAll('input[name="properties[Thread Color]"]')
      ).find((input) => String(input.value || '').trim() === finalThreadColor);

      const selectedThreadHex =
        matchingThreadInput?.getAttribute('data-color') ||
        getLastNonEmptyValue('.custom-thread-hex-code-os');

      if (selectedThreadHex) {
        tempProperties['_Thread Hex Code'] = selectedThreadHex;
      }
    }

    const orderedProperties = {};
    propertyOrder.forEach(propertyName => {
        if (tempProperties.hasOwnProperty(propertyName)) orderedProperties[propertyName] = tempProperties[propertyName];
    });
    Object.keys(tempProperties).forEach(propertyName => {
        if (!propertyOrder.includes(propertyName)) orderedProperties[propertyName] = tempProperties[propertyName];
    });
    formData.items[0].id = productId;
    formData.items[0].properties = orderedProperties;

    if (!productId) {
      if (MainAddToCartButton) toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      alert('Please select product options before adding to cart.');
      return;
    }

    if (personalizeItVariantId) {
      formData.items.push(predefinedItem);
    }

    if (cartNote) formData.note = cartNote;
    console.log("customformSubmission formData ::", formData);
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    })
    .then(async response => {
      if (!response.ok) {
        throw new Error(await response.text() || 'Add to cart failed.');
      }
      return response.json();
    })
    .then(data => { window.location.href = '/checkout'; })
    .catch((error) => {
      console.error('Error:', error);
      if (MainAddToCartButton) toggleButtonState(MainAddToCartButton, false, 'ADD TO CART');
      alert('We could not add this item to cart. Please try again.');
    });
  }</script>

