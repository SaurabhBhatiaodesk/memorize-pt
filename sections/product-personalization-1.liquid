  function updateTextDisplay(textFromTextarea = '', monogramText = []) {
    // Fixed: monogram sizing now applies to EVERY preview container
    // (previously only container index 0 got it, leaving other
    // containers with stale/inconsistent monogram sizing).
    customImagesContainers.forEach((container) => {
        const textareaDisplay = container.querySelector('.textarea-text-display-os');
        const monogramDisplay = container.querySelector('.monogram-text-display-os');

        updateTextareaFontClass(textareaDisplay, currentSelectedFontFamily);
        updateFontColor(textareaDisplay, currentFontColor);
        updateMonogramFontClass(monogramDisplay, currentSelectedFontFamily);
        updateFontColor(monogramDisplay, currentFontColor);

        if (textFromTextarea) {
            textareaDisplay.textContent = textFromTextarea;
        } else {
            textareaDisplay.textContent = '';
        }

        if (monogramText.length > 0) {
            monogramDisplay.innerHTML = `${monogramText[0]}<span class="monogram-large-text-os">${monogramText[1]}</span>${monogramText[2] || ''}`;
        } else {
            monogramDisplay.innerHTML = '';
        }

        adjustFontSizeAndLineHeight0(monogramDisplay);
    });
  }

  // Keep the embroidery the same proportional size in every preview.
  // The artwork is exported on a 450px-wide trunk. Each live preview can
  // have a different responsive width, so its text must scale with that
  // exact trunk width. The canvas code scales it back to 450px on export.
  function getPersonalizationPreviewScale(displayElement) {
      // Do not calculate font size from the individual image/container width.
      // PDP and popup use different image widths, which previously produced
      // 74.67px on PDP and 39.68px inside the popup. Use one device scale so
      // both locations always receive the exact same font size.
      return window.matchMedia('(max-width: 767px)').matches ? 0.55 : 1;
  }

  function setScaledPreviewSize(element, fontSize, lineHeight) {
      if (!element) return;
      const scale = getPersonalizationPreviewScale(element);

      // Reduce ONLY the embroidery text. Do not resize the popup, trunk,
      // fabric or generated image. This keeps the personaliser text at the
      // same visual proportion as the text shown on the product page.
      const embroideryTextScale = 0.75;

      element.style.fontSize = `${fontSize * scale * embroideryTextScale}px`;
      element.style.lineHeight = `${lineHeight * scale * embroideryTextScale}px`;
  }

  function adjustFontSizeAndLineHeight0(monogramDisplay, textareaDisplay, textLength) {

  if (monogramDisplay) {

    // Normal monogram size same for all fonts
    setScaledPreviewSize(monogramDisplay, 62, 64.4);


    const largeTextSpan = monogramDisplay.querySelector('.monogram-large-text-os');


    if (largeTextSpan) {

      // Only Flourish font large letter size reduce
      if (textareaDisplay && textareaDisplay.classList.contains("flourish")) {

        setScaledPreviewSize(largeTextSpan, 92, 110.4);

      } else {

        setScaledPreviewSize(largeTextSpan, 102, 122.4);

      }

    }

  }



  if (textareaDisplay && textLength) {

      let fontSize = 0;
      let lineHeight = 0;


      if (textareaDisplay.classList.contains("flourish")) {

        fontSize = textLength > 28 ? 24 : 24;
        lineHeight = textLength > 28 ? 48 : 45;


      } else if (textareaDisplay.classList.contains("signature")) {

        fontSize = textLength > 28 ? 45 : 72;
        lineHeight = textLength > 28 ? 42 : 60;


      } else if (textareaDisplay.classList.contains("fancy")) {

        fontSize = textLength > 28 ? 48 : 62;
        lineHeight = textLength > 28 ? 44 : 54;


      } else if (textareaDisplay.classList.contains("amalfi")) {

        fontSize = textLength > 28 ? 38 : 54;
        lineHeight = textLength > 28 ? 38 : 48;


      } else if (textareaDisplay.classList.contains("fondly-yours")) {

        fontSize = textLength > 28 ? 38 : 58;
        lineHeight = textLength > 28 ? 38 : 54;


      } else if (textareaDisplay.classList.contains("casually-cool")) {

        fontSize = textLength > 28 ? 42 : 62;
        lineHeight = textLength > 28 ? 42 : 48;


      } else if (textareaDisplay.classList.contains("memorize")) {

        fontSize = textLength > 28 ? 42 : 51.3333333;
        lineHeight = textLength > 28 ? 45 : 62;


      } else if (textareaDisplay.classList.contains("headliner")) {

        fontSize = textLength > 28 ? 28 : 45;
        lineHeight = textLength > 28 ? 34 : 48;


      } else if (textareaDisplay.classList.contains("letter-jacket")) {

        fontSize = textLength > 28 ? 32 : 48;
        lineHeight = textLength > 28 ? 38 : 56;


      } else if (textareaDisplay.classList.contains("vintage")) {

        fontSize = textLength > 28 ? 28 : 45;
        lineHeight = textLength > 28 ? 32 : 48;


      } else {

        fontSize = textLength > 28 ? 32 : 48;
        lineHeight = textLength > 28 ? 38 : 52;

      }


      setScaledPreviewSize(textareaDisplay, fontSize, lineHeight);

  }

  }

