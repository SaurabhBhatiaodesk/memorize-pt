<script>
  const mobilePrintingTextArea = document.querySelector('.mobile-wordNumber-os textarea');
  const mobileTextareaDisplay = document.querySelectorAll('.textarea-text-display-os');
  const mobileMonogramDisplay = document.querySelectorAll('.monogram-text-display-os');
  const mobileCustomImagesContainers = document.querySelectorAll('.custom-images-os');
  const mobileThreadColorContainer = document.querySelector('.mobile-custom-thread-color-list-os');
  const mobileFontsContainer = document.querySelector('.mobile-font-buttons-os');

  function mobileCreateThreadColorOptions(fabric) {
      if ($(mobileThreadColorContainer).hasClass('slick-initialized')) {
          $(mobileThreadColorContainer).slick('unslick');
          console.log("Slick instance destroyed");
      }
      mobileThreadColorContainer.innerHTML = '';
      const recommendedColors = recommendedFabricsWithThreadColorOptions[fabric] || [];
      const allColors = Object.keys(threadColors);
      const recommendedColorsFirst = allColors.filter(color => recommendedColors.includes(color));
      const remainingColors = allColors.filter(color => !recommendedColors.includes(color));
      const orderedColors = [...recommendedColorsFirst, ...remainingColors];

      orderedColors.forEach(colorName => {
        const colorValue = threadColors[colorName];
        const colorColDiv = document.createElement('div');
        colorColDiv.classList.add('mobile-swatch-col-os');
        const colorDiv = document.createElement('div');
        colorDiv.style.backgroundColor = colorValue;
        colorDiv.classList.add('mobile-swatch-os');
        const colorNameSpan = document.createElement('span');
        colorNameSpan.textContent = colorName;
        colorColDiv.appendChild(colorDiv);
        colorColDiv.appendChild(colorNameSpan);
        colorDiv.onclick = () => selectMobileColor(colorName, colorDiv, colorValue);
        mobileThreadColorContainer.appendChild(colorColDiv);
      });
  }

  function toLetterCase1(fontName) {
      return fontName.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
  }

  function toHyphenatedCase1(fontName) {
      return fontName.split(' ').map(word => word.toLowerCase()).join('-');
  }

  let currentIndex = 4;
  let isSliderActive = true;

  function closePopupButton() {
      currentIndex = 4;
      changeContent(0);
  }

  function updateContent() {
      const sections = document.querySelectorAll('.mobile-personalize-fields-col-os');
      const forwardStepElement = document.querySelector(".forward-step-os");
      const mobilePersonalizeHeading = document.querySelector(".personalize-product-popup-heading-os h2");

      sections.forEach((section, index) => {
          section.style.display = (index === currentIndex - 4) ? 'block' : 'none';
      });

      document.querySelector('.pagination-counter-os').innerText = `${currentIndex}/8`;

      if (currentIndex === 6) {
          if (mobileFontsContainer && $(mobileFontsContainer).hasClass('slick-initialized')) {
              $(mobileFontsContainer).slick('unslick');
          }
          if (mobileFontsContainer) {
              $(mobileFontsContainer).slick({
                  rows: 2, dots: true, arrows: false, infinite: false, speed: 500,
                  slidesToShow: 2, slidesToScroll: 2,
                  responsive: [{ breakpoint: 360, settings: { slidesToShow: 1, slidesToScroll: 1 } }]
              });
          }
      }

      if (currentIndex === 7) {
          if (mobileThreadColorContainer && $(mobileThreadColorContainer).hasClass('slick-initialized')) {
              $(mobileThreadColorContainer).slick('unslick');
          }
          if (mobileThreadColorContainer) {
              $(mobileThreadColorContainer).slick({
                  rows: 2, dots: true, arrows: false, infinite: false, speed: 600,
                  slidesToShow: 5, slidesToScroll: 5,
              });
          }
      }

      if (forwardStepElement) {
        if (currentIndex === 8) {
            forwardStepElement.style.opacity = "0";
            forwardStepElement.style.visibility = "hidden";
            mobilePersonalizeHeading.innerHTML = "Congratulations!";
        } else {
            forwardStepElement.style.opacity = "1";
            forwardStepElement.style.visibility = "visible";
            mobilePersonalizeHeading.innerHTML = "Quality Craftsmanship for your Core Memories";
        }
      }
  }

  function changeContent(direction) {
      currentIndex += direction;
      const sections = document.querySelectorAll('.mobile-personalize-fields-col-os');
      if (currentIndex < 4) currentIndex = 4;
      else if (currentIndex > sections.length + 3) currentIndex = sections.length + 3;
      updateContent();
  }

  function validateMobileStepsAndProceed() {
      document.querySelectorAll('.error-message-os').forEach(msg => msg.style.display = 'none');

      if (currentIndex === 4) {
        const selectedTypeElement = document.querySelector('.mobile-embroideryType-input-os:checked');
        const selectedType = selectedTypeElement ? selectedTypeElement.value : null;
        if (!selectedType) { document.getElementById('embroideryError').style.display = 'block'; return; }
      } else if (currentIndex === 5) {
        const selectedTypeElement = document.querySelector('.mobile-embroideryType-input-os:checked');
        const selectedType = selectedTypeElement ? selectedTypeElement.value : null;
        if (selectedType === 'Words/Numbers') {
          const textareaValue = document.querySelector('.mobile-wordNumber-os textarea').value.trim();
          if (!textareaValue) { document.getElementById('wordNumberError').style.display = 'block'; return; }
        } else if (selectedType === 'Monogram') {
          const monogramInputs = document.querySelectorAll('.mobile-monogram-os input');
          const allFilled = Array.from(monogramInputs).every(input => input.value.trim() !== '');
          if (!allFilled) { document.getElementById('monogramError').style.display = 'block'; return; }
        }
      } else if (currentIndex === 6) {
        const selectedFont = document.querySelector('.mobile-custom-font-names-os').value;
        if (!selectedFont) { document.getElementById('fontError').style.display = 'block'; return; }
      } else if (currentIndex === 7) {
        const selectedColor = document.querySelector('.selectedColor').value;
        if (!selectedColor) { document.getElementById('colorError').style.display = 'block'; return; }
      }

      changeContent(1);
  }

  function selectMobileEmbroideryType(type, button) {
    const buttons = document.querySelectorAll('.mobile-embroideryType-buttons-os button');
    buttons.forEach(btn => { btn.classList.remove('selected'); });
    button.classList.add('selected');
    const radioInput = button.querySelector('input[type="radio"]');
    if (radioInput) radioInput.checked = true;
    toggleMobileEmbroideryFields();
  }

  function toggleMobileEmbroideryFields() {
      const wordNumberFields = document.querySelector('.mobile-wordNumber-os');
      const nonogramFields = document.querySelector('.mobile-monogram-os');
      const monogramInputs = document.querySelectorAll('.mobile-monogram-inputs-os input[type="text"]');
      const selectedTypeElement = document.querySelector('.mobile-embroideryType-input-os:checked');
      const selectedType = selectedTypeElement ? selectedTypeElement.value : null;

      if (selectedType === 'Words/Numbers') {
          wordNumberFields.style.display = 'block';
          nonogramFields.style.display = 'none';
          monogramInputs.forEach(input => {
              if (input.value) {
                  input.value = '';
                  mobileMonogramDisplay.forEach(item => { item.innerHTML = ''; });
                  mobileTextareaDisplay.forEach(item => { item.innerHTML = ''; });
                  document.querySelector('.mobile-monogram-text-value-os').value = '';
              }
          });
      } else {
          nonogramFields.style.display = 'block';
          wordNumberFields.style.display = 'none';
          if (mobilePrintingTextArea.value) {
              mobileTextareaDisplay.forEach(item => { item.innerHTML = ''; });
              mobileMonogramDisplay.forEach(item => { item.innerHTML = ''; });
              mobilePrintingTextArea.value = '';
          }
      }
  }

  function selectMobileFont(font, button) {
    const buttons = document.querySelectorAll('.mobile-font-buttons-os .mobile-font-option-os');
    let letterCased = toLetterCase(font);
    buttons.forEach(btn => { btn.classList.remove('selected'); });
    button.classList.add('selected');
    document.querySelector('.mobile-custom-font-names-os').value = font;
    document.querySelector('.custom-font-names-os').value = letterCased;
    console.log("selectMobileFont item ::", font);
    handleOfficialFontCode(font);
    mobileTextareaDisplay.forEach(item => {
      const newClasses = Array.from(item.classList).filter(className => className === 'textarea-text-display-os');
      item.className = newClasses.join(' ');
      item.classList.add(font);
      mobileAdjustFontSizeAndLineHeight(mobilePrintingTextArea);
    });
    mobileMonogramDisplay.forEach(item => {
      const newMonogramClasses = Array.from(item.classList).filter(className => className === 'monogram-text-display-os');
      item.className = newMonogramClasses.join(' ');
      item.classList.add(font);
    });
  }

  function selectMobileColor(color, colorDiv, hexColor) {
      const colorDivs = document.querySelectorAll('.mobile-custom-thread-color-list-os .mobile-swatch-os');
      const activeMobileColorName = document.querySelectorAll('.active-mobile-color-name-os');
      colorDivs.forEach(div => { div.classList.remove('selected'); });
      colorDiv.classList.add('selected');
      document.querySelector('.selectedColor').value = color;
      activeMobileColorName.forEach((item) => { item.textContent = `(${color})`; });
      console.log("selectMobileColor hexColor ::", hexColor);
      console.log("selectMobileColor color ::", color);
      // Keep mobile selected thread color synced with Shopify properties
      const threadPropertyInput = document.querySelector('input[name="properties[Thread Color]"]');
      if (threadPropertyInput) {
        threadPropertyInput.value = color;
