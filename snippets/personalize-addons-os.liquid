{%- comment -%}
  Personalizer step "Don't forget to add": Shopify's recommended (complementary)
  products for the trunk being personalized, side by side in a scrolling row.
  A product with the handle / tag set below gets an engraving choice (3 preset
  messages or a custom message).

  The products are NOT hard-coded. They come from Shopify, in this order:
    1. the product's own "Complementary products" (Search & Discovery app), if set;
    2. otherwise the products of the collection with the handle addon_collection
       (one collection = the same add-ons on EVERY personalizer product).
  If neither returns anything, the step removes itself and the personalizer behaves
  exactly as before.

  Usage (from personalize-it-popup-os):
    {% render 'personalize-addons-os', part: 'markup', context: 'desktop', product: product %}
    {% render 'personalize-addons-os', part: 'markup', context: 'mobile', product: product %}
    {% render 'personalize-addons-os', part: 'assets', product: product %}      CSS + JS, render once

  Cart: customformSubmission (product sections) calls
  window.PersonalizeAddons.getCartItems() and sends the picked products in the same
  cart/add.js request as the trunk. The engraving is the "Engraving" line item
  property. getSelection() returns the raw choices.

  Settings (edit below):
    addons_enabled        switch the whole step on/off
    addon_intent          Shopify recommendation type ('complementary' = add-ons)
    addon_limit           max products shown
    addon_collection      handle of the collection used when a product has no complementary products
    engravable_handle     handle of the product that takes an engraving
    engravable_tag        or any product with this tag takes an engraving
    engraving_presets     PLACEHOLDER preset messages, separated by |
    engraving_max_chars   PLACEHOLDER limit for the custom message

  Preview card: while Shopify returns no recommended products, an UNPUBLISHED theme
  (Draft theme, theme editor, preview link) shows two clearly labelled preview
  cards (padlock, pouch) so the step can be reviewed. It has no variant, so it can never reach
  the cart. The published (live) theme never shows it: with no products the step
  simply removes itself.
{%- endcomment -%}

{%- liquid
  assign addons_enabled = true
  assign addon_intent = 'complementary'
  assign addon_limit = 8
  assign addon_collection = 'personalizer-add-ons'
  assign engravable_handle = 'engraved-heart-padlock'
  assign engravable_tag = 'engravable'
  assign engraving_presets = 'Forever & Always|Love You More|Together Since'
  assign engraving_max_chars = 30
  assign preview_image = '//memorizeyourlife.com/cdn/shop/files/memorize-lock-blue-rgb-900px-w-72ppi.png?v=1751344119'
-%}

{%- if part == 'markup' and addons_enabled and product != blank -%}
  <div class="addons-os" data-addons-os data-context="{{ context | escape }}" data-product-id="{{ product.id }}">
    <div class="addons-track-os" data-addons-track></div>
    <div class="addon-error-os" data-addon-error hidden>Please choose an engraving or write your own message, or remove the item.</div>
  </div>

{%- elsif part == 'assets' and addons_enabled and product != blank -%}
  {%- assign preset_list = engraving_presets | split: '|' -%}
  <script type="application/json" id="addons-config-os">
    {
      "intent": {{ addon_intent | json }},
      "limit": {{ addon_limit | json }},
      "collection": {{ addon_collection | json }},
      "engravableHandle": {{ engravable_handle | json }},
      "engravableTag": {{ engravable_tag | json }},
      "presets": {{ preset_list | json }},
      "maxChars": {{ engraving_max_chars | json }},
      "currency": {{ cart.currency.symbol | default: '$' | json }},
      "previewWhenEmpty": {% if theme.role != 'main' %}true{% else %}false{% endif %},
      "previewImage": {{ preview_image | json }}
    }
  </script>
  <style>
    .addons-os { width: 100%; }
    .addons-track-os {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 2px 2px 8px;
      -webkit-overflow-scrolling: touch;
    }
    .addon-card-os {
      flex: 0 0 88%;
      max-width: 88%;
      scroll-snap-align: start;
      border: 1px solid #c8d6e5;
      border-radius: 6px;
      padding: 12px;
      box-sizing: border-box;
      background: #fff;
    }
    .addon-card-os:only-child { flex-basis: 100%; max-width: 100%; }
    .addon-card-os.is-selected { border-color: #274864; box-shadow: 0 0 0 1px #274864; }
    .addon-main-os { display: flex; gap: 14px; align-items: center; }
    .addon-img-os { flex: 0 0 96px; }
    .addon-img-os img { width: 96px; height: 96px; object-fit: contain; display: block; }
    .addon-info-os { flex: 1 1 auto; min-width: 0; }
    .addon-title-os { font-size: 17px; line-height: 22px; color: #274864; }
    .addon-price-os { font-size: 16px; font-weight: 600; color: #274864; margin: 4px 0 8px; }
    .addon-btn-os {
      background: #274864;
      color: #fff;
      border: 1px solid #274864;
      border-radius: 4px;
      padding: 10px 14px;
      min-height: 40px;
      cursor: pointer;
      text-transform: uppercase;
      font-size: 13px;
      letter-spacing: .02em;
    }
    .addon-card-os.is-selected .addon-btn-os { background: #fff; color: #274864; }
    .addon-engrave-os { margin-top: 12px; padding-top: 12px; border-top: 1px solid #e3ebf3; }
    .addon-engrave-os[hidden], .addon-custom-os[hidden], .addon-error-os[hidden] { display: none; }
    .addon-engrave-title-os { margin: 0 0 8px; font-size: 14px; font-weight: 600; color: #274864; }
    .addon-option-os { display: flex; align-items: center; gap: 8px; padding: 8px 0; cursor: pointer; font-size: 15px; color: #274864; }
    .addon-option-os input { margin: 0; accent-color: #274864; }
    .addon-custom-os { margin: 4px 0 8px 24px; }
    .addon-custom-input-os { width: 100%; box-sizing: border-box; border: 1px solid #274864; border-radius: 4px; padding: 10px; font-size: 16px; }
    .addon-count-os { display: block; font-size: 12px; color: #5b7088; margin-top: 4px; }
    .addon-remove-os { background: none; border: 0; padding: 4px 0; color: #5b7088; text-decoration: underline; cursor: pointer; font-size: 13px; }
    .addon-error-os { color: red; margin: 10px 0; font-size: 14px; }
    .addon-preview-note-os { font-size: 12px; line-height: 16px; color: #b3261e; margin: 0 0 6px; font-style: italic; }
    .personalize-product-popup-addons-os { margin-top: 20px; }
  </style>
  <script>
    (function () {
      var noop = { validate: function () { return true; }, getSelection: function () { return []; }, getCartItems: function () { return []; }, reset: function () {} };
      window.PersonalizeAddons = noop;
      try {
        var configEl = document.getElementById('addons-config-os');
        var roots = document.querySelectorAll('[data-addons-os]');
        if (!configEl || !roots.length) return;
        var config = JSON.parse(configEl.textContent);
        var productId = roots[0].getAttribute('data-product-id');
        var products = {};     // id -> product data
        var state = {};        // id -> { engraving: null | { type, text } }

        // Nothing to recommend: take the step out so the personalizer is unchanged.
        function removeStep() {
          document.querySelectorAll('[data-addons-step], .personalize-product-popup-addons-os').forEach(function (node) { node.remove(); });
        }

        function el(tag, className, text) {
          var node = document.createElement(tag);
          if (className) node.className = className;
          if (text !== undefined) node.textContent = text;
          return node;
        }
        function formatPrice(cents) {
          var amount = (Number(cents) || 0) / 100;
          return config.currency + (amount % 1 === 0 ? String(amount) : amount.toFixed(2));
        }
        function isEngravable(p) {
          return p.handle === config.engravableHandle || (Array.isArray(p.tags) && p.tags.indexOf(config.engravableTag) !== -1);
        }
        function imageUrl(src) {
          if (!src) return '';
          if (/^data:/.test(src)) return src;
          return src + (src.indexOf('?') === -1 ? '?' : '&') + 'width=300';
        }

        function buildCard(p, context, index) {
          var card = el('div', 'addon-card-os');
          card.setAttribute('data-addon-id', String(p.id));
          var main = el('div', 'addon-main-os');
          var imgWrap = el('div', 'addon-img-os');
          var src = p.featured_image || (p.images && p.images[0]) || '';
          if (src) {
            var img = el('img');
            img.src = imageUrl(src);
            img.alt = p.title;
            img.width = 96; img.height = 96; img.loading = 'lazy';
            imgWrap.appendChild(img);
          }
          var info = el('div', 'addon-info-os');
          info.appendChild(el('div', 'addon-title-os', p.title));
          if (p.preview) info.appendChild(el('div', 'addon-preview-note-os', 'Preview only: this product is not set up in Shopify yet'));
          info.appendChild(el('div', 'addon-price-os', formatPrice(p.price)));
          var button = el('button', 'addon-btn-os', isEngravable(p) ? 'Choose your engraving' : 'Add');
          button.type = 'button';
          button.setAttribute('data-addon-toggle', '');
          info.appendChild(button);
          main.appendChild(imgWrap);
          main.appendChild(info);
          card.appendChild(main);

          if (isEngravable(p)) {
            card.setAttribute('data-engravable', 'true');
            var panel = el('div', 'addon-engrave-os');
            panel.setAttribute('data-addon-engrave', '');
            panel.hidden = true;
            panel.appendChild(el('p', 'addon-engrave-title-os', 'Choose an engraved message'));
            var groupName = 'addon-engraving-' + context + '-' + index;
            (config.presets || []).forEach(function (preset) {
              var text = String(preset).trim();
              if (!text) return;
              var label = el('label', 'addon-option-os');
              var radio = el('input');
              radio.type = 'radio'; radio.name = groupName; radio.value = 'preset';
              radio.setAttribute('data-addon-engraving', '');
              radio.setAttribute('data-text', text);
              label.appendChild(radio);
              label.appendChild(el('span', '', text));
              panel.appendChild(label);
            });
            var customLabel = el('label', 'addon-option-os');
            var customRadio = el('input');
            customRadio.type = 'radio'; customRadio.name = groupName; customRadio.value = 'custom';
            customRadio.setAttribute('data-addon-engraving', '');
            customLabel.appendChild(customRadio);
            customLabel.appendChild(el('span', '', 'Write my own message'));
            panel.appendChild(customLabel);
            var custom = el('div', 'addon-custom-os');
            custom.setAttribute('data-addon-custom', '');
            custom.hidden = true;
            var input = el('input', 'addon-custom-input-os');
            input.type = 'text'; input.maxLength = config.maxChars || 30; input.placeholder = 'Type your message'; input.autocomplete = 'off';
            input.setAttribute('data-addon-custom-input', '');
            var count = el('span', 'addon-count-os');
            var countNumber = el('span', '', String(input.maxLength));
            countNumber.setAttribute('data-addon-count', '');
            count.appendChild(countNumber);
            count.appendChild(document.createTextNode(' characters left'));
            custom.appendChild(input);
            custom.appendChild(count);
            panel.appendChild(custom);
            var remove = el('button', 'addon-remove-os', 'Remove');
            remove.type = 'button';
            remove.setAttribute('data-addon-remove', '');
            panel.appendChild(remove);
            card.appendChild(panel);
          }
          return card;
        }

        function idOf(card) { return card.getAttribute('data-addon-id'); }
        function cardOf(node) { return node.closest('.addon-card-os'); }
        function hasEngraving(s) { return !!(s && s.engraving && s.engraving.text); }

        // Show the same choice in the desktop and the mobile copy of the step.
        function render() {
          document.querySelectorAll('[data-addons-os] .addon-card-os').forEach(function (card) {
            var s = state[idOf(card)];
            var selected = !!s;
            var engravable = card.getAttribute('data-engravable') === 'true';
            card.classList.toggle('is-selected', selected);
            var toggle = card.querySelector('[data-addon-toggle]');
            if (toggle) toggle.textContent = selected ? 'Added' : (engravable ? 'Choose your engraving' : 'Add');
            var panel = card.querySelector('[data-addon-engrave]');
            if (panel) panel.hidden = !selected;
            card.querySelectorAll('[data-addon-engraving]').forEach(function (radio) {
              var isCustom = radio.value === 'custom';
              radio.checked = !!(s && s.engraving && ((isCustom && s.engraving.type === 'custom') ||
                (!isCustom && s.engraving.type === 'preset' && s.engraving.text === radio.getAttribute('data-text'))));
            });
            var custom = card.querySelector('[data-addon-custom]');
            if (custom) custom.hidden = !(s && s.engraving && s.engraving.type === 'custom');
            var input = card.querySelector('[data-addon-custom-input]');
            if (input && s && s.engraving && s.engraving.type === 'custom' && input.value.trim() !== s.engraving.text) input.value = s.engraving.text;
            if (input && !s) input.value = '';
            var count = card.querySelector('[data-addon-count]');
            if (count && input) count.textContent = String(Math.max(input.maxLength, 0) - input.value.length);
          });
          document.querySelectorAll('[data-addon-error]').forEach(function (node) { node.hidden = true; });
        }

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          var toggle = target.closest('[data-addon-toggle]');
          var remove = target.closest('[data-addon-remove]');
          if (!toggle && !remove) return;
          var card = cardOf(target);
          if (!card || !products[idOf(card)]) return;
          var id = idOf(card);
          var engravable = card.getAttribute('data-engravable') === 'true';
          if (remove || (toggle && state[id] && !engravable)) { delete state[id]; }
          else if (!state[id]) { state[id] = { engraving: null }; }
          render();
        });

        document.addEventListener('change', function (event) {
          var radio = event.target;
          if (!radio || !radio.matches || !radio.matches('[data-addon-engraving]')) return;
          var card = cardOf(radio);
          if (!card || !state[idOf(card)]) return;
          if (radio.value === 'custom') {
            var input = card.querySelector('[data-addon-custom-input]');
            state[idOf(card)].engraving = { type: 'custom', text: input ? input.value.trim() : '' };
          } else {
            state[idOf(card)].engraving = { type: 'preset', text: radio.getAttribute('data-text') };
          }
          render();
        });

        document.addEventListener('input', function (event) {
          var input = event.target;
          if (!input || !input.matches || !input.matches('[data-addon-custom-input]')) return;
          var card = cardOf(input);
          if (!card || !state[idOf(card)]) return;
          state[idOf(card)].engraving = { type: 'custom', text: input.value.trim() };
          render();
        });

        window.PersonalizeAddons = {
          // Optional step: fine to continue with nothing picked. A picked product
          // that takes an engraving needs one.
          validate: function () {
            var ok = Object.keys(state).every(function (id) {
              return !(products[id] && isEngravable(products[id])) || hasEngraving(state[id]);
            });
            if (!ok) {
              // Show the message only in the copy of the step that is on screen.
              document.querySelectorAll('[data-addon-error]').forEach(function (node) {
                var host = node.closest('[data-addons-os]');
                node.hidden = !(host && host.offsetParent !== null);
              });
            }
            return ok;
          },
          getSelection: function () {
            return Object.keys(state).map(function (id) {
              var p = products[id] || {};
              var variant = (p.variants && p.variants[0]) || {};
              return { id: p.id, handle: p.handle, title: p.title, variantId: variant.id || null, engraving: state[id].engraving };
            });
          },
          // Items for the cart request, added next to the trunk by customformSubmission.
          // The engraving travels as the "Engraving" line item property.
          getCartItems: function () {
            return Object.keys(state).map(function (id) {
              var p = products[id];
              if (!p) return null;
              var variants = p.variants || [];
              var variant = variants.filter(function (v) { return v.available !== false; })[0] || variants[0];
              if (!variant || !variant.id) return null;
              var item = { id: variant.id, quantity: 1, properties: {} };
              if (isEngravable(p)) {
                if (!hasEngraving(state[id])) return null;
                item.properties['Engraving'] = state[id].engraving.text;
              }
              return item;
            }).filter(Boolean);
          },
          reset: function () { state = {}; render(); }
        };

        if (!productId) { removeStep(); return; }

        function getJson(url) {
          return fetch(url, { headers: { Accept: 'application/json' } })
            .then(function (response) { return response.ok ? response.json() : {}; })
            .catch(function () { return {}; });
        }
        function usable(list) {
          return (list || []).filter(function (p) { return p && p.available && String(p.id) !== String(productId); });
        }
        // Collection products come in the storefront format (price as "35.00" dollars,
        // images[], no 'available'): bring them to the shape used above.
        function fromCollection(p) {
          var variants = (p.variants || []).map(function (v) { return { id: v.id, available: v.available !== false, price: v.price }; });
          var first = variants.filter(function (v) { return v.available; })[0] || variants[0] || {};
          var tags = Array.isArray(p.tags) ? p.tags : String(p.tags || '').split(',').map(function (t) { return t.trim(); });
          return {
            id: p.id, handle: p.handle, title: p.title, tags: tags,
            available: variants.some(function (v) { return v.available; }),
            price: Math.round(parseFloat(first.price || 0) * 100),
            featured_image: (p.images && p.images[0] && p.images[0].src) || '',
            variants: variants
          };
        }

        getJson('/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=' + encodeURIComponent(config.limit) + '&intent=' + encodeURIComponent(config.intent))
          .then(function (data) {
            var own = usable(data.products);
            if (own.length || !config.collection) return own;
            return getJson('/collections/' + encodeURIComponent(config.collection) + '/products.json?limit=' + encodeURIComponent(config.limit))
              .then(function (collectionData) { return usable((collectionData.products || []).map(fromCollection)); });
          })
          .then(function (list) {
            if (!list.length && config.previewWhenEmpty) {
              // Unpublished theme only: labelled preview cards, never sellable (no variants).
              var pouchSvg = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300"><rect width="300" height="300" fill="#f4f4f6"/><rect x="60" y="95" width="180" height="110" rx="26" fill="#fff" stroke="#b9c4d8" stroke-width="4"/><path d="M60 150h180M105 95l-45 55 45 55M195 95l45 55-45 55M150 95l-45 55 45 55 45-55z" fill="none" stroke="#c9d3e6" stroke-width="3"/></svg>');
              list = [
                { id: 'preview-padlock', handle: config.engravableHandle, title: 'Engraved Heart Padlock', price: 3500, available: true, featured_image: config.previewImage, tags: [], variants: [], preview: true },
                { id: 'preview-pouch', handle: 'preview-pouch', title: 'Small Archival Pouch', price: 3000, available: true, featured_image: pouchSvg, tags: [], variants: [], preview: true }
              ];
            }
            if (!list.length) { removeStep(); return; }
            list.forEach(function (p) { products[String(p.id)] = p; });
            roots.forEach(function (root) {
              var track = root.querySelector('[data-addons-track]');
              var context = root.getAttribute('data-context') || 'x';
              if (!track) return;
              list.forEach(function (p, index) { track.appendChild(buildCard(p, context, index + 1)); });
            });
          })
          .catch(function () { removeStep(); });
      } catch (error) {
        console.warn('Personalizer add-ons step failed to start', error);
        try { document.querySelectorAll('[data-addons-step], .personalize-product-popup-addons-os').forEach(function (node) { node.remove(); }); } catch (e) {}
      }
    })();
  </script>
{%- endif -%}
