{%- comment -%}
  Personalizer step "Don't forget to add": Shopify's recommended (complementary)
  products for the trunk being personalized, side by side in a scrolling row.
  A product with the handle / tag set below gets an engraving choice (3 preset
  messages or a custom message).

  What is shown, in this order:
    A. add-on products set up in Shopify (below), with an engraving choice for the padlock;
    B. then the OTHER personalizer trunks (addon_trunk_handles), each with an Add button; a
       picked trunk is added to the cart together with the current one (its first available
       variant, no personalization). The trunk being personalized is left out.
  The add-on products (A) come from Shopify, in this order:
    1. the product's own "Complementary products" (Search & Discovery app), if set;
    2. otherwise the products of the collection with the handle addon_collection
       (one collection = the same add-ons on EVERY personalizer product).
  If neither returns anything, the step removes itself and the personalizer behaves
  exactly as before.

  Usage (from personalize-it-popup-os):
    {% render 'personalize-addons-os', part: 'markup', context: 'desktop', product: product %}          lock + message, one block
    {% render 'personalize-addons-os', part: 'markup', context: 'mobile', product: product %}           mobile step 1: the lock ("Engrave It")
    {% render 'personalize-addons-os', part: 'markup', context: 'mobile-message', product: product %}   mobile step 2: add your message
    {% render 'personalize-addons-os', part: 'assets', product: product %}      CSS + JS, render once

  Mobile: two stepper steps. Step 1 shows the lock; "Engrave It" picks it and goes to step 2, "add your
  message". Step 2 is only part of the stepper while the lock is picked (it leaves the page otherwise, so
  the step counter and the last step stay right); "Remove" in step 2 drops the lock and goes back to step 1.

  Review aid: on an UNPUBLISHED theme (Draft theme, preview link, editor) a "Lock" card with the
  engraving options (only the custom message for now: presets appear when they are configured) is shown until the real product exists
  (?addons_demo=0 in the page address hides it). Price only if demo_price is set, never added to the cart,
  never shown on the published theme.

  Cart: customformSubmission (product sections) calls
  window.PersonalizeAddons.getCartItems() and sends the picked products (padlock with
  its "Engraving" line item property, trunks) in the same cart/add.js request as the
  trunk. getSelection() returns the raw choices.

  Settings (edit below):
    addons_enabled        switch the whole step on/off
    addon_intent          Shopify recommendation type ('complementary' = add-ons)
    addon_limit           max products shown
    addon_collection      handle of the collection used when a product has no complementary products
    addons_reveal_after_embroidery  true = on desktop the step shows a short "complete your embroidery
                          options" note and reveals the products once the embroidery options (type,
                          words/monogram, font) are filled in; false = products always visible
    addon_exclude_handles never shown as add-ons (the trunks, custom embroidery, gift cards)
    engravable_tag        a product with this tag (default 'engravable') takes an engraving
    engravable_handle     or the product with this handle (empty = none)
    engraving_presets     the preset engraving messages, separated by | (empty until the client
                          gives them: then only the custom message field is shown)
    engraving_max_chars   limit for the custom message (0 = no limit until the client gives one)
    demo_price            Draft theme only: the fee shown on the demo Lock card (e.g. 20), desktop and mobile,
                          until the real lock product exists. 20 for now (given by the team, not yet confirmed
                          by the client); empty = no price shown.
                          The real product always shows its own Shopify price (that is what is charged).
    These can also be passed in the render call from personalize-it-popup-os.

{%- endcomment -%}

{%- liquid
  assign addons_enabled = true
  assign addon_intent = 'complementary'
  assign addon_limit = 8
  assign addon_collection = 'personalizer-add-ons'
  assign addons_reveal_after_embroidery = true
  assign addon_trunk_handles = 'weddings,graduations,baby-child,other-family'
  assign addon_exclude_handles = 'holiday-limited-time-edition,custom-embroidery,memorize-trunks-egift-card'
  assign engravable_handle = engravable_handle | default: ''
  assign engravable_tag = engravable_tag | default: 'engravable'
  assign engraving_presets = engraving_presets | default: ''
  assign engraving_max_chars = engraving_max_chars | default: 0
  assign demo_price = demo_price | default: '20'
  assign demo_image = '//memorizeyourlife.com/cdn/shop/files/memorize-lock-blue-rgb-900px-w-72ppi.png?v=1751344119'
-%}

{%- if part == 'markup' and addons_enabled and product != blank -%}
  <div class="addons-os" data-addons-os data-context="{{ context | escape }}" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle | escape }}">
    {%- if context != 'mobile-message' -%}
    <div class="addons-viewport-os">
      <button type="button" class="addon-arrow-os is-prev" data-addon-arrow="-1" aria-label="Previous product" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="addons-track-os" data-addons-track></div>
      <button type="button" class="addon-arrow-os is-next" data-addon-arrow="1" aria-label="Next product" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="addons-dots-os" data-addons-dots hidden></div>
    {%- endif -%}
    {%- if context != 'mobile' -%}
    <div class="addons-engrave-area-os" data-addons-engrave-area></div>
    {%- endif -%}
    <div class="addon-error-os" data-addon-error hidden>Please choose an engraving or write your own message, or remove the item.</div>
  </div>

{%- elsif part == 'assets' and addons_enabled and product != blank -%}
  {%- assign preset_list = engraving_presets | split: '|' -%}
  <script type="application/json" id="addons-config-os">
    {
      "intent": {{ addon_intent | json }},
      "limit": {{ addon_limit | json }},
      "collection": {{ addon_collection | json }},
      "revealAfterEmbroidery": {{ addons_reveal_after_embroidery | json }},
      "excludeHandles": {{ addon_exclude_handles | split: ',' | json }},
      "trunkHandles": {{ addon_trunk_handles | split: ',' | json }},
      "engravableHandle": {{ engravable_handle | json }},
      "engravableTag": {{ engravable_tag | json }},
      "presets": {{ preset_list | json }},
      "maxChars": {{ engraving_max_chars | json }},
      "demoPrice": {{ demo_price | json }},
      "currency": {{ cart.currency.symbol | default: '$' | json }},
      "allowDemo": {% if theme.role != 'main' %}true{% else %}false{% endif %},
      "demoImage": {{ demo_image | json }}
    }
  </script>
  <style>
    .addons-os { width: 100%; }
    .addons-track-os {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      padding: 2px 2px 6px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;          /* no scrollbar with left/right arrows */
      -ms-overflow-style: none;
    }
    .addons-track-os::-webkit-scrollbar { display: none; width: 0; height: 0; }
    .addon-card-os {
      flex: 0 0 86%;
      max-width: 86%;
      scroll-snap-align: start;
      border: 1px solid #dde6ef;
      border-radius: 12px;
      padding: 14px;
      box-sizing: border-box;
      background: #fff;
      box-shadow: 0 2px 10px rgba(39, 72, 100, .06);
      transition: border-color .2s ease, box-shadow .2s ease;
    }
    .addon-card-os:only-child { flex-basis: 100%; max-width: 100%; }
    .addon-card-os.is-selected { border-color: #274864; box-shadow: 0 0 0 1px #274864, 0 4px 14px rgba(39, 72, 100, .12); }
    .addons-viewport-os { position: relative; }
    .addon-arrow-os {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
      width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%;
      background: #00334D; cursor: pointer; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 51, 77, .3); transition: opacity .2s ease;
    }
    .addon-arrow-os[hidden] { display: none; }
    .addon-arrow-os svg { width: 16px; height: 16px; display: block; }
    .addon-arrow-os.is-prev { left: 6px; }
    .addon-arrow-os.is-next { right: 6px; }
    .addon-arrow-os:disabled { opacity: 0; pointer-events: none; }
    @media screen and (max-width: 767px) { .addon-arrow-os { display: none; } } /* phones swipe + dots */
    .addons-dots-os { display: flex; justify-content: center; gap: 8px; padding: 6px 0 4px; }
    .addons-dots-os[hidden] { display: none; }
    .addon-dot-os { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 999px; background: #c9d6e3; cursor: pointer; transition: width .25s ease, background .25s ease; }
    .addon-dot-os.is-active { width: 22px; background: #274864; }
    .addon-main-os { display: flex; gap: 14px; align-items: center; }
    .addon-img-os { flex: 0 0 96px; }
    .addon-img-os img { width: 96px; height: 96px; object-fit: contain; border-radius: 12px; background: #f6f3ef; padding: 6px; box-sizing: border-box; display: block; }
    .addon-info-os { flex: 1 1 auto; min-width: 0; }
    .addon-title-os { font-size: 17px; line-height: 22px; color: #274864; margin-bottom: 8px; }
    .addon-price-os { font-size: 16px; font-weight: 600; color: #274864; margin: -2px 0 10px; }
    .addon-btn-os {
      background: #274864;
      color: #fff;
      border: 1px solid #274864;
      border-radius: 4px;
      padding: 6px 18px;
      min-height: 34px;
      line-height: 18px;
      cursor: pointer;
      text-transform: uppercase;
      font-size: 13px;
      letter-spacing: .02em;
    }
    .addon-card-os.is-selected .addon-btn-os { background: #fff; color: #274864; }
    a.addon-btn-os { display: inline-block; text-decoration: none; text-align: center; line-height: 20px; box-sizing: border-box; }
    .addons-engrave-area-os { margin-top: 4px; }
    .addon-engrave-os { margin: 0 2px 8px; padding: 14px; border: 1px solid #274864; border-radius: 6px; background: #fff; box-sizing: border-box; }
    .addon-engrave-os[hidden], .addon-custom-os[hidden], .addon-error-os[hidden] { display: none; }
    .addon-engrave-title-os { margin: 0 0 12px; font-size: 16px; line-height: 20px; color: #00334D; text-transform: uppercase; }
    /* Option buttons look like the personalizer own ones (Words/Numbers, fonts) */
    .addon-choices-os { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 12px; }
    .addon-choice-os {
      font-size: 15px; line-height: 18px; min-height: 34px; padding: 6px 12px;
      border: 2px solid #ddd; border-radius: 8px; background: #fff; color: #274864; cursor: pointer;
    }
    .addon-choice-os.is-selected { border-color: #274864; background: #274864; color: #fff; }
    .addon-custom-head-os { display: flex; justify-content: space-between; flex-wrap: wrap; padding-bottom: 8px; font-size: 14px; line-height: 18px; color: #274864; }
    .addon-custom-input-os { width: 100%; box-sizing: border-box; border: 1px solid #274864; border-radius: 8px; padding: 12px; font-size: 16px; margin: 0; }
    .addon-custom-input-os[readonly] { background: #f4f7fa; cursor: default; }
    .addon-count-os[hidden] { display: none; }
    .addon-count-os { font-size: 14px; line-height: 18px; color: #274864; }
    .addon-remove-os { background: none; border: 0; padding: 8px 0 0; color: #5b7088; text-decoration: underline; cursor: pointer; font-size: 13px; }
    @media screen and (max-width: 767px) {
      /* Same look as the mobile embroidery type buttons */
      .addon-choices-os { flex-direction: column; gap: 10px; }
      .addon-choice-os { width: 100%; min-height: 44px; border: 1px solid #274864; border-radius: 5px; font-size: 16px; }
      .addon-choice-os.is-selected { background: #274864; color: #fff; }
    }
    .addon-error-os { color: red; margin: 10px 0; font-size: 14px; }
    .personalize-product-popup-addons-os { margin-top: 20px; }
    .personalize-product-popup-addons-os[hidden] { display: none; }
    /* mobile step 2: the step heading already says "Add your message" */
    [data-context="mobile-message"] .addon-engrave-title-os { display: none; }
    [data-context="mobile-message"] .addon-engrave-os { margin: 0; }
    .addon-locked-note-os { display: none; margin: 4px 0 0; font-size: 14px; color: #5b7088; }
    .personalize-product-popup-addons-os.is-locked .addons-os { display: none; }
    .personalize-product-popup-addons-os.is-locked .addon-locked-note-os { display: block; }
  </style>
  <script>
    (function () {
      var noop = { validate: function () { return true; }, getSelection: function () { return []; }, getCartItems: function () { return []; }, getTrunkProperties: function () { return {}; }, reset: function () {} };
      window.PersonalizeAddons = noop;
      try {
        var configEl = document.getElementById('addons-config-os');
        var roots = document.querySelectorAll('[data-addons-os]');
        if (!configEl || !roots.length) return;
        var config = JSON.parse(configEl.textContent);
        var productId = roots[0].getAttribute('data-product-id');
        var currentHandle = roots[0].getAttribute('data-product-handle') || '';
        var products = {};     // id -> product data
        var state = {};        // id -> { engraving: null | { type, text } }

        // Nothing to recommend: take the step out so the personalizer is unchanged.
        function removeStep() {
          document.querySelectorAll('[data-addons-step], [data-addons-message-step], .personalize-product-popup-addons-os').forEach(function (node) { node.remove(); });
        }

        function el(tag, className, text) {
          var node = document.createElement(tag);
          if (className) node.className = className;
          if (text !== undefined) node.textContent = text;
          return node;
        }
        function formatPrice(cents) {
          var amount = (Number(cents) || 0) / 100;
          return config.currency + (amount % 1 === 0 ? String(amount) : amount.toFixed(2));
        }
        function isEngravable(p) {
          return (!!config.engravableHandle && p.handle === config.engravableHandle) || (!!config.engravableTag && Array.isArray(p.tags) && p.tags.indexOf(config.engravableTag) !== -1);
        }
        function imageUrl(src) {
          if (!src) return '';
          if (/^data:/.test(src)) return src;
          return src + (src.indexOf('?') === -1 ? '?' : '&') + 'width=300';
        }

        function buildCard(p, context, index) {
          var card = el('div', 'addon-card-os');
          card.setAttribute('data-addon-id', String(p.id));
          var main = el('div', 'addon-main-os');
          var imgWrap = el('div', 'addon-img-os');
          var src = p.featured_image || (p.images && p.images[0]) || '';
          if (src) {
            var img = el('img');
            img.src = imageUrl(src);
            img.alt = p.title;
            img.width = 96; img.height = 96; img.loading = 'lazy';
            imgWrap.appendChild(img);
          }
          var info = el('div', 'addon-info-os');
          info.appendChild(el('div', 'addon-title-os', p.title));
          if (p.price !== null && p.price !== undefined) info.appendChild(el('div', 'addon-price-os', formatPrice(p.price)));
          var button = el('button', 'addon-btn-os', isEngravable(p) ? 'Engrave It' : 'Add');
          button.type = 'button';
          button.setAttribute('data-addon-toggle', '');
          info.appendChild(button);
          main.appendChild(imgWrap);
          main.appendChild(info);
          card.appendChild(main);

          if (isEngravable(p)) card.setAttribute('data-engravable', 'true');
          return card;
        }

        function buildPanel(p, context) {
          var panel = el('div', 'addon-engrave-os');
          panel.setAttribute('data-addon-engrave', '');
          panel.setAttribute('data-addon-panel', '');
          panel.setAttribute('data-addon-id', String(p.id));
          panel.hidden = true;
          panel.appendChild(el('h4', 'addon-engrave-title-os', 'ADD YOUR MESSAGE'));
          var presets = (config.presets || []).map(function (t) { return String(t).trim(); }).filter(Boolean);
          var limit = Number(config.maxChars) || 0;
          if (presets.length) {
            var choices = el('div', 'addon-choices-os');
            presets.forEach(function (text) {
              var choice = el('button', 'addon-choice-os', text);
              choice.type = 'button';
              choice.setAttribute('value', 'preset');
              choice.setAttribute('data-addon-engraving', '');
              choice.setAttribute('data-text', text);
              choices.appendChild(choice);
            });
            var customChoice = el('button', 'addon-choice-os', 'Write my own message');
            customChoice.type = 'button';
            customChoice.setAttribute('value', 'custom');
            customChoice.setAttribute('data-addon-engraving', '');
            choices.appendChild(customChoice);
            panel.appendChild(choices);
          }
          var custom = el('div', 'addon-custom-os');
          custom.setAttribute('data-addon-custom', '');
          custom.hidden = true;
          var head = el('div', 'addon-custom-head-os');
          var messageLabel = el('span', '', 'ENGRAVED MESSAGE');
          messageLabel.setAttribute('data-addon-message-label', '');
          head.appendChild(messageLabel);
          if (limit > 0) {
            var count = el('span', 'addon-count-os');
            var countNumber = el('span', '', String(limit));
            countNumber.setAttribute('data-addon-count', '');
            count.appendChild(countNumber);
            count.appendChild(document.createTextNode(' characters left'));
            head.appendChild(count);
          }
          var input = el('input', 'addon-custom-input-os');
          input.type = 'text'; if (limit > 0) input.maxLength = limit; input.placeholder = 'Type your message'; input.autocomplete = 'off';
          input.setAttribute('data-addon-custom-input', '');
          custom.appendChild(head);
          custom.appendChild(input);
          panel.appendChild(custom);
          var remove = el('button', 'addon-remove-os', 'Remove');
          remove.type = 'button';
          remove.setAttribute('data-addon-remove', '');
          panel.appendChild(remove);
          return panel;
        }

        // Smooth scroll to a position; if the animation is skipped or interrupted, land on it anyway.
        function goTo(track, left, done) {
          track.scrollTo({ left: left, behavior: 'smooth' });
          setTimeout(function () {
            if (Math.abs(track.scrollLeft - left) > 4) { track.style.scrollBehavior = 'auto'; track.scrollLeft = left; track.style.scrollBehavior = ''; }
            if (done) done();
          }, 700);
        }

        // Premium carousel: no scrollbar; small dots show the position and jump to a card.
        function buildDots(track, dots) {
          var cards = Array.prototype.slice.call(track.querySelectorAll('.addon-card-os'));
          dots.hidden = false;
          cards.forEach(function (card, i) {
            var dot = el('button', 'addon-dot-os');
            dot.type = 'button';
            dot.setAttribute('aria-label', 'Go to product ' + (i + 1));
            dot.addEventListener('click', function () { goTo(track, card.offsetLeft - track.offsetLeft, refresh); });
            dots.appendChild(dot);
          });
          function sync() {
            var nearest = 0, best = Infinity;
            cards.forEach(function (card, i) {
              var d = Math.abs((card.offsetLeft - track.offsetLeft) - track.scrollLeft);
              if (d < best) { best = d; nearest = i; }
            });
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) nearest = cards.length - 1;
            Array.prototype.forEach.call(dots.children, function (dot, i) { dot.classList.toggle('is-active', i === nearest); });
          }
          var arrows = Array.prototype.slice.call(track.parentNode.querySelectorAll('[data-addon-arrow]'));
          function currentIndex() {
            var idx = 0, best = Infinity;
            cards.forEach(function (card, i) {
              var d = Math.abs((card.offsetLeft - track.offsetLeft) - track.scrollLeft);
              if (d < best) { best = d; idx = i; }
            });
            return idx;
          }
          arrows.forEach(function (arrow) {
            arrow.hidden = false;
            arrow.addEventListener('click', function () {
              var next = Math.max(0, Math.min(cards.length - 1, currentIndex() + Number(arrow.getAttribute('data-addon-arrow'))));
              goTo(track, cards[next].offsetLeft - track.offsetLeft, refresh);
            });
          });
          function syncArrows() {
            var atStart = track.scrollLeft <= 2;
            var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
            arrows.forEach(function (arrow) { arrow.disabled = Number(arrow.getAttribute('data-addon-arrow')) < 0 ? atStart : atEnd; });
          }
          function refresh() { sync(); syncArrows(); }
          track.addEventListener('scroll', function () { window.requestAnimationFrame(refresh); });
          refresh();
        }

        function idOf(card) { return card.getAttribute('data-addon-id'); }
        function cardOf(node) { return node.closest('.addon-card-os, [data-addon-panel]'); }
        function hasEngraving(s) { return !!(s && s.engraving && s.engraving.text); }

        // Mobile step 2 ("add your message") only exists in the stepper while the lock is picked: it is taken out
        // of the page otherwise, so the stepper (which counts its steps from the page) skips it.
        var messageStep = document.querySelector('[data-addons-message-step]');
        var messageAnchor = messageStep ? document.createComment('addons-message-step') : null;
        if (messageStep && messageStep.parentNode) messageStep.parentNode.insertBefore(messageAnchor, messageStep);
        if (messageStep) messageStep.remove();
        function lockPicked() {
          return Object.keys(state).some(function (id) { return products[id] && isEngravable(products[id]); });
        }
        function refreshStepper() {
          // the step counter (x/N) follows the number of steps on the page
          if (typeof updateContent === 'function') { try { updateContent(); } catch (e) {} }
        }
        function syncMessageStep() {
          if (!messageStep || !messageAnchor.parentNode) return;
          var attached = !!messageStep.parentNode;
          var want = lockPicked();
          if (want === attached) return;
          if (want) messageAnchor.parentNode.insertBefore(messageStep, messageAnchor.nextSibling);
          else messageStep.remove();
          render();
          refreshStepper();
        }

        // Show the same choice in the desktop and the mobile copy of the step.
        function render() {
          document.querySelectorAll('[data-addons-os] .addon-card-os').forEach(function (card) {
            var selected = !!state[idOf(card)];
            var engravable = card.getAttribute('data-engravable') === 'true';
            card.classList.toggle('is-selected', selected);
            var toggle = card.querySelector('[data-addon-toggle]');
            if (toggle) {
              toggle.textContent = engravable ? 'Engrave It' : (selected ? 'Added' : 'Add');
            }
          });
          // The engraving panels sit below the row of cards.
          document.querySelectorAll('[data-addons-os] [data-addon-panel]').forEach(function (panel) {
            var s = state[idOf(panel)];
            panel.hidden = !s;
            panel.querySelectorAll('[data-addon-engraving]').forEach(function (choice) {
              var isCustom = choice.getAttribute('value') === 'custom';
              var on = !!(s && s.engraving && ((isCustom && s.engraving.type === 'custom') ||
                (!isCustom && s.engraving.type === 'preset' && s.engraving.text === choice.getAttribute('data-text'))));
              choice.classList.toggle('is-selected', on);
              choice.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            var type = s && s.engraving && s.engraving.type;
            var custom = panel.querySelector('[data-addon-custom]');
            if (custom) custom.hidden = !type;
            var input = panel.querySelector('[data-addon-custom-input]');
            if (input) {
              // A preset fills the box (read only) so the chosen message is visible; "Write my own" empties it.
              input.readOnly = type === 'preset';
              if (type === 'preset') input.value = s.engraving.text;
              else if (type === 'custom' && input.value.trim() !== s.engraving.text) input.value = s.engraving.text;
              else if (!s) input.value = '';
            }
            var label = panel.querySelector('[data-addon-message-label]');
            if (label) label.textContent = type === 'preset' ? 'YOUR ENGRAVED MESSAGE' : 'ENGRAVED MESSAGE';
            var count = panel.querySelector('[data-addon-count]');
            if (count && input && input.maxLength > 0) {
              count.textContent = String(input.maxLength - input.value.length);
              if (count.parentNode) count.parentNode.hidden = type === 'preset';
            }
          });
          document.querySelectorAll('[data-addon-error]').forEach(function (node) { node.hidden = true; });
        }

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          var toggle = target.closest('[data-addon-toggle]');
          var remove = target.closest('[data-addon-remove]');
          if (!toggle && !remove) return;
          var card = cardOf(target);
          if (!card || !products[idOf(card)]) return;
          var id = idOf(card);
          var engravable = isEngravable(products[id]);
          var inMessageStep = !!(remove && remove.closest('[data-addons-message-step]'));
          if (remove || (toggle && state[id] && !engravable)) { delete state[id]; }
          else if (!state[id]) {
            var hasPresets = (config.presets || []).some(function (t) { return String(t).trim(); });
            state[id] = { engraving: (engravable && !hasPresets) ? { type: 'custom', text: '' } : null };
          }
          render();
          syncMessageStep();
          // Mobile: "Engrave It" goes on to step 2, "Remove" in step 2 goes back to step 1.
          if (toggle && engravable && toggle.closest('[data-context="mobile"]') && messageStep && messageStep.parentNode && typeof changeContent === 'function') {
            try { changeContent(1); } catch (e) {}
          } else if (inMessageStep && typeof changeContent === 'function') {
            try { changeContent(-1); } catch (e) {}
          }
        });

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          var choice = target.closest('[data-addon-engraving]');
          if (!choice) return;
          var card = cardOf(choice);
          if (!card || !state[idOf(card)]) return;
          var isCustom = choice.getAttribute('value') === 'custom';
          if (isCustom) {
            var typed = card.querySelector('[data-addon-custom-input]');
            var before = state[idOf(card)].engraving;
            // coming from a preset the box starts empty; coming from custom text it keeps what was typed
            state[idOf(card)].engraving = { type: 'custom', text: (before && before.type === 'custom' && typed) ? typed.value.trim() : '' };
          } else {
            state[idOf(card)].engraving = { type: 'preset', text: choice.getAttribute('data-text') };
          }
          render();
          if (isCustom) {
            var field = card.querySelector('[data-addon-custom-input]');
            if (field && field.offsetParent !== null) field.focus();
          }
        });

        document.addEventListener('input', function (event) {
          var input = event.target;
          if (!input || !input.matches || !input.matches('[data-addon-custom-input]')) return;
          var card = cardOf(input);
          if (!card || !state[idOf(card)]) return;
          state[idOf(card)].engraving = { type: 'custom', text: input.value.trim() };
          render();
        });

        window.PersonalizeAddons = {
          // Optional step: fine to continue with nothing picked. A picked product
          // that takes an engraving needs one.
          validate: function () {
            var ok = Object.keys(state).every(function (id) {
              return !(products[id] && isEngravable(products[id])) || hasEngraving(state[id]);
            });
            if (!ok) {
              // Show the message only in the copy of the step that is on screen.
              document.querySelectorAll('[data-addon-error]').forEach(function (node) {
                var host = node.closest('[data-addons-os]');
                node.hidden = !(host && host.offsetParent !== null);
              });
            }
            return ok;
          },
          getSelection: function () {
            return Object.keys(state).map(function (id) {
              var p = products[id] || {};
              var variant = (p.variants && p.variants[0]) || {};
              return { id: p.id, handle: p.handle, title: p.title, variantId: variant.id || null, engraving: state[id].engraving };
            });
          },
          // Items for the cart request, added next to the trunk by customformSubmission.
          // The engraving travels as the "Engraving" line item property.
          getCartItems: function () {
            return Object.keys(state).map(function (id) {
              var p = products[id];
              if (!p || p.noCart) return null;
              var variants = p.variants || [];
              var variant = variants.filter(function (v) { return v.available !== false; })[0] || variants[0];
              if (!variant || !variant.id) return null;
              var item = { id: variant.id, quantity: 1, properties: {} };
              if (isEngravable(p)) {
                if (!hasEngraving(state[id])) return null;
                item.properties['Engraving'] = state[id].engraving.text;
              }
              return item;
            }).filter(Boolean);
          },
          // An engravable product that cannot be a cart line of its own (the Draft demo "Lock" has no
          // variant) still keeps its message: it travels as a property of the trunk line,
          // e.g. "Lock message". A real product with a variant goes to the cart as its own line instead.
          getTrunkProperties: function () {
            var props = {};
            Object.keys(state).forEach(function (id) {
              var p = products[id];
              if (!p || !isEngravable(p) || !hasEngraving(state[id])) return;
              var sellable = (p.variants || []).some(function (v) { return v && v.id; });
              if (sellable && !p.noCart) return;
              props[String(p.title) + ' message'] = state[id].engraving.text;
            });
            return props;
          },
          reset: function () { state = {}; render(); syncMessageStep(); }
        };

        // addons_reveal_after_embroidery: on desktop the step shows a note until the embroidery
        // options are filled in (type, the words or the 3 monogram letters, and a font), then
        // reveals the products. On mobile the stepper already puts this step after the
        // embroidery steps.
        function embroideryDone() {
          var root = document.querySelector('.personalize-product-popup-section-os');
          if (!root) return false;
          var type = root.querySelector('input[name="properties[Embroidery Type]"]:checked');
          if (!type) return false;
          var font = root.querySelector('.custom-font-names-os');
          if (!font || !String(font.value || '').trim()) return false;
          if (type.value === 'Monogram') {
            var mono = root.querySelector('.monogram-text-value-os');
            return !!(mono && String(mono.value || '').replace(/\s/g, '').length === 3);
          }
          var words = root.querySelector('.printing-textarea-os');
          return !!(words && String(words.value || '').trim());
        }
        function updateDesktopStep() {
          var block = document.querySelector('.personalize-product-popup-addons-os');
          if (block) block.classList.toggle('is-locked', !embroideryDone());
        }
        var popupRoot = document.querySelector('.personalize-product-popup-section-os');
        if (popupRoot && config.revealAfterEmbroidery) {
          ['input', 'change', 'click'].forEach(function (type) {
            popupRoot.addEventListener(type, function () { setTimeout(updateDesktopStep, 60); });
          });
        }
        if (config.revealAfterEmbroidery) updateDesktopStep();

        if (!productId) { removeStep(); return; }

        function getJson(url) {
          return fetch(url, { headers: { Accept: 'application/json' } })
            .then(function (response) { return response.ok ? response.json() : {}; })
            .catch(function () { return {}; });
        }
        function usable(list) {
          var excluded = config.excludeHandles || [];
          return (list || []).filter(function (p) {
            if (!p || !p.available || String(p.id) === String(productId)) return false;
            if (excluded.indexOf(p.handle) !== -1) return false;
            // gift cards are never add-ons
            return String(p.type || p.product_type || '').toLowerCase() !== 'gift cards';
          });
        }
        // Collection products come in the storefront format (price as "35.00" dollars,
        // images[], no 'available'): bring them to the shape used above.
        function fromCollection(p) {
          var variants = (p.variants || []).map(function (v) { return { id: v.id, available: v.available !== false, price: v.price }; });
          var first = variants.filter(function (v) { return v.available; })[0] || variants[0] || {};
          var tags = Array.isArray(p.tags) ? p.tags : String(p.tags || '').split(',').map(function (t) { return t.trim(); });
          return {
            id: p.id, handle: p.handle, title: p.title, tags: tags, product_type: p.product_type || '',
            available: variants.some(function (v) { return v.available; }),
            price: Math.round(parseFloat(first.price || 0) * 100),
            featured_image: (p.images && p.images[0] && p.images[0].src) || '',
            variants: variants
          };
        }

        var base = '/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=' + encodeURIComponent(config.limit) + '&intent=';

        getJson(base + encodeURIComponent(config.intent))
          .then(function (data) {
            var own = usable(data.products);
            if (own.length || !config.collection) return own;
            return getJson('/collections/' + encodeURIComponent(config.collection) + '/products.json?limit=' + encodeURIComponent(config.limit))
              .then(function (collectionData) { return usable((collectionData.products || []).map(fromCollection)); });
          })
          .then(function (configured) {
            // The other personalizer trunks are offered too (not the one being personalized): picked
            // ones are added to the cart together with the current trunk.
            var handles = (config.trunkHandles || []).filter(function (h) { return h && h !== currentHandle; });
            return Promise.all(handles.map(function (h) { return getJson('/products/' + encodeURIComponent(h) + '.js'); }))
              .then(function (found) {
                var trunks = found.filter(function (p) { return p && p.id && p.available !== false && String(p.id) !== String(productId); })
                  .map(function (p) {
                    var variants = (p.variants || []).map(function (v) { return { id: v.id, available: v.available !== false, price: v.price }; });
                    return { id: p.id, handle: p.handle, title: p.title, price: p.price, featured_image: p.featured_image || (p.images && p.images[0]) || '', tags: [], variants: variants, available: true, trunk: true };
                  });
                return configured.concat(trunks);
              });
          })
          .then(function (list) {
            // Review aid, never shown to customers: on an UNPUBLISHED theme (Draft / preview link) a lock card
            // with the engraving options is shown until the real product exists (add ?addons_demo=0 to the
            // page address to hide it). It has no price and no variant, so it can never reach the cart.
            var demoOn = config.allowDemo && !/[?&]addons_demo=0(&|$)/.test(window.location.search);
            if (demoOn && !list.some(function (p) { return isEngravable(p); })) {
              var demoPrice = parseFloat(String(config.demoPrice || '').replace(/[^0-9.]/g, ''));
              list = [{ id: 'demo-lock', handle: 'demo-lock', title: 'Lock', price: demoPrice > 0 ? Math.round(demoPrice * 100) : null, available: true, featured_image: config.demoImage || '', tags: [config.engravableTag || 'engravable'], variants: [], noCart: true }].concat(list);
            }
            return { list: list };
          })
          .then(function (result) {
            var list = result.list;
            if (!list.length) { removeStep(); return; }
            list.forEach(function (p) { products[String(p.id)] = p; });
            // The add-on flow is a single Lock product on desktop and mobile.
            // Other trunk recommendations remain available in Shopify but are not rendered here.
            var visibleList = list.filter(isEngravable).slice(0, 1);
            if (!visibleList.length) { removeStep(); return; }
            roots.forEach(function (root) {
              var context = root.getAttribute('data-context') || 'x';
              // desktop: card + message; mobile step 1: the card only; mobile step 2: the message only
              var track = root.querySelector('[data-addons-track]');
              if (track) {
                visibleList.forEach(function (p, index) { track.appendChild(buildCard(p, context, index + 1)); });
                var dots = root.querySelector('[data-addons-dots]');
                if (dots && visibleList.length > 1) { buildDots(track, dots); }
              }
              var area = root.querySelector('[data-addons-engrave-area]');
              if (area) visibleList.forEach(function (p) { area.appendChild(buildPanel(p, context)); });
            });
            syncMessageStep();
          })
          .catch(function () { removeStep(); });
      } catch (error) {
        console.warn('Personalizer add-ons step failed to start', error);
        try { document.querySelectorAll('[data-addons-step], [data-addons-message-step], .personalize-product-popup-addons-os').forEach(function (node) { node.remove(); }); } catch (e) {}
      }
    })();
  </script>
{%- endif -%}
