{% comment %}
  Inputs:
    - "id" for a11y
    - "type" lets you set use case between "cart" or "product"
    - "value" for default quantity
{% endcomment %}

{%- liquid
  assign minus_t = 'cart.minus' | t
  assign plus_t = 'cart.plus' | t
  assign quantity_t = 'cart.quantity' | t
  assign remove_t = 'cart.remove' | t

  if value == blank
    assign value = 1
  endif

  assign label_type = 'hidden-text'
  if type == 'product'
    assign label_type = 'accent-text'
  endif
-%}



{%- assign product_variant_id = lineItems.variant_id -%}
{%- assign personalize_it_variant_id = lineItems.properties.personalize_it_variant_id -%}
{%- assign product_key = lineItems.key -%}
{%- assign embroidery_type = lineItems.properties['Embroidery Type'] -%}


{% if personalize_it_variant_id == blank %}
  <quantity-selector class="quantity-selector--root" data-id="{{ id }}" data-type="{{ type }}">
    <label for="{{ id }}" data-item="{{ label_type }}">
      {{- quantity_t -}}
    </label>
  
    <div class="quantity-selector--container">
      <button
        type="button"
        class="quantity-selector--minus"
        tabindex="0"
        aria-role="button"
        aria-label="{{ minus_t }}"
      >
        {%- render 'icons', icon: 'minus' -%}
      </button>
      <input
        class="quantity-selector--input"
        id="{{ id }}"
        type="text"
        name="quantity"
        value="{{ value }}"
        min="1"
        pattern="[0-9]*"
        tabindex='-1'
        data-loading="false"
      />
      <button
        type="button"
        class="quantity-selector--plus"
        tabindex="0"
        aria-role="button"
        aria-label="{{ plus_t }}"
      >
        {%- render 'icons', icon: 'plus' -%}
      </button>
    </div>
  
    {%- if type == 'cart' -%}
      <div class="quantity-selector--remove" data-item='block-link'>
        <span tabindex="0" aria-label="{{ remove_t }}" title="{{ remove_t }}">
          {{- remove_t -}}
        </span>
      </div>
    {%- endif -%}
  
  </quantity-selector>
  
  {% else %}
    <div class="custom-quantity-selector-os">
      <div class="quantity-selector--container">
        <button
          type="button"
          class="quantity-selector--minus quantity-selector--minus-os"
          onClick="handleSubtractQuantity('{{ product_key }}', '{{ personalize_it_variant_id }}', this)"
        >
          {%- render 'icons', icon: 'minus' -%}
        </button>
        <input
          class="quantity-selector--input quantity-selector--input-os"
          type="text"
          name="quantity"
          value="{{ value }}"
          min="1"
          pattern="[0-9]*"
          tabindex='-1'
          data-loading="false"
          onchange="handleQuantityInputChange('{{ product_key }}', '{{ personalize_it_variant_id }}', event)"
        />
        <button
          type="button"
          class="quantity-selector--plus quantity-selector--plus-os"
          aria-role="button"
          onClick="handleAdditionQuantity('{{ product_key }}', '{{ personalize_it_variant_id }}', this)"
        >
          {%- render 'icons', icon: 'plus' -%}
        </button>
      </div>
      
      <div class="quantity-selector--remove-os">
          <!-- <span title="Remove">Remove</span> -->
          <button type="button" title="Remove" onClick="handleRemoveProduct('{{ product_key }}', '{{ personalize_it_variant_id }}', this)">Remove</button>
      </div>
    </div>
{% endif %}