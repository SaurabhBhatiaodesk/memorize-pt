
  <!-- Link Swiper's CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <!-- Demo styles -->
  <style>
    .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 12px;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    .swiper {
      width: 100%;
      height: 300px;
      margin-left: auto;
      margin-right: auto;
    }

    .swiper-slide {
      background-size: cover;
      background-position: center;
    }

    .mySwiper2 {
      height: auto;
      width: 100%;
      /* margin-left: auto;
      margin-right: auto; */
      margin-bottom: auto;
      height:100%;
    }
    .mySwiper {
    height: 100%;
    width: 80px;
    box-sizing: border-box;
    padding: 10px 0;
    display: flex;
    flex-direction: column;
}

    .mySwiper .swiper-slide {
      width: 100%;
      height: 70px !important;
      /* opacity: 0.7; */
      margin-bottom: 10px;
      cursor: pointer;
    }

    .mySwiper .swiper-slide-thumb-active {
      opacity: 1;
    }

    .sdev_coder_slider_container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-direction: row-reverse;
      height: 80vh;
      max-width: 100%;
      margin: 0 auto;
      gap: 2rem;
    }
  .swiper-slide.custom-images-os.hide-os {
    display: block !important;
}
  .swiper-button-next:after, .swiper-rtl .swiper-button-prev:after,
  .swiper-button-prev:after, .swiper-rtl .swiper-button-next:after{
    font-size: 20px !important;
    font-weight: bold !important;
    color: navy;
  }
  .swiper-button-next, .swiper-button-prev {
    background: #fff;
    border-radius: 30px;
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
}
  </style>
  <!-- Swiper -->
  <div class="sdev_coder_slider_container {{product.handle}}">
    <div style="--swiper-navigation-color: #fff; --swiper-pagination-color: #fff" class="swiper mySwiper2">
      <div class="swiper-wrapper">
     {%- for media in product.media -%}
            <div class="swiper-slide">
             <img src="{{media |img_url:''}}" />
            </div>
      {% endfor %}
      <!-- Custom images starts -->
      <div class="swiper-slide">
        <div class="custom-images-os main-product-image-container">
          <img class="main-trunk-image-os" src="https://memorizeyourlife.com/cdn/shop/files/White-Trunk.png?v=1733382579" alt="Trunk Image" />
          <img class="main-fabric-image-os" src="https://memorizeyourlife.com/cdn/shop/files/The_Eyes_Have_It.png?v=1731479188" alt="Fabric Image" />
          <h4 class="textarea-text-display-os"></h4>
          <h4 class="monogram-text-display-os"></h4>
        </div>
      </div>
      <!-- Custom images ends -->
      </div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
    <div thumbsSlider="" class="swiper mySwiper">
    <div class="swiper-wrapper">
      {%- for media in product.media -%}
        <div class="swiper-slide">
          <img src="{{media |img_url:''}}" />
        </div>
       {% endfor %}
      <!-- Custom images starts -->
      <div class="swiper-slide">
        <div class="custom-images-os" id="sdev_thumbnail_img">
          <img class="main-trunk-image-os" src="https://memorizeyourlife.com/cdn/shop/files/White-Trunk.png?v=1733382579" alt="Trunk Image" />
          <img class="main-fabric-image-os" src="https://memorizeyourlife.com/cdn/shop/files/The_Eyes_Have_It.png?v=1731479188" alt="Fabric Image" />
          <h4 class="textarea-text-display-os"></h4>
          <h4 class="monogram-text-display-os"></h4>
        </div>
      </div>
      <!-- Custom images ends -->
      </div>
    </div>
  </div>

  
  <!-- Swiper JS -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper(".mySwiper", {
      spaceBetween: 10,
      slidesPerView: 9,  // Show 9 thumbnails
      freeMode: true,
      watchSlidesProgress: true,
      // loop: true,
      direction: "vertical", // Vertical navigation for thumbnails
    });

    var swiper2 = new Swiper(".mySwiper2", {
      spaceBetween: 10,
      // loop: true,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      thumbs: {
        swiper: swiper,
      }, 
      speed: 600, 
    });

  </script>