{% style %}
.header--cart-toggle::after {
  display: none;
}
{% endstyle %}

{%- liquid
  assign cart_t = 'layout.header.cart' | t
  assign cart_count = 0

  for item in cart.items
    unless item.product_id == 7351943430217
      assign cart_count = cart_count | plus: item.quantity
    endunless
  endfor

  capture cart_icon
    if cart_icon == "bag"
      render 'icons', icon: 'bag'
    elsif cart_icon == "cart"
      render 'icons', icon: 'cart'
    elsif cart_icon == "text"
      echo 'cart.title' | t
    endif
  endcapture
-%}

<a
  class="header--cart-toggle"
  aria-label="{{ cart_t }}"
  data-cart-count="{{ cart_count }}"
  {% if settings.cart--type == 'drawer' %}
    data-drawer-open="right"
    data-drawer-view="cart-drawer"
    aria-haspopup="menu"
    href="#"
  {% else %}
    href="{{ routes.cart_url }}"
  {% endif %}
>
  {{ cart_icon }}
  <span class="header-cart-counter header-cart-counter-os">{{ cart_count }}</span>
</a>

<noscript>
  <a
    class="header--cart-toggle"
    aria-label="{{ cart_t }}"
    href="{{ routes.cart_url }}"
    data-cart-count="{{ cart_count }}"
  >
    {{ cart_icon }}
  </a>
</noscript>
