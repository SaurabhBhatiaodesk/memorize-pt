    ...cartLineItemsData.filter(item => item.product_id === 7351943430217)   // id=5 and id=6 at the end
  ];

  // console.log("cartLineItemsData :::", cartLineItemsData);
  // console.log("updatedData ::", updatedData);

  // Create a map for quick lookup of cart items by variant_id
  let cartItemsMap = cartLineItemsData.reduce((map, item) => {
