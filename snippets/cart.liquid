<script>
  // This snippet is rendered twice per page (desktop + mobile views), which
  // duplicates this whole script block. Guard so the popup logic below
  // (and its click listener) only initializes once instead of twice.
  if (!window.__cartPreviewPopupScriptInitialized) {
  window.__cartPreviewPopupScriptInitialized = true;
  function showPopup(element) {
    // Find the parent list item and the associated popup
    const popupListItem = element.closest('.preview-image-popup-list-os');
    const popup = popupListItem.querySelector('.preview-image-popup-section-os');

    if (popup) {
      popup.style.display = 'block'; // Show the popup
      setTimeout(() => {
        popup.classList.add('show'); // Add show class for transition effect
      }, 10); // Delay to allow display block to take effect
    }
  }

  function hidePopup(event) {
    // Check if the click is on the popup backdrop (the section)
    const popup = event.currentTarget.closest('.preview-image-popup-section-os');
    if (popup) {
      popup.classList.remove('show'); // Remove the show class
      setTimeout(() => {
        popup.style.display = 'none'; // Hide the popup after transition
      }, 500); // Match this duration with your CSS transition duration
    }
  }

  // Adding event listener to close popup when clicking outside
  document.addEventListener('click', function(event) {
    // Check if the clicked element is a popup section
    const popup = event.target.closest('.preview-image-popup-section-os');
    if (!popup && event.target.matches('.preview-image-popup-list-os *')) {
      // If the click was outside the popup content and inside the list item, do nothing
      return;
    }
    
    // If click was outside of any popups, close all
    document.querySelectorAll('.preview-image-popup-section-os.show').forEach(openPopup => {
      hidePopup({ currentTarget: openPopup });
    });
  });
  }
</script>





<script>
  // This snippet is rendered twice per page (desktop + mobile views), which
  // duplicates this whole script block verbatim. Top-level `let`/`const`
  // declared in one classic script tag share the page's single script
  // scope with every other classic script tag, so the second copy of this
  // block threw "Identifier 'cartLineItemsData' has already been declared"
  // and its entire body silently never ran. Guard so it only runs once;
  // functions declared inside (handleAdditionQuantity, etc.) are still
  // reachable from onclick="..." attributes in the markup because function
  // declarations inside a block are hoisted to the global scope in classic
  // (non-strict, non-module) scripts.
  if (!window.__cartMainScriptInitialized) {
  window.__cartMainScriptInitialized = true;
  // Parse cart items data from Liquid
  let cartLineItemsData = {{ cart.items | json }};
  const final_items_array = {{ final_items_array | json }};
