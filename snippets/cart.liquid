    return map;
  }, {});

  let cartUpdateInProgress = false;
  // console.log("cartItemsMap :::", cartItemsMap);

  // Make all increment, decrement, input and remove button disabled starts
  function disableCartInputs() {
    // Get all cart items
    const cartItems = document.querySelectorAll('.cart--item');
  
    // Loop through each cart item
    cartItems.forEach(item => {
      // Disable the quantity input
      const quantityInput = item.querySelector('.quantity-selector--input');
      if (quantityInput) {
        quantityInput.disabled = true;
      }
  
      // Disable the plus and minus buttons
      const plusButton = item.querySelector('.quantity-selector--plus');
      const minusButton = item.querySelector('.quantity-selector--minus');
      if (plusButton) {
        plusButton.disabled = true;
      }
      if (minusButton) {
        minusButton.disabled = true;
      }
  
      // Disable the "Remove" button inside quantity-selector--remove-os
      const removeButton = item.querySelector('.quantity-selector--remove-os button');
      if (removeButton) {
        removeButton.disabled = true;
      }
  
      // Disable the "Remove" span inside quantity-selector--remove
      const removeSpan = item.querySelector('.quantity-selector--remove span');
      if (removeSpan) {
        // Disable the span by adding a 'disabled' class
        removeSpan.classList.add('disabled-default-cart-remove-button');
        
        // Disable the parent div to prevent interaction as well
        const removeDiv = item.querySelector('.quantity-selector--remove');
        if (removeDiv) {
          removeDiv.classList.add('disabled-default-cart-remove-button');  // Disable the entire div as well
        }
      }
    });
  }
  // Make all increment, decrement, input and remove button disabled ends 

  // Utility function to parse and validate inputs
  const parseAndValidateCartLineItemsData = (main_product_key, personalize_it_variant_id) => {
    const productKeyString = main_product_key;
    const personalizeItVariantIdNumber = Number(personalize_it_variant_id);
    // const quantityNumber = Number(quantity);
    
    // console.log("parseAndValidateCartLineItemsData productKeyString ::", productKeyString);
    // console.log("parseAndValidateCartLineItemsData personalizeItVariantIdNumber ::", personalizeItVariantIdNumber);

    console.log("Parsed CartLineItemsData:", {
      productKeyString,
      personalizeItVariantIdNumber,
    });

    // Validate product key as string
    if(typeof productKeyString !== "string" || productKeyString.trim() === "") {
      throw new Error("Invalid input: product key must be a non-empty string.");
    }

    if (isNaN(personalizeItVariantIdNumber)) {
      throw new Error('Invalid input: variant IDs must be numbers.');
    }

    const mainProduct = cartItemsMap[productKeyString];
    // const personalizeItProduct = cartItemsMap[personalizeItVariantIdNumber];
    const personalizeItProduct = cartLineItemsData.find(item => item.variant_id === personalizeItVariantIdNumber);

    // console.log("Main Product:", mainProduct);
    // console.log("Personalize It Product:", personalizeItProduct);

    if (!mainProduct) {
      throw new Error('Main product not found in the cart.');
    }

    if (!personalizeItProduct) {
      throw new Error('Personalize It product not found in the cart.');
    }

    return { mainProduct, personalizeItProduct };
  };


  function enableCartInputs() {
    document.querySelectorAll('.cart--item').forEach(item => {
      item.querySelectorAll('input, button').forEach(control => {
        control.disabled = false;
      });

      item.querySelectorAll('.disabled-default-cart-remove-button').forEach(control => {
        control.classList.remove('disabled-default-cart-remove-button');
      });
    });
  }

  function formatCartMoney(cents) {
    if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
      return window.Shopify.formatMoney(cents);
    }

    return new Intl.NumberFormat(document.documentElement.lang || 'en', {
      style: 'currency',
      currency: {{ cart.currency.iso_code | default: shop.currency | json }}
    }).format((Number(cents) || 0) / 100);
  }

  const CUSTOM_EMBROIDERY_PRODUCT_ID = 7351943430217;

  function getRequiredEmbroideryQuantities(cartItems) {
    const requiredByVariantId = {};

    (cartItems || []).forEach(item => {
      if (Number(item.product_id) === CUSTOM_EMBROIDERY_PRODUCT_ID) return;

      const properties = item.properties || {};
      const embroideryVariantId = Number(
        properties.personalize_it_variant_id ||
        properties._embroidery_variant_id ||
        0
      );

      if (!embroideryVariantId) return;

      requiredByVariantId[embroideryVariantId] =
        (requiredByVariantId[embroideryVariantId] || 0) +
        Math.max(Number(item.quantity) || 0, 0);
    });

    return requiredByVariantId;
  }

  async function removeOrphanEmbroideryCharges(cartData) {
    const cartItems = Array.isArray(cartData?.items) ? cartData.items : [];
    const requiredByVariantId = getRequiredEmbroideryQuantities(cartItems);
    const embroideryGroups = {};

    cartItems.forEach(item => {
      if (Number(item.product_id) !== CUSTOM_EMBROIDERY_PRODUCT_ID) return;

      const variantId = Number(item.variant_id);
      if (!embroideryGroups[variantId]) {
        embroideryGroups[variantId] = [];
      }

      embroideryGroups[variantId].push(item);
    });

    const updates = {};

    Object.entries(embroideryGroups).forEach(([variantId, embroideryItems]) => {
      const requiredQuantity = Math.max(
        Number(requiredByVariantId[Number(variantId)]) || 0,
        0
      );

      embroideryItems.forEach((item, index) => {
        const expectedQuantity = index === 0 ? requiredQuantity : 0;
        const currentQuantity = Math.max(Number(item.quantity) || 0, 0);

        if (item.key && currentQuantity !== expectedQuantity) {
          updates[item.key] = expectedQuantity;
        }
      });
    });

    if (Object.keys(updates).length === 0) {
      return cartData;
    }

    const response = await fetch(
      `${window.Shopify.routes.root}cart/update.js`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ updates })
      }
    );

    if (!response.ok) {
      throw new Error(
        `Embroidery cart cleanup failed with status ${response.status}`
      );
    }

    return await response.json();
  }

  function syncCartUI(cartData) {
    const safeItems = Array.isArray(cartData?.items) ? cartData.items : [];
    const itemCount = safeItems.reduce((count, item) => {
      if (Number(item?.product_id) === CUSTOM_EMBROIDERY_PRODUCT_ID) return count;
      return count + Math.max(Number(item?.quantity) || 0, 0);
    }, 0);
    const totalPrice = Math.max(Number(cartData?.total_price) || 0, 0);

    const itemsByKey = safeItems.reduce((map, item) => {
      if (item?.key) map[String(item.key)] = item;
      return map;
    }, {});

    updateHeaderCartCount(itemCount);

    const cartRoot = document.querySelector('cart-root');
    const cartForm = cartRoot?.querySelector('.cart--form');
    const cartBody = cartRoot?.querySelector('.cart--body');
    const emptyCartMessage = cartRoot?.querySelector('.cart--no-items');

    if (cartRoot) {
      cartRoot.dataset.hasItems = itemCount > 0 ? 'true' : 'false';
    }

    if (itemCount === 0) {
      if (cartBody) cartBody.innerHTML = '';

      if (cartForm) {
        cartForm.hidden = true;
        cartForm.style.display = 'none';
      }

      if (emptyCartMessage) {
        emptyCartMessage.hidden = false;
        emptyCartMessage.style.display = '';
      }

      const totalPriceElement = document.querySelector('.cart--total--price');
      if (totalPriceElement) {
        totalPriceElement.textContent = formatCartMoney(0);
      }

      return;
    }

    if (cartForm) {
      cartForm.hidden = false;
      cartForm.style.removeProperty('display');
    }

    if (emptyCartMessage) {
      emptyCartMessage.hidden = true;
      emptyCartMessage.style.display = 'none';
    }

    document
      .querySelectorAll('.cart--item[data-item-key]')
      .forEach(cartItemElement => {
        const itemKey = String(cartItemElement.dataset.itemKey || '');
        const lineItem = itemsByKey[itemKey];

        if (!lineItem || Number(lineItem.quantity) <= 0) {
          cartItemElement.remove();
          return;
        }

        cartItemElement.dataset.quantity = String(lineItem.quantity);

        const newLineNumber =
          safeItems.findIndex(item => String(item?.key || '') === itemKey) + 1;

        if (newLineNumber > 0) {
          cartItemElement.dataset.lineNum = String(newLineNumber);
          cartItemElement.dataset.line = String(newLineNumber);
        }

        const quantityInput = cartItemElement.querySelector(
          '.quantity-selector--input, input[name^="updates"]'
        );
        if (quantityInput) quantityInput.value = lineItem.quantity;

        const priceElement = cartItemElement.querySelector(
          '.cart--item--price .money[data-item="accent-text"], .cart--item--price > .money'
        );
        if (priceElement) {
          priceElement.textContent = formatCartMoney(lineItem.final_price);
        }

        const totalElement = cartItemElement.querySelector(
          '.cart--item--total > .money, .cart--item--total.money'
        );
        if (totalElement) {
          totalElement.textContent = formatCartMoney(lineItem.final_line_price);
        }
      });

    const totalPriceElement = document.querySelector('.cart--total--price');
    if (totalPriceElement) {
      totalPriceElement.textContent = formatCartMoney(totalPrice);
    }
  }

  function getCustomerFacingCartCount(cartData) {
    const safeItems = Array.isArray(cartData?.items) ? cartData.items : [];

    return safeItems.reduce((count, item) => {
      if (Number(item?.product_id) === CUSTOM_EMBROIDERY_PRODUCT_ID) return count;
      return count + Math.max(Number(item?.quantity) || 0, 0);
    }, 0);
  }

  function updateHeaderCartCount(count) {
    document.querySelectorAll('[data-cart-count]').forEach((element) => {
      element.setAttribute('data-cart-count', count);
    });

    document.querySelectorAll('.header-cart-counter-os').forEach((element) => {
      element.textContent = count;
    });
  }

  async function fetchCurrentCartJson() {
    const response = await fetch(
      `${window.Shopify.routes.root}cart.js`,
      {
        method: 'GET',
        headers: {
          'Accept': 'application/json'
        },
        cache: 'no-store'
      }
    );

    if (!response.ok) {
      throw new Error(`Cart fetch failed with status ${response.status}`);
    }

    return await response.json();
  }

  async function refreshCartSectionAjax(cartData) {
    const currentCartRoot = document.querySelector('cart-root');

    if (!currentCartRoot) {
      syncCartUI(cartData);
      return;
    }

    const currentView = currentCartRoot.dataset.view || 'desktop';
    const ajaxUrl =
      `${window.Shopify.routes.root}cart?view=ajax-${encodeURIComponent(currentView)}` +
      `&_=${Date.now()}`;

    const response = await fetch(ajaxUrl, {
      method: 'GET',
      headers: {
        'Accept': 'text/html',
        'X-Requested-With': 'XMLHttpRequest'
      },
      cache: 'no-store'
    });

    if (!response.ok) {
      throw new Error(
        `Cart section refresh failed with status ${response.status}`
      );
    }

    const html = await response.text();
    const parsedDocument = new DOMParser().parseFromString(
      html,
      'text/html'
    );

    const freshCartRoot =
      parsedDocument.querySelector(
        `cart-root[data-view="${CSS.escape(currentView)}"]`
      ) ||
      parsedDocument.querySelector('cart-root');

    if (!freshCartRoot) {
      syncCartUI(cartData);
      return;
    }

    currentCartRoot.replaceWith(freshCartRoot);
    updateHeaderCartCount(getCustomerFacingCartCount(cartData));

    document.dispatchEvent(
      new CustomEvent('cart:ajax-rendered', {
        detail: {
          cart: cartData,
          view: currentView
        }
      })
    );
  }

  function removeCartRowImmediately(itemKey) {
    const normalizedKey = String(itemKey || '');

    document
      .querySelectorAll('.cart--item[data-item-key]')
      .forEach(cartItem => {
        if (String(cartItem.dataset.itemKey || '') === normalizedKey) {
          cartItem.remove();
        }
      });
  }

  // Update cart through Shopify AJAX and replace the cart section
  // with fresh server-rendered markup. No browser refresh is used.
  const updateCart = async (updates) => {
    if (cartUpdateInProgress) return;

    cartUpdateInProgress = true;
    disableCartInputs();

    try {
      console.log("cartProductUpdates :::", updates);

      const response = await fetch(`${window.Shopify.routes.root}cart/update.js`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ updates })
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      let data = await response.json();
      data = await removeOrphanEmbroideryCharges(data);

      console.log('Cart updated successfully:', data);

      cartLineItemsData = data.items || [];
      cartItemsMap = cartLineItemsData.reduce((map, item) => {
        map[item.key] = item;
        return map;
      }, {});

      await refreshCartSectionAjax(data);
    } catch (error) {
      console.error('Error updating cart:', error);

      try {
        let currentCart = await fetchCurrentCartJson();
        currentCart = await removeOrphanEmbroideryCharges(currentCart);

        cartLineItemsData = currentCart.items || [];
        cartItemsMap = cartLineItemsData.reduce((map, item) => {
          map[item.key] = item;
          return map;
        }, {});

        await refreshCartSectionAjax(currentCart);
      } catch (recoveryError) {
        console.error('Cart AJAX recovery failed:', recoveryError);
      }

      alert('There was an error updating your cart. Please try again.');
    } finally {
      cartUpdateInProgress = false;
      enableCartInputs();
    }
  };

  // Handler to subtract quantity
  const handleSubtractQuantity = (main_product_key, personalize_it_variant_id, buttonElement) => {
    console.log("handleSubtractQuantity is working -----");
    try {
      // console.log("handleSubtractQuantity buttonElement", buttonElement);
      buttonElement.disabled = true;
      const { mainProduct, personalizeItProduct } = parseAndValidateCartLineItemsData(main_product_key, personalize_it_variant_id);

      const updates = {
        [mainProduct.key]: Math.max(mainProduct.quantity - 1, 0),
        [personalizeItProduct.key]: Math.max(personalizeItProduct.quantity - 1, 0)
      };

      console.log('handleSubtractQuantity updates :', updates);
      

      updateCart(updates);
    } catch (error) {
      console.error('Error in handleSubtractQuantity:', error);
      alert(error.message);
    }
  };

  // Handler to add quantity
  const handleAdditionQuantity = (main_product_key, personalize_it_variant_id, buttonElement) => {
    console.log("handleAdditionQuantity is working -----");
    try {
      console.log("handleAdditionQuantity buttonElement", buttonElement);
      buttonElement.disabled = true;
      const { mainProduct, personalizeItProduct } = parseAndValidateCartLineItemsData(main_product_key, personalize_it_variant_id);

      const updates = {
        [mainProduct.key]: mainProduct.quantity + 1,
        [personalizeItProduct.key]: personalizeItProduct.quantity + 1
      };

      updateCart(updates);
    } catch (error) {
      console.error('Error in handleAdditionQuantity:', error);
      alert(error.message);
    }
  };


  function buildRemoveProductAndEmbroideryUpdates(mainProductKey) {
    const normalizedMainProductKey = String(mainProductKey || '').trim();
    const mainProduct = cartItemsMap[normalizedMainProductKey];

    if (!mainProduct) {
      throw new Error('Main product not found in the cart.');
    }

    const updates = {
      [mainProduct.key]: 0
    };

    // Calculate how many embroidery charge units are still required
    // after this exact main product has been removed.
    const remainingRequiredByVariantId = {};

    cartLineItemsData.forEach(item => {
      if (
        !item ||
        String(item.key || '') === normalizedMainProductKey ||
        Number(item.product_id) === CUSTOM_EMBROIDERY_PRODUCT_ID
      ) {
        return;
      }

      const properties = item.properties || {};
      const embroideryVariantId = Number(
        properties.personalize_it_variant_id ||
        properties._embroidery_variant_id ||
        0
      );

      if (!embroideryVariantId) {
        return;
      }

      remainingRequiredByVariantId[embroideryVariantId] =
        (remainingRequiredByVariantId[embroideryVariantId] || 0) +
        Math.max(Number(item.quantity) || 0, 0);
    });

    // Remove orphan/duplicate embroidery lines in the same AJAX request.
    const processedEmbroideryVariants = {};

    cartLineItemsData.forEach(item => {
      if (
        !item ||
        Number(item.product_id) !== CUSTOM_EMBROIDERY_PRODUCT_ID ||
        !item.key
      ) {
        return;
      }

      const variantId = Number(item.variant_id);
      const requiredQuantity = Math.max(
        Number(remainingRequiredByVariantId[variantId]) || 0,
        0
      );

      if (!processedEmbroideryVariants[variantId]) {
        updates[item.key] = requiredQuantity;
        processedEmbroideryVariants[variantId] = true;
      } else {
        updates[item.key] = 0;
      }
    });

    return {
      mainProduct,
      updates
    };
  }

  function removeUpdatedRowsImmediately(updates) {
    Object.entries(updates || {}).forEach(([itemKey, quantity]) => {
      if (Number(quantity) === 0) {
        removeCartRowImmediately(itemKey);
      }
    });
  }

  // Handler to remove products
  const handleRemoveProduct = (
    main_product_key,
    personalize_it_variant_id,
    buttonElement
  ) => {
    console.log("handleRemoveProduct is working -----");

    try {
      if (buttonElement) {
        buttonElement.disabled = true;
      }

      const {
        mainProduct,
        updates
      } = buildRemoveProductAndEmbroideryUpdates(main_product_key);

      console.log(
        'Removing main product and embroidery charges:',
        {
          mainProductKey: mainProduct.key,
          personalizeItVariantId: personalize_it_variant_id,
          updates
        }
      );

      // Remove the main product and any embroidery row whose final
      // quantity is zero immediately, then confirm with Shopify AJAX.
      removeUpdatedRowsImmediately(updates);
      updateCart(updates);
    } catch (error) {
      console.error('Error in handleRemoveProduct:', error);
      alert(error.message);
    }
  };

  

  // Handler to input quantity of products
  const handleQuantityInputChange = (main_product_key, personalize_it_variant_id, event) => {
      if (!event || event.isTrusted === false || cartUpdateInProgress) return;

      const quantityValue = parseInt(event.target.value, 10);
      const quantityInputElement = event.target;
      console.log("handleQuantityInputChange event ::", event);
      console.log("handleQuantityInputChange event.target ::", event.target);
      quantityInputElement.disabled = true;
    
      // // Input validation
      // if (isNaN(quantityValue) || quantityValue < 1) {
      //   alert('Please enter a valid positive quantity.');
      //   return;
      // }

     try {
        const { mainProduct, personalizeItProduct } = parseAndValidateCartLineItemsData(main_product_key, personalize_it_variant_id);

        if (quantityValue === mainProduct.quantity) {
          quantityInputElement.disabled = false;
          return;
        }

        let mainProductQuantityDifference;
        let finalPersonalizeQuantity;
        // Calculate the difference depending on whether the quantity increased or decreased
        if (mainProduct.quantity >= quantityValue) {
          // console.log("mainProduct.quantity >= quantityValue ifff ----");
          mainProductQuantityDifference = mainProduct.quantity - quantityValue;
          finalPersonalizeQuantity = personalizeItProduct.quantity - mainProductQuantityDifference;
        } else {
          // console.log("mainProduct.quantity >= quantityValue else ----");
          mainProductQuantityDifference = quantityValue - mainProduct.quantity;
          finalPersonalizeQuantity = personalizeItProduct.quantity + mainProductQuantityDifference;
        }
        const updates = {
          [mainProduct.key]: quantityValue,
          [personalizeItProduct.key]: finalPersonalizeQuantity,
        };
        // console.log("handleQuantityInputChange mainProduct ::", mainProduct);
        // console.log("handleQuantityInputChange personalizeItProduct ::", personalizeItProduct);
        console.log("handleQuantityInputChange mainProduct.quantity ::", mainProduct.quantity);
        console.log("handleQuantityInputChange personalizeItProduct.quantity ::", personalizeItProduct.quantity);
        console.log("handleQuantityInputChange quantityValue ::", quantityValue);
        console.log("handleQuantityInputChange mainProductQuantityDifference ::", mainProductQuantityDifference);
        console.log("handleQuantityInputChange finalPersonalizeQuantity ::", finalPersonalizeQuantity);
        console.log("handleQuantityInputChange updates ::", updates);
  
        updateCart(updates);
    } catch (error) {
        console.error('Error in handleRemoveProduct:', error);
        alert(error.message);
    }
  };


  async function validateCartAfterPageLoad() {
    try {
      const response = await fetch(
        `${window.Shopify.routes.root}cart.js`,
        {
          method: 'GET',
          headers: {
            'Accept': 'application/json'
          },
          cache: 'no-store'
        }
      );

      if (!response.ok) {
        throw new Error(`Cart validation failed with status ${response.status}`);
      }

      let cartData = await response.json();
      cartData = await removeOrphanEmbroideryCharges(cartData);

      cartLineItemsData = cartData.items || [];
      cartItemsMap = cartLineItemsData.reduce((map, item) => {
        map[item.key] = item;
        return map;
      }, {});

      await refreshCartSectionAjax(cartData);
    } catch (error) {
      console.error('Cart validation error:', error);
    }
  }

  document.addEventListener('DOMContentLoaded', validateCartAfterPageLoad);
  window.addEventListener('pageshow', event => {
    if (event.persisted) {
      validateCartAfterPageLoad();
    }
  });
  }
</script>

