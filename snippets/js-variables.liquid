function scrollNext(selector)
{
  var itemList = document.querySelector(selector);
  if(itemList)
  { 
    var scrollValue = itemList.offsetWidth;var max = itemList.scrollWidth;var leftScroll = itemList.scrollLeft;var scrolledNow = leftScroll+scrollValue;
    
    itemList.scrollBy({ left: scrollValue, top: 0, behavior: 'smooth' }); 

    var mainSelector = document.querySelector('.justAWrapper:has('+selector+')');
    if(mainSelector)
    {
 mainSelector.querySelector('button.prev.nextArrow').classList.remove('hide');


var lastElement = mainSelector.querySelector('.wrapperToMakeSlider div.radios--main:last-child');
var whereNow =  scrolledNow+lastElement.clientWidth + 10;
var itemPositionLeft = lastElement.offsetLeft;
      
      console.log(whereNow >= itemPositionLeft);
      console.warn( whereNow + " - " + itemPositionLeft);
      
 if(scrolledNow >= max || whereNow >= itemPositionLeft){
  mainSelector.querySelector('button.next.nextArrow').classList.add('hide');    
 }
    }
    
  }
}

function scrollPrev(selector)
{
  var itemList = document.querySelector(selector);
  if(itemList)
  { 
    var scrollValue = (-itemList.offsetWidth);var max = itemList.scrollWidth;var leftScroll = itemList.scrollLeft;var scrolledNow = leftScroll+scrollValue;
    itemList.scrollBy({ left: scrollValue, top: 0, behavior: 'smooth' }) 
 
  
  
  var mainSelector = document.querySelector('.justAWrapper:has('+selector+')');
    if(mainSelector)
    {
 mainSelector.querySelector('button.next.nextArrow').classList.remove('hide');

 
 if(scrolledNow <= 0){
  mainSelector.querySelector('button.prev.nextArrow').classList.add('hide');    
 }
    } 
  }
}

  function removeSlider(selector)
    {
      var element = document.querySelector(selector); 
      if(element)element.classList.remove('wrapperToMakeSlider');
    }  
  function makeSlider(selector)
    {
      var element = document.querySelector(selector); 
      if(element)element.classList.add('wrapperToMakeSlider');
    }

function redirectToPageWithOptions(url)
  {    
    var option1Text="",option2Text=""; 
    
    var allOptions = document.querySelectorAll('product-options-root.product-options--root .product-options--option');
    for(var i=0; i<allOptions.length; i++)
      {
        var temp = allOptions[i].querySelector('.radios--input:checked+.radios--value-button div').textContent;

        if(i==0)
        {
          option1Text = temp;
        }else if(i==1){
          option2Text = temp;
        }
         
      } 
 

    async function fetchVariants() {
      const response = await fetch(url+'.js');
    
      if (!response.ok) {
        const message = `An error has occured: ${response.status}`;
        throw new Error(message);
      }
    
      const data = await response.json();
      var variants = data.variants;
      var variantID = 0;
        if(variants)
        {
              for(var i=0; i<variants.length; i++)
              {
                //console.log(variants[i].option1+"-"+option1Text);console.log(variants[i].option2+"-"+option2Text);
                
                if(variants[i].option1 == option1Text && variants[i].option2 == option2Text)
                {
                  variantID = variants[i].id;
                }
              }
          //console.log(variantID);
          if(variantID != 0)
          {
            window.parent.location.href=url+'?variant='+variantID;
          }else{
             window.parent.location.href=url;
          }
        }
     //return variantID;
    } 
    fetchVariants().catch(error => {
      error.message; // 'An error has occurred: 404'
    }); 
 
  }
</script>






