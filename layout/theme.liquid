<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="ltr">
<head>
    <style>
      .layout--header-group {position: sticky;top: 0px;z-index: 3;}
      .product[data-product-type="PPLR_HIDDEN_PRODUCT"] .product-thumbnail .product-thumbnail__quantity {display: none !important;}
    </style>

    <meta charset="UTF-8">
    <meta name="robots" content="index, follow">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

    {%- if canonical_url != blank -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}
    <title>
      {%- liquid
        echo page_title
        unless request.page_type == 'index'
          echo ' | ' | append: shop.name
        endunless
      -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      echo 'theme--critical.css' | asset_url | preload_tag: as: 'style'
      echo 'theme--async.css' | asset_url | preload_tag: as: 'style'
    -%}

    {%- liquid
      render 'meta-tags'
      render 'css-typography'
      render 'css-variables'
      render 'custom-styles'
      render 'js-variables'
      render 'js-utils'
      render 'js-modules'
    -%}
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
    {%- unless request.design_mode or request.path contains 'challenge' -%}
    {%- render 'MemorizeYourLife' -%}{%- else -%}{{ content_for_header }}{%- endunless -%}
    {%- if request.page_type contains 'customers' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
      <script src="{{ 'customer_area.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    <link href="{{ "theme--critical.css" | asset_url }}" rel="stylesheet" media="all">
    <link href="{{ "theme--async.css" | asset_url }}" rel="stylesheet" media="print" onload="this.media='all'">

    <!-- HC - 08 Mar '24 - cart lightbox -->
      <link rel="preload" href="{{ 'jquery.js' | asset_url }}" as="script">
      {{ 'jquery.js' | asset_url | script_tag }}
      <link rel="preload" href="{{ 'fancybox.css' | asset_url }}" as="style">
      {{ 'fancybox.css' | asset_url | stylesheet_tag }}
      <script>
        $().fancybox({});
        $("[data-fancybox]").fancybox({
          beforeClose: function( instance, slide ) {}
        });
      </script>
      <style>a[data-fancybox] {cursor: zoom-in;}</style>
    <!-- END - HC - 08 Mar '24 - cart lightbox -->

    <noscript>
      <style>.layout--template > *, .layout--footer-group > * {opacity: 1;}</style>
      <link href="{{ "theme--async.css" | asset_url }}" rel="stylesheet">
    </noscript>

