      <script>
        /* ============================================================
   PDP ADD TO CART SPEED OPTIMIZER (SAFE VERSION)
   - No functionality change
   - Only improves canvas image speed
   - Converts PNG → JPEG (lighter & faster)
   - Applies ONLY on product page
============================================================ */

(function () {
  // check if we are on product page (PDP)
  function isProductPage() {
    return (
      document.querySelector(".main-product-os") ||
      document.querySelector(".product-page--root") ||
      document.body.classList.contains("template-product")
    );
  }

  if (!isProductPage()) return;

  const JPEG_QUALITY = 0.72;

  const originalToDataURL = HTMLCanvasElement.prototype.toDataURL;
  const originalToBlob = HTMLCanvasElement.prototype.toBlob;

  function convertToJpeg(canvas) {
    const tempCanvas = document.createElement("canvas");
    const ctx = tempCanvas.getContext("2d");

    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;

    // JPEG me transparency nahi hoti → white background add
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

    ctx.drawImage(canvas, 0, 0);

    return originalToDataURL.call(tempCanvas, "image/jpeg", JPEG_QUALITY);
  }

  // override only when PNG used
  HTMLCanvasElement.prototype.toDataURL = function (type, quality) {
    try {
      if (!type || type === "image/png") {
        return convertToJpeg(this);
      }
    } catch (e) {
      console.warn("Canvas optimization fallback:", e);
    }

    return originalToDataURL.call(this, type, quality);
  };

  HTMLCanvasElement.prototype.toBlob = function (callback, type, quality) {
    try {
      if (!type || type === "image/png") {
        return originalToBlob.call(this, callback, "image/jpeg", JPEG_QUALITY);
      }
    } catch (e) {
      console.warn("Canvas blob fallback:", e);
    }

    return originalToBlob.call(this, callback, type, quality);
  };

  console.log("✅ PDP Canvas Optimizer Active (PNG → JPEG)");
})();
      </script>

