<body class="template--{{ template | split: '.' | first | remove: '_' | replace: '/', '--' }} page--{{ page_title | handle }}"
  data-theme-id="606"
  data-theme-name="Blockshop"
  data-theme-version="9.4.1"
  data-theme-preset="{{ settings.preset }}"
  data-transition-container="viewport"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  {% if settings.border--enabled %}
    data-show-border
  {% endif %}>
  
  {% section 'custom-font' %}
    <!--[if IE]>
      <div style="text-align:center;padding:72px 16px;">{{ 'general.browser_unsupported' | t }}</div>
      <style>.layout--viewport { display: none; }</style>
    <![endif]-->

    <a data-item="a11y-button" href='#main-content' id="a11y_skip">
      {{- 'general.a11y.skip_main' | t -}}
    </a>

    <div class="layout--viewport" data-drawer-status="closed">
      <div class="layout--main-content">
        <header class="layout--header-group">
          {%- sections 'header-group' -%}
        </header>

        <div class="layout--overlay-group">
          {%- sections 'overlay-group' -%}
        </div>

        <main class="layout--template" id="main-content">
          {{ content_for_layout }}
        </main>

        <footer class="layout--footer-group">
          {%- sections 'footer-group' -%}
        </footer>
      </div>

      {%- liquid
        render 'drawer'
        render 'layout--navigation'
        render 'feedback-bar'
      -%}
    </div>

    {%- render 'icons', icon: 'defs' -%}
  
